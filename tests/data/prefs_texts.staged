; synthetic: every free-text key of the editor set, nothing else

[profile default]
font = topaz.font:11
font-fallback = SymbolsNerdFontMono
screen-mode = 0x29000
screen-depth = 5
scrollback = 4000
link-open = Run >NIL: OpenURL %s
term = xterm-256color
colors = 256
cursor-color = FF8800
screen = workbench
font-aspect = on
backspace = del
amiga-keys = on
dither = on
outline-antialias = on
padding-color = background
highlight-cat = on
program-clipboard = write
cursor = block
cursor-blink = off
bell = beep
bold-bright = on
meta = alt
copy-on-select = off
wheel = scroll
reflow = on
scrollbar = show
completion = unix
kingcon-info = hide
kingcon-cache = on
