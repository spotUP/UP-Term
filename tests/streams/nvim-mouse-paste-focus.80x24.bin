[?1049h[22;0;0t[?1h=[H[2J]11;?[?2004h[?25h[?25l(B[m[H[2J/* vtengine -- see vtengine.h. The parser is Paul Williams' DEC-compatible[K
 * state machine (vt100.net/emu/dec_ansi_parser); the dispatch tables below[K
 * it are per personality, because the Amiga console and xterm give the same[K
 * CSI finals different meanings (the conformance matrix in[K
 * thoughts/shared/research/2026-09-28_console-conformance-matrix.md). */[K
#include "vtengine.h"[K
#include "vtwidth.h"[K
#include <stddef.h>[K
#include <string.h>[K
[K
#ifdef __VBCC__[K
/* vbcc's -O2 is -O=1023. With it, a loop over vt_term fields got every[K
 * field's address (t + offset) hoisted out of the loop and, short of[K
 * registers, spilled to the stack: each t->x became a load of the address[K
 * and then the access, and vt_feed set up fifteen such slots on every[K
 * call -- though (d16,An) addressing is free on a 68k. -O=991 (bit 32 off)[K
 * keeps the accesses in place: engbench plain lines with 79-byte writes[K
 * 19.4 -> 16.5 instructions a byte under vamos (ASM1; -O=895, bit 128[K
 * off, does the same but warns 172 in feed()). It sets the whole mask:[K
 * this file builds at this level whatever -O the command line gives. */[K
#pragma opt 991[K
#endif[K
