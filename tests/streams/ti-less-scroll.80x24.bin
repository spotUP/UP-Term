    } else {
        if (x > 222 || y > 222)
            return 0; /* beyond what one byte can carry */
        b[n++] = 'M';
        b[n++] = (char)(32 + cb);
        b[n++] = (char)(33 + x);
        b[n++] = (char)(33 + y);
    }
    for (i = 0; i < n; i++)
        out[i] = (vt_u8)b[i];
    return n;
}

int vt_encode_paste(const vt_term *t, int end, vt_u8 *out)
{
    const char *s = end ? "\033[201~" : "\033[200~";
    int i;
    if (!(t->modes & VT_MODE_BRACKET_PASTE) || t->pers != VT_XTERM)
        return 0;
    for (i = 0; s[i]; i++)
        out[i] = (vt_u8)s[i];
    return i;
}
