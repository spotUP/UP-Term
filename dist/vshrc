# vsh's startup file. Install copies it to ENVARC:vsh/vshrc; vsh reads it
# before $HOME/.vshrc, where your own settings go.

# vsh reads $HOME/.vshrc straight after this file, and the shell's default
# HOME is the volume HOME:, which nothing assigns: an interactive vsh then
# stops at startup with "Please insert volume HOME in any drive" and the
# function definitions below never run. Point HOME at SYS: whenever it does
# not name something that exists; a real HOME the user set is left alone.
if [ ! -d "${HOME:-HOME:}" ] 2>/dev/null; then
    HOME=SYS:
fi
export HOME

clear() {
    printf '\033[H\033[2J'
}

# Remote logins: ssh (BebboSSH, Install's network tools), telnet, rlogin.
# vsh's own TERM is vtcon, which a remote Unix machine has no entry for (its
# shell then cannot move the cursor and redraws every key); an UP-Term
# window is an xterm-256color to it -- everything that entry asks for, the
# window does. To send another name, set UP_REMOTE_TERM (in $HOME/.vshrc,
# say UP_REMOTE_TERM=xterm-amiga). A TERM that is not vtcon or vtcon-amiga -- screen's
# windows are "screen" -- goes as it is.
remote_term() {
    case "${UP_REMOTE_TERM:-$TERM}" in
    ''|vtcon|vtcon-amiga) echo xterm-256color ;;
    *) echo "${UP_REMOTE_TERM:-$TERM}" ;;
    esac
}
ssh() {
    TERM=$(remote_term) bebbossh "$@"
}
rlogin() {
    TERM=$(remote_term) command rlogin "$@"
}
scp() {
    bebboscp "$@"
}
# telnet: C:uptelnet (no ixemul). It tells the far end remote_term's name
# (its TERM keyword) and the window's size, and follows a resize. Ctrl-]
# ends it.
telnet() {
    uptelnet "$@" TERM "$(remote_term)"
}

# wget: not ported; a function over curl (UP-Term:net). It fetches each URL
# to a file of the URL's last name (curl -O) and follows redirects, fails on
# an HTTP error status (curl -f). -O FILE names the file (-O - writes to the
# standard output), -c continues a partial file, -q is quiet. Other wget
# options are refused, not guessed.
wget() {
    _wg_out= _wg_cont= _wg_quiet=
    while [ $# -gt 0 ]; do
        case $1 in
        -O) _wg_out=$2; shift 2 ;;
        -O?*) _wg_out=${1#-O}; shift ;;
        -c|--continue) _wg_cont=1; shift ;;
        -q|--quiet) _wg_quiet=1; shift ;;
        --) shift; break ;;
        -?*) echo "wget: option $1 is not supported (curl does the work)" >&2; return 2 ;;
        *) break ;;
        esac
    done
    if [ $# -eq 0 ]; then
        echo "usage: wget [-c] [-q] [-O file] URL..." >&2
        return 2
    fi
    _wg_rc=0
    for _wg_url in "$@"; do
        if [ "$_wg_out" = - ]; then
            curl -fsSL "$_wg_url" || _wg_rc=$?
        elif [ -n "$_wg_out" ]; then
            curl -fL ${_wg_quiet:+-s} ${_wg_cont:+-C -} -o "$_wg_out" "$_wg_url" || _wg_rc=$?
        else
            curl -fLO ${_wg_quiet:+-s} ${_wg_cont:+-C -} "$_wg_url" || _wg_rc=$?
        fi
    done
    return $_wg_rc
}

# tldr: the community pages of tldr-pages (https://tldr.sh), fetched with curl
# and drawn by mdv. "tldr tar", "tldr git commit". Looked up in the platform
# drawers named by TLDR_PLATFORMS (default: common, linux, osx); TLDR_URL
# names another mirror of the pages drawer.
tldr() {
    if [ $# -eq 0 ]; then
        echo "usage: tldr command [subcommand]" >&2
        return 2
    fi
    _tl_name=$(echo "$*" | tr ' ' '-')
    for _tl_dir in ${TLDR_PLATFORMS:-common linux osx}; do
        if _tl_page=$(curl -fsL "${TLDR_URL:-https://raw.githubusercontent.com/tldr-pages/tldr/main/pages}/$_tl_dir/$_tl_name.md"); then
            echo "$_tl_page" | mdv
            return 0
        fi
    done
    echo "tldr: no page for $*" >&2
    return 1
}

# The Unix commands are GNU coreutils 5.2.1 and the Unix tool ports
# (grep, sed, awk, less, nano, find, diff, man, tar...) in UP-Term:bin (see
# Install): ls, cp, mv, rm, mkdir, cat, sort, head, tail, wc and the rest,
# with their Unix flags and paths (.. is the parent, / the volume list).
# $PATH is in Unix form, the way ixemul programs read it too, and comes
# before the Shell's own path and C:, so sort here is GNU sort while the
# AmigaDOS Shell keeps C:Sort. Dir, List, Copy, Delete, Type and the other
# AmigaDOS commands keep their names. A PATH you set is left alone.
if [ -z "$PATH" ]; then
    PATH=/UP-Term/bin:/UP-Term/Python3/bin:/SYS/Python3/bin:/UP-Term/nvim/bin:/gg/bin:/c
fi
export PATH

# The editor for fc and git commit. Both fall back to vi, which the base
# does not ship (vim comes from upkg), so joe is the default here. An
# EDITOR you set is left alone.
if [ -z "$EDITOR" ]; then
    EDITOR=joe
fi
export EDITOR

# ls in colour on a terminal: --color=auto keeps it off when the output is
# a pipe or a file. The ANSI colour numbers are whatever the window's
# profile defines.
alias ls='ls --color=auto'
alias ll='ls -l'

# Archivers complete only their own archives (bash's complete -f -X '!pattern'
# for lha, unzip, tar ...): "lha x H<Tab>" in a drawer holding HiP/ and
# HiP.lha offers HiP.lha. Only when no archive matches are the drawers
# offered, so a Tab can walk into one to reach an archive (bash's -o plusdirs
# would always add them, and Tab would stop at the drawer's name). The match
# ignores case (.LHA, .lha). vsh's complete has no -X, so one -F function
# does the filtering.
_archive_match() {
    case $1 in
    lha) case $2 in *.[lL][hH][aA]|*.[lL][zZ][hH]|*.[lL][zZ][xX]) return 0 ;; esac ;;
    lzx) case $2 in *.[lL][zZ][xX]) return 0 ;; esac ;;
    unzip) case $2 in *.[zZ][iI][pP]) return 0 ;; esac ;;
    tar) case $2 in *.[tT][aA][rR]|*.[tT][gG][zZ]|*.[tT][aA][rR].[gG][zZ]|*.[tT][aA][rR].[bB][zZ]2|*.[tT][aA][rR].[xX][zZ]) return 0 ;; esac ;;
    gunzip) case $2 in *.[gG][zZ]|*.[tT][gG][zZ]) return 0 ;; esac ;;
    unxz) case $2 in *.[xX][zZ]|*.[tT][xX][zZ]) return 0 ;; esac ;;
    esac
    return 1
}
_archive_complete() {
    local f
    COMPREPLY=()
    for f in $(compgen -f -- "$2"); do
        [ -d "$f" ] && continue
        _archive_match "$1" "$f" && COMPREPLY[${#COMPREPLY[@]}]=$f
    done
    [ ${#COMPREPLY[@]} -eq 0 ] && COMPREPLY=($(compgen -d -- "$2"))
}
complete -F _archive_complete lha lzx unzip tar gunzip unxz

# hl and mdv (UP-Term:bin, see the README): a source in colour with
# line numbers (hl file.c; to a pipe or a file it is plain cat), Markdown
# formatted for the window (mdv README.md). hlp and mdp page them: less -R
# keeps the colours (less from Geek Gadgets or Aminet; $PAGER names
# another pager that shows colours).
hlp() {
    hl --color=always -n "$@" | ${PAGER:-less -R}
}
mdp() {
    mdv --color=always "$@" | ${PAGER:-less -R}
}
# cat shows files through hl -p: colours on the console, a .md or .markdown
# file formatted as mdv does, and the bytes as they are to a pipe or a file.
# UP-Term Prefs' "Highlight files shown with cat" (on unless saved off)
# writes the switch beside the profile file: ENV:up-term/highlight-cat,
# ENVARC:'s copy until the boot has made ENV:'s. $UP_HLCAT_FILE names
# another file. AmigaDOS Type is never aliased. hl does not know cat's
# options: for cat -n type "command cat -n", or turn the switch off.
UP_HLCAT_FILE=${UP_HLCAT_FILE:-ENV:up-term/highlight-cat}
[ -f "$UP_HLCAT_FILE" ] || UP_HLCAT_FILE=ENVARC:up-term/highlight-cat
hlcat=on
[ -f "$UP_HLCAT_FILE" ] && read -r hlcat < "$UP_HLCAT_FILE"
case $hlcat in
off) ;;
*) alias cat='hl -p' ;;
esac
unset hlcat

# One line for a newcomer: type tutorial (dist/tutorial, Help > Shell tutorial).
# Shown until lesson 1 is finished (its number is a line of the progress file
# the tutorial writes) or $HOME/.tutorial-hint-off exists.
tutorial_hint() {
    case $HOME in *: | */) _th_home=$HOME ;; *) _th_home=$HOME/ ;; esac    # HOME is a volume on the Amiga ("System:")
    [ -f "${_th_home}.tutorial-hint-off" ] && return 0
    [ -r "${TUTORIAL_PROGRESS:-${_th_home}.tutorial}" ] && grep -qx 1 "${TUTORIAL_PROGRESS:-${_th_home}.tutorial}" && return 0
    # Two lines: one line of 109 characters broke mid-word in an 80-column window.
    echo "New to a Unix shell? Type  tutorial  for a short hands-on course."
    echo "Hide this hint: echo > \$HOME/.tutorial-hint-off"
}

# The Up Rough banner when an interactive vsh starts on a terminal (not
# for vsh -c or a script, and not when its output goes elsewhere). Remove
# these lines, or the file, to start quietly.
case $- in
*i*)
    if [ -t 1 ] && [ -f ENV:vsh/banner ]; then
        Type ENV:vsh/banner
    fi
    if [ -t 1 ]; then
        tutorial_hint
    fi
    ;;
esac
