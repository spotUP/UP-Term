# vsh's startup file. Install copies it to ENVARC:vsh/vshrc; vsh reads it
# before $HOME/.vshrc, where your own settings go.
#
# Unix command names for the AmigaDOS commands that do the same work,
# with the flags people type most. Names are passed on as AmigaDOS names:
# ../x becomes /x (the parent is /), ./x becomes x. To use a real Unix
# port of one of these (an ixemul ls in the path), remove its function.

# vsh reads $HOME/.vshrc straight after this file, and the shell's default
# HOME is the volume HOME:, which nothing assigns: an interactive vsh then
# stops at startup with "Please insert volume HOME in any drive" and the
# function definitions below never run. Point HOME at SYS: whenever it does
# not name something that exists; a real HOME the user set is left alone.
if [ ! -d "${HOME:-HOME:}" ] 2>/dev/null; then
    HOME=SYS:
fi
export HOME

# _amiga NAME: NAME as AmigaDOS writes it, in _r
_amiga() {
    _u=$1
    _o=
    while :; do
        case $_u in
        ./*) _u=${_u#./} ;;
        ../*) _o="$_o/"; _u=${_u#../} ;;
        ..) _o="$_o/"; _u= ;;
        .) _u= ;;
        *) break ;;
        esac
    done
    _r="$_o$_u"
}

clear() {
    printf '\033[H\033[2J'
}

# ls: the real GNU ls, not a Dir/List wrapper. A terminal can only show the
# colour a program emits, and Dir colours directories alone, so file-type
# colouring has to come from the listing program. The kit installs GNU
# fileutils' ls and dircolors as C:ls and C:dircolors (see Install), which is
# where resolve() in shell/vsh.c looks last, so a bare ls finds them. The
# wrapper function used to be defined here and, being a function, hid that
# command, so it is gone rather than overridden. Type Dir or List directly for
# the AmigaDOS form, or unset the alias to get ls without colour.
#
# --color=auto keeps colour off when the output is a pipe or a file, which is
# what a redirected ls must do, and LS_COLORS (see dircolors) picks the
# colours; the ANSI numbers are whatever the window's profile defines.
#
# The tools still wrapped below (cp, mv, rm, mkdir, touch) shadow their
# fileutils equivalents for exactly the reason the wrapper hid ls. The .. gate
# is verified (ls .. lists the parent), so they can go the same way; see
# thoughts/shared/plans/2026-10-02_unix-userland.md.
alias ls='ls --color=auto'

# mkdir [-p] dir ...: -p makes each missing directory on the way
mkdir() {
    _p=0
    _rc=0
    for _x; do
        shift
        case $_x in
        -p) _p=1 ;;
        -*) ;;
        *) _amiga "$_x"; set -- "$@" "$_r" ;;
        esac
    done
    for _d; do
        if [ $_p = 1 ]; then
            _made=
            _rest=$_d
            while [ -n "$_rest" ]; do
                case $_rest in
                */*) _part=${_rest%%/*}; _rest=${_rest#*/} ;;
                *) _part=$_rest; _rest= ;;
                esac
                _made=$_made$_part
                if [ -n "$_part" ] && [ ! -d "$_made" ]; then
                    MakeDir "$_made" || _rc=1
                fi
                _made=$_made/
            done
        else
            MakeDir "$_d" || _rc=1
        fi
    done
    return $_rc
}

# rm [-r] [-f] name ...: -r deletes directories with what is in them,
# -f also protected files, quietly
rm() {
    _all=
    _q=
    for _x; do
        shift
        case $_x in
        -*)
            case $_x in *[rR]*) _all=ALL ;; esac
            case $_x in *f*) _q=1 ;; esac ;;
        *) _amiga "$_x"; set -- "$@" "$_r" ;;
        esac
    done
    if [ -n "$_q" ]; then
        Delete "$@" $_all QUIET FORCE >NIL: 2>NIL:
        return 0
    fi
    Delete "$@" $_all QUIET
}

# cp [-r] from ... to
cp() {
    _all=
    for _x; do
        shift
        case $_x in
        -*) case $_x in *[rR]*) _all=ALL ;; esac ;;
        *) _amiga "$_x"; set -- "$@" "$_r" ;;
        esac
    done
    Copy "$@" $_all QUIET
}

# mv from ... to (within one volume, as Rename does)
mv() {
    for _x; do
        shift
        case $_x in
        -*) ;;
        *) _amiga "$_x"; set -- "$@" "$_r" ;;
        esac
    done
    Rename "$@" QUIET
}

# cat [name ...]: the files, or what comes in
cat() {
    if [ $# = 0 ]; then
        while IFS= read -r _l; do printf '%s\n' "$_l"; done
        return 0
    fi
    for _x; do
        shift
        _amiga "$_x"
        set -- "$@" "$_r"
    done
    Type "$@"
}

# touch name ...: a new empty file, or today's date on one there
touch() {
    for _x; do
        _amiga "$_x"
        if [ -e "$_r" ]; then SetDate "$_r"; else : >"$_r"; fi
    done
}

alias ll='ls -l'

# The Up Rough banner when an interactive vsh starts on a terminal (not
# for vsh -c or a script, and not when its output goes elsewhere). Remove
# these lines, or the file, to start quietly.
case $- in
*i*)
    if [ -t 1 ] && [ -f ENV:vsh/banner ]; then
        Type ENV:vsh/banner
    fi
    ;;
esac
