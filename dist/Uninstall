; UP-Term uninstall: removes what Install put in and gives back the
; ixemul.library it replaced. XCON:, PTY: and IXPIPE: stay mounted until a reboot.
; Your history (ENVARC:vtcon.history) and $HOME/.vshrc are kept.
; Run from anywhere:  Execute Uninstall
FailAt 21
; CON:/RAW: back to the system's (new windows; open ones keep UP-Term)
If EXISTS C:UPConsole
  C:UPConsole >NIL: CON OFF
  C:UPConsole >NIL: DEVICE OFF
EndIf
Delete >NIL: DEVS:DOSDrivers/XCON DEVS:DOSDrivers/XCON.info QUIET
Delete >NIL: DEVS:DOSDrivers/PTY DEVS:DOSDrivers/PTY.info QUIET
; GG: and the block in S:User-Startup, if Install made them (SYS:UP-Term
; is ours only then): vsh takes the block out, before vsh itself goes
; The blocks Install wrote into S:User-Startup (GG:, the CON: and device
; switches) go;
; vsh does it, before vsh itself goes. The script is in ENVARC:up-term
; (older kits kept it in SYS:UP-Term only).
Set unst ""
If EXISTS SYS:UP-Term/unstartup.sh
  Set unst SYS:UP-Term/unstartup.sh
EndIf
If EXISTS ENVARC:up-term/unstartup.sh
  Set unst ENVARC:up-term/unstartup.sh
EndIf
If NOT "$unst" EQ ""
  If EXISTS S:User-Startup
    C:vsh $unst
    If EXISTS T:User-Startup.up-term
      Copy T:User-Startup.up-term S:User-Startup CLONE QUIET
      Delete >NIL: T:User-Startup.up-term QUIET
    EndIf
  EndIf
EndIf
UnSet unst
; TMP: only when Install assigned it (its marker)
If EXISTS ENVARC:up-term/tmp
  Assign >NIL: TMP: T: REMOVE
EndIf
; GG: only when Install assigned it (its marker; older kits kept
; unstartup.sh in SYS:UP-Term then). SYS:UP-Term is UP-Term's own drawer
; (bin: coreutils and sh)
If EXISTS ENVARC:up-term/gg
  Assign >NIL: GG: SYS:UP-Term REMOVE
EndIf
If EXISTS SYS:UP-Term/unstartup.sh
  Assign >NIL: GG: SYS:UP-Term REMOVE
EndIf
Delete >NIL: SYS:UP-Term ALL QUIET
; BebboSSH's library, only when Install put it there (its marker)
If EXISTS ENVARC:up-term/cryptossh
  Delete >NIL: LIBS:libcryptossh.library QUIET
EndIf
; the font sizes Install added (their markers); a drawer left empty goes,
; and FixFonts drops its .font
If EXISTS ENVARC:up-term/font-TopazPro-16
  Delete >NIL: FONTS:TopazPro/16 QUIET
EndIf
If EXISTS ENVARC:up-term/font-IBM-8
  Delete >NIL: FONTS:IBM/8 QUIET
EndIf
If EXISTS ENVARC:up-term/font-IBM-11
  Delete >NIL: FONTS:IBM/11 QUIET
EndIf
If EXISTS ENVARC:up-term/font-IBM-16
  Delete >NIL: FONTS:IBM/16 QUIET
EndIf
Delete >NIL: FONTS:TopazPro FONTS:IBM QUIET
If NOT EXISTS FONTS:TopazPro
  Delete >NIL: FONTS:TopazPro.font QUIET
EndIf
If NOT EXISTS FONTS:IBM
  Delete >NIL: FONTS:IBM.font QUIET
EndIf
If EXISTS SYS:System/FixFonts
  SYS:System/FixFonts
EndIf
Delete >NIL: L:vtcon-handler L:pty-handler C:vsh C:upgetty C:UPTerm C:uptelnet C:UPDemo C:Claude C:ixkill C:screen C:tmux C:UPConsole "C:UP-Term Prefs" DEVS:up-console.device QUIET
Delete >NIL: ENVARC:screenrc ENV:screenrc ENVARC:tmux.conf ENV:tmux.conf QUIET
If EXISTS ENVARC:up-term/sysicon
  Delete >NIL: SYS:System/UP-Term SYS:System/UP-Term.info QUIET
EndIf
; wasabid: stopped (Ctrl-C, its own way out), and the daemon and its key
; only when Install put them there (their markers)
Status >ENV:upw COM C:wasabid
If NOT WARN
  Break $upw C
EndIf
UnSet >NIL: upw
Delete >NIL: ENV:upw QUIET
If EXISTS ENVARC:up-term/wasabid
  Delete >NIL: C:wasabid QUIET
EndIf
If EXISTS ENVARC:up-term/wasabikey
  Delete >NIL: ENVARC:wasabi.key ENV:wasabi.key QUIET
EndIf
Delete >NIL: SYS:Utilities/UP-Term SYS:Utilities/UP-Term.info SYS:Utilities/UP-Term-Prefs SYS:Utilities/UP-Term-Prefs.info QUIET
If EXISTS ENVARC:up-term/ixpipe
  Delete >NIL: DEVS:DOSDrivers/IXPIPE DEVS:DOSDrivers/IXPIPE.info L:ixpipe-handler QUIET
EndIf
; the window preferences are the user's own data: kept as
; ENVARC:UP-Term.prefs, which a later Install brings back
If EXISTS ENVARC:up-term/up-term
  Copy ENVARC:up-term/up-term ENVARC:UP-Term.prefs CLONE QUIET
EndIf
; the fileutils commands older kits put in C: (their markers)
If EXISTS ENVARC:up-term/ls
  Delete >NIL: C:ls QUIET
EndIf
If EXISTS ENVARC:up-term/dircolors
  Delete >NIL: C:dircolors QUIET
EndIf
If EXISTS ENVARC:up-term/cp
  Delete >NIL: C:cp QUIET
EndIf
If EXISTS ENVARC:up-term/mv
  Delete >NIL: C:mv QUIET
EndIf
If EXISTS ENVARC:up-term/rm
  Delete >NIL: C:rm QUIET
EndIf
If EXISTS ENVARC:up-term/mkdir
  Delete >NIL: C:mkdir QUIET
EndIf
If EXISTS ENVARC:up-term/touch
  Delete >NIL: C:touch QUIET
EndIf
Delete >NIL: ENVARC:up-term ENV:up-term ALL QUIET
; TERMINFO: ours goes, the user's from before Install comes back
If EXISTS ENV:TERMINFO
  Search >NIL: ENV:TERMINFO /ENV/up-term/terminfo
  If NOT WARN
    Delete >NIL: ENV:TERMINFO QUIET
  EndIf
EndIf
If EXISTS ENVARC:TERMINFO
  Search >NIL: ENVARC:TERMINFO /ENV/up-term/terminfo
  If NOT WARN
    Delete >NIL: ENVARC:TERMINFO QUIET
  EndIf
EndIf
If EXISTS ENVARC:up-term-orig/env
  Copy ENVARC:up-term-orig/env ENV:TERMINFO CLONE
EndIf
If EXISTS ENVARC:up-term-orig/envarc
  Copy ENVARC:up-term-orig/envarc ENVARC:TERMINFO CLONE
EndIf
; the Shell icon as it was before Install (SHELLICON)
If EXISTS ENVARC:up-term-orig/Shell.info
  Copy ENVARC:up-term-orig/Shell.info SYS:System/Shell.info CLONE QUIET
EndIf
Delete >NIL: ENVARC:up-term-orig ALL QUIET
Delete >NIL: ENVARC:vsh ENV:vsh ALL QUIET
If EXISTS LIBS:ixemul.library.orig
  Copy LIBS:ixemul.library.orig LIBS:ixemul.library CLONE
  Delete >NIL: LIBS:ixemul.library.orig QUIET
  Avail >NIL: FLUSH
EndIf
Echo "UP-Term removed. Reboot to unmount XCON:, PTY: and IXPIPE:."
