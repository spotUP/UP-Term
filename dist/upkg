#!/bin/sh
# upkg: UP-Term's package manager (upkg plan, thoughts/shared/plans/2026-10-18-upkg.md).
#   upkg list            every package of the release: installed and available version, size
#   upkg install <pkg>   download, check, unpack and run the package's own Installer
#   upkg update          install every add-on whose release version is newer than the installed one
#   upkg remove <pkg>    run the installed package's Uninstall (Execute, as its icon does)
# <pkg> is the archive name (UP-Term-nvim) or the short id (nvim) of the index.
# The index (tools/pkgs.py index, built by make dist) and the archives come from the latest GitHub
# release; ENV:UPKGURL replaces that URL (the rig fixture, tools/rig/upkg_rig.py). https only: the
# base Installer's AmiSSL part makes curl reach GitHub.
# What is installed is read from each package's install record (<record>/VERSIONS), never from a
# file of upkg's own. The base updates from its own archive, not here: upkg runs inside it.
url=${UPKGURL:-https://github.com/spotUP/vtcon/releases/latest/download}
work=T:upkg
index=$work/upkg-index.txt

die() {
    printf 'upkg: %s\n' "$1" >&2
    rm -rf $work
    exit 1
}

usage() {
    printf 'usage: upkg list | install <package> | update | remove <package>\n' >&2
    exit 2
}

# the install record's VERSIONS: the base keeps it in UP-Term: itself, an add-on in its record drawer
versions_of() {
    case "$1" in
    *:) printf '%sVERSIONS' "$1" ;;
    *) printf '%s/VERSIONS' "$1" ;;
    esac
}

# the installed version of the record in $1, empty when it is not installed
installed() {
    v=$(versions_of "$1")
    [ -f "$v" ] && head -n 1 "$v" | awk '{ print $2 }'
}

# true when version $1 is lower than $2 (dotted numbers, 1.2 < 1.10)
older() {
    awk -v a="$1" -v b="$2" 'BEGIN {
        na = split(a, x, "."); nb = split(b, y, "."); n = na > nb ? na : nb
        for (i = 1; i <= n; i++) { if (x[i] + 0 < y[i] + 0) exit 0; if (x[i] + 0 > y[i] + 0) exit 1 }
        exit 1 }'
}

# curl exits 22 for an HTTP error (the server answered: the file is not in the release) and 20 when it
# cannot start (curl 8.22 opens amisslmaster.library even for http); anything else is the network
fetch() {
    curl -fsSL -o "$2" "$1"
    rc=$?
    case $rc in
    0) return 0 ;;
    22) die "cannot download $1: not in the release (HTTP error)" ;;
    20) die "cannot download $1: curl cannot start without AmiSSL: run the UP-Term Installer again with its AmiSSL part ticked" ;;
    *) die "cannot download $1 (curl $rc): check the network connection" ;;
    esac
}

get_index() {
    rm -rf $work
    mkdir -p $work || die "cannot make $work"
    fetch "$url/upkg-index.txt" $index
    head -n 1 $index | grep -q '^# upkg index 1' || die "$url/upkg-index.txt is not a upkg index"
}

# the index line of package $1 (id or archive name) into $id $archive $version $needs $record $size $sum
find_pkg() {
    line=$(awk -v p="$1" '!/^#/ && ($1 == p || $2 == p) { print; exit }' $index)
    [ -n "$line" ] || die "no package $1 in the release: upkg list shows them"
    set -- $line
    id=$1 archive=$2 version=$3 needs=$4 record=$5 size=$6 sum=$7
}

find_installer() {
    for i in Installer SYS:Utilities/Installer SYS:System/Installer SYS:C/Installer; do
        if command -v $i >/dev/null 2>&1 || [ -f $i ]; then
            printf '%s' $i
            return 0
        fi
    done
    return 1
}

install_one() {
    find_pkg "$1"
    [ "$record" != UP-Term: ] || die "the base updates from its own archive UP-Term.lha, not from inside UP-Term"
    if [ "$needs" != - ]; then
        base=$(installed UP-Term:)
        [ -n "$base" ] || die "$archive needs UP-Term $needs, and UP-Term: has no install record"
        if older "$base" "$needs"; then
            die "$archive $version needs UP-Term $needs; this is UP-Term $base: install the new UP-Term first"
        fi
    fi
    inst=$(find_installer) || die "no Installer found (C:, SYS:Utilities, SYS:System)"
    lha=$work/$archive.lha
    printf 'upkg: downloading %s %s (%s bytes)\n' "$archive" "$version" "$size"
    fetch "$url/$archive.lha" $lha
    got=$(wc -c <$lha | awk '{ print $1 }')
    [ "$got" = "$size" ] || die "$archive.lha is $got bytes, the index says $size: not installed"
    got=$(sha256sum $lha | awk '{ print $1 }')
    [ "$got" = "$sum" ] || die "$archive.lha sha256 $got is not the index's $sum: not installed"
    (cd $work && tar -xf $archive.lha) || die "cannot unpack $archive.lha"
    [ -f $work/$archive/Install ] || die "$archive.lha has no $archive/Install"
    printf 'upkg: running the %s Installer\n' "$archive"
    (cd $work/$archive && $inst Install APPNAME $archive MINUSER AVERAGE DEFUSER AVERAGE)
    rm -rf $work/$archive $lha
    now=$(installed "$record")
    if [ "$now" = "$version" ]; then
        printf 'upkg: %s %s installed\n' "$archive" "$version"
    else
        printf 'upkg: %s not installed (the Installer was left before the end)\n' "$archive"
        return 1
    fi
}

case "$1" in
list)
    [ $# = 1 ] || usage
    get_index
    printf '%-14s %-10s %-10s %s\n' package installed available bytes
    awk '!/^#/ { print $2, $3, $5, $6 }' $index | while read -r archive version record size; do
        have=$(installed "$record")
        printf '%-14s %-10s %-10s %s\n' "$archive" "${have:--}" "$version" "$size"
    done
    rm -rf $work
    ;;
install)
    [ $# = 2 ] || usage
    get_index
    install_one "$2"
    rc=$?
    rm -rf $work
    exit $rc
    ;;
update)
    [ $# = 1 ] || usage
    get_index
    todo=$(awk '!/^#/ && $5 != "UP-Term:" { print $2, $3, $5 }' $index | while read -r archive version record; do
        have=$(installed "$record")
        if [ -n "$have" ] && older "$have" "$version"; then printf '%s ' "$archive"; fi
    done)
    [ -n "$todo" ] || { printf 'upkg: every installed add-on is up to date\n'; rm -rf $work; exit 0; }
    rc=0
    for a in $todo; do
        install_one $a || rc=1
    done
    rm -rf $work
    exit $rc
    ;;
remove)
    # offline when the archive name is given: the records are where packages.txt puts them
    [ $# = 2 ] || usage
    record=
    for r in UP-Term:pkg/$2 ENVARC:upkg/$2; do
        [ -f $r/Uninstall ] && { record=$r archive=$2; break; }
    done
    if [ -z "$record" ]; then
        get_index
        find_pkg "$2"
    fi
    [ "$record" != UP-Term: ] || die "the base is removed by its own Uninstall icon"
    [ -f "$record/Uninstall" ] || die "$archive is not installed (no $record/Uninstall)"
    # a copy runs: the script deletes its record drawer, which AmigaDOS refuses while the script is read
    rm -rf $work
    mkdir -p $work || die "cannot make $work"
    cp "$record/Uninstall" $work/Uninstall || die "cannot copy $record/Uninstall"
    Execute $work/Uninstall
    rm -rf $work
    if [ -f "$(versions_of "$record")" ]; then
        printf 'upkg: %s not removed: %s is still there\n' "$archive" "$record"
        exit 1
    fi
    printf 'upkg: %s removed\n' "$archive"
    ;;
*) usage ;;
esac
