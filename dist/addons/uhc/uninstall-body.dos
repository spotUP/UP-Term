; the UHC: assign, and this package's block in S:User-Startup (";BEGIN uhc" to ";END uhc"):
; UP-Term's unstartup.sh takes out just that block, whatever else was added since. Without it the block
; stays (it does nothing once UP-Term:uhc is gone) and the message says where it is.
Assign >NIL: UHC: EXISTS
If NOT WARN
  Assign UHC:
EndIf
Search >NIL: S:User-Startup ";BEGIN uhc"
If NOT WARN
  Assign >NIL: UP-Term: EXISTS
  If NOT WARN
    If EXISTS UP-Term:bin/vsh
      If EXISTS ENVARC:up-term/unstartup.sh
        Delete >NIL: T:User-Startup.up-term QUIET
        UP-Term:bin/vsh ENVARC:up-term/unstartup.sh uhc
        If EXISTS T:User-Startup.up-term
          Copy T:User-Startup.up-term S:User-Startup CLONE QUIET
          Delete >NIL: T:User-Startup.up-term QUIET
        EndIf
      EndIf
    EndIf
  EndIf
EndIf
Search >NIL: S:User-Startup ";BEGIN uhc"
If NOT WARN
  Echo "S:User-Startup still has the lines from ;BEGIN uhc to ;END uhc (harmless; delete them by hand)."
EndIf
Delete >NIL: ENV:UHCBIN QUIET
; UP-Term:uhc is the drawer this archive copied (Files/userland/uhc); take it out whole
Assign >NIL: UP-Term: EXISTS
If NOT WARN
  If EXISTS UP-Term:uhc
    Delete >NIL: UP-Term:uhc ALL QUIET FORCE
  EndIf
EndIf
