; Up-uhc's UHC tree is SYS:UHC (up-uhc 1.0 to 1.3: UP-Term:uhc). Only a tree up-uhc made is ever touched: its
; install wrote UHC-Remove (one Delete per file the archive delivered) into it, and that file is the record of
; ownership. A UHC install that was there before (the author's own, SYS:UHC/UHC-Startup without UHC-Remove) is
; the user's: its files, UHC: assign, variables and S:User-Startup block stay as they are.
Set uhcours 0
If EXISTS SYS:UHC/UHC-Remove
  Set uhcours 1
EndIf
If EXISTS UP-Term:uhc
  Set uhcours 1
EndIf
; this package's block in S:User-Startup (";BEGIN uhc" to ";END uhc"; the author's own block is ";BEGIN UHC"):
; UP-Term's unstartup.sh takes out just that block, whatever else was added since. Without it the block
; stays (it does nothing once SYS:UHC is gone) and the message says where it is.
If "$uhcours" EQ 1
  Assign >NIL: UHC: EXISTS
  If NOT WARN
    Assign UHC:
  EndIf
  Search >NIL: S:User-Startup ";BEGIN uhc"
  If NOT WARN
    Assign >NIL: UP-Term: EXISTS
    If NOT WARN
      If EXISTS UP-Term:bin/vsh
        If EXISTS ENVARC:up-term/unstartup.sh
          Delete >NIL: T:User-Startup.up-term QUIET
          UP-Term:bin/vsh ENVARC:up-term/unstartup.sh uhc
          If EXISTS T:User-Startup.up-term
            Copy T:User-Startup.up-term S:User-Startup CLONE QUIET
            Delete >NIL: T:User-Startup.up-term QUIET
          EndIf
        Else
          Echo "S:User-Startup still has the lines from ;BEGIN uhc to ;END uhc (harmless; delete them by hand)."
        EndIf
      EndIf
    Else
      Echo "S:User-Startup still has the lines from ;BEGIN uhc to ;END uhc (harmless; delete them by hand)."
    EndIf
  EndIf
  Delete >NIL: ENV:UHCBIN QUIET
  ; the settings in ENVARC:UHC are yours and stay (as ENVARC:Claude does), over remove and over upgrade, which
  ; runs this part too
  Delete >NIL: ENV:UHC ALL QUIET
EndIf
; The tree: only the files the archive delivered are deleted (install.dos wrote them as UHC-Remove, one Delete
; each, with the full path), then the two stubs, then each drawer that is left empty. What UHC made afterwards
; (the packages the user installed with pkg: ExtBin, ExtDoc, Packages/Installed, db, dblocations) stays, like
; ENVARC:UHC, over remove and over upgrade. The drawer is never deleted whole.
FailAt 21
If EXISTS SYS:UHC/UHC-Remove
  Execute SYS:UHC/UHC-Remove
  Delete >NIL: SYS:UHC/UHC-Remove QUIET FORCE
  Delete >NIL: SYS:UHC/S/uhcupdate SYS:UHC/S/uhccheck QUIET FORCE
  Delete >NIL: SYS:UHC/C SYS:UHC/S SYS:UHC/Packages SYS:UHC QUIET
  If EXISTS SYS:UHC
    Echo "SYS:UHC/ExtBin, ExtDoc and Packages/Installed (your UHC packages) stay; delete SYS:UHC by hand to take them too."
  EndIf
EndIf
; installed by up-uhc 1.0 to 1.3 into UP-Term:uhc
Assign >NIL: UP-Term: EXISTS
If NOT WARN
  If EXISTS UP-Term:uhc
    If EXISTS UP-Term:uhc/UHC-Remove
      Execute UP-Term:uhc/UHC-Remove
      Delete >NIL: UP-Term:uhc/UHC-Remove QUIET FORCE
    Else
      ; installed by up-uhc 1.2, which wrote no list: the archive's two drawers and its package scripts
      Delete >NIL: UP-Term:uhc/C UP-Term:uhc/S ALL QUIET FORCE
      Delete >NIL: "UP-Term:uhc/Packages/~(Installed)" QUIET FORCE
    EndIf
    Delete >NIL: UP-Term:uhc/S/uhcupdate UP-Term:uhc/S/uhccheck QUIET FORCE
    Delete >NIL: UP-Term:uhc/C UP-Term:uhc/S UP-Term:uhc/Packages UP-Term:uhc QUIET
    If EXISTS UP-Term:uhc
      Echo "UP-Term:uhc/ExtBin, ExtDoc and Packages/Installed (your UHC packages) stay; delete UP-Term:uhc by hand to take them too."
    EndIf
  EndIf
EndIf
