Assign >NIL: Python3: EXISTS
If NOT WARN
  Assign Python3:
EndIf
; only this archive's block in S:User-Startup (unstartup.sh with its block name; the
; copy in ENVARC:up-term is the base's, written before the split too)
Set unvsh C:vsh
Assign >NIL: UP-Term: EXISTS
If NOT WARN
  If EXISTS UP-Term:bin/vsh
    Set unvsh UP-Term:bin/vsh
  EndIf
EndIf
If EXISTS ENVARC:up-term/unstartup.sh
  If EXISTS S:User-Startup
    $unvsh ENVARC:up-term/unstartup.sh python
    If EXISTS T:User-Startup.up-term
      Copy T:User-Startup.up-term S:User-Startup CLONE QUIET
      Delete >NIL: T:User-Startup.up-term QUIET
    EndIf
  EndIf
EndIf
UnSet unvsh
Delete >NIL: UP-Term:Python3 ALL QUIET
