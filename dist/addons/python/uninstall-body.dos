Assign >NIL: Python3: EXISTS
If NOT WARN
  Assign Python3:
EndIf
; this archive's block in S:User-Startup (";BEGIN Python3" to ";END Python3"). Three ways, in this order:
; 1. UP-Term is installed: its unstartup.sh takes out just this block, whatever else was added since;
; 2. Install kept S:User-Startup as it was: it is put back when the file is still as long as that plus the block;
; 3. neither: the block stays (it assigns only while SYS:Python3 exists, so it does nothing now) and
;    the message says where it is.
Search >NIL: S:User-Startup ";BEGIN Python3"
If NOT WARN
  Assign >NIL: UP-Term: EXISTS
  If NOT WARN
    If EXISTS UP-Term:bin/vsh
      If EXISTS ENVARC:up-term/unstartup.sh
        Delete >NIL: T:User-Startup.up-term QUIET
        UP-Term:bin/vsh ENVARC:up-term/unstartup.sh Python3
        If EXISTS T:User-Startup.up-term
          Copy T:User-Startup.up-term S:User-Startup CLONE QUIET
          Delete >NIL: T:User-Startup.up-term QUIET
        EndIf
      EndIf
    EndIf
  EndIf
EndIf
Search >NIL: S:User-Startup ";BEGIN Python3"
If NOT WARN
  If EXISTS ENVARC:upkg/up-python/User-Startup.before
    Copy ENVARC:upkg/up-python/User-Startup.before T:User-Startup.python CLONE QUIET
    Echo >>T:User-Startup.python ";BEGIN Python3"
    Echo >>T:User-Startup.python "If EXISTS SYS:Python3"
    Echo >>T:User-Startup.python "  Assign Python3: SYS:Python3"
    Echo >>T:User-Startup.python "EndIf"
    Echo >>T:User-Startup.python ";END Python3"
    ; the same bytes? (no C:Compare in a stock Workbench: the two sizes, written as Set lines and read back)
    List >T:User-Startup.size1 T:User-Startup.python LFORMAT "Set uspsize %L"
    List >T:User-Startup.size2 S:User-Startup LFORMAT "Set usnsize %L"
    Execute T:User-Startup.size1
    Execute T:User-Startup.size2
    If "$uspsize" EQ "$usnsize"
      Copy ENVARC:upkg/up-python/User-Startup.before S:User-Startup CLONE QUIET
    EndIf
    UnSet uspsize
    UnSet usnsize
    Delete >NIL: T:User-Startup.python T:User-Startup.size1 T:User-Startup.size2 QUIET
  EndIf
EndIf
Search >NIL: S:User-Startup ";BEGIN Python3"
If NOT WARN
  Echo "S:User-Startup changed since Python3 was installed: its lines from ;BEGIN Python3 to ;END Python3 stay (harmless; delete them by hand)."
EndIf
Delete >NIL: SYS:Python3 ALL QUIET
; the ixemul.library this archive installed (ENVARC:upkg/ixemul, see install.dos part ixemul): it goes
; only when UP-Term is not installed (UP-Term uses that library) and no other package recorded a need for
; it; the library it replaced is put back. Delete without ALL removes a drawer only when it is empty.
Delete >NIL: ENVARC:upkg/ixemul/needs/Python3 QUIET
If EXISTS ENVARC:upkg/ixemul/installed-by-Python3
  Assign >NIL: UP-Term: EXISTS
  If WARN
    Delete >NIL: ENVARC:upkg/ixemul/needs QUIET
    If NOT EXISTS ENVARC:upkg/ixemul/needs
      Delete >NIL: LIBS:ixemul.library LIBS:ixnet.library QUIET
      If EXISTS LIBS:ixemul.library.before-Python3
        Rename LIBS:ixemul.library.before-Python3 LIBS:ixemul.library
      EndIf
      If EXISTS LIBS:ixnet.library.before-Python3
        Rename LIBS:ixnet.library.before-Python3 LIBS:ixnet.library
      EndIf
      Delete >NIL: ENVARC:upkg/ixemul ALL QUIET
    EndIf
  EndIf
Else
  Delete >NIL: ENVARC:upkg/ixemul/needs ENVARC:upkg/ixemul QUIET
EndIf
; the quick-launch icon in UP-Term: (only when there is an UP-Term: to look in)
Assign >NIL: UP-Term: EXISTS
If NOT WARN
  Delete >NIL: "UP-Term:Python 3" "UP-Term:Python 3.info" QUIET
EndIf
