; @include dist/common/addon-head.installer

(if (not #update)
(
; welcome: n = 8, lead 3
(message
    "\n\n\nP E R L\n\n"
    "Perl 5.42.3, for an UP-Term window.\n"
    "It goes into UP-Term:bin and UP-Term:share,\n"
    "where the base had it.\n"
    "Needs UP-Term.lha installed first.\n"
    (all))
(set #kb-perl @KBCOPYPERL@)
(set #totalkb @KBTOTAL@)
(set #free (getdiskspace (pathonly #dest)))
(if (and (> #free 0) (< (/ #free 1024) #totalkb))
    (abort "Nothing was installed. " #dest " has " (/ #free 1024) " KB free;\n"
           "Perl needs about " #totalkb " KB. Free room and\n"
           "run Install again."))

;  ready: n = 7, lead 3
(message
    (cat "\n\n\nReady to install Perl into\n\n" #dest "\n\n"
         "about " (/ #totalkb 1024) " MB.\n"
         "Proceed starts the install;\n"
         "Abort Install leaves everything as it was."))
)
    ; Update: the options of the last install, from its record
    (
        (if (exists "@OPTS@/UPTOPTDEST") (run "Copy @OPTS@/#? ENV: QUIET"))
        (set #kb-perl 0)
        (set #totalkb (+ 1 (getenv "UPTUPDKB")))
        ))
(set #donekb 0)

(complete 0)

(P_OPTIONS)

(set #step "copy-perl" #kb #kb-perl #n 1
     #why "Copying Perl to UP-Term:bin and UP-Term:share.")
(P_STEP)

(set #n 6)
(P_LEAD)
(set #done
    (cat #lead "Perl is installed. In an UP-Term window, in vsh:\n"
         "  perl -v\n\n"
         "Uninstall (beside Install) takes Perl out again."))
; @include dist/common/addon-tail.installer
