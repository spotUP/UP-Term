; @include dist/common/addon-head.installer

(if (not #update)
(
; welcome: n = 8, lead 3
(message
    "\n\n\nS Q L I T E\n\n"
    "SQLite 3.54.1 command line shell (sqlite3) in UP-Term:bin\n"
    "Needs up-term.lha installed first.\n"
    (all))
(set #kb-sqlite @KBCOPYSQLITE@)
(set #totalkb @KBTOTAL@)
(set #free (getdiskspace (pathonly #dest)))
(if (and (> #free 0) (< (/ #free 1024) #totalkb))
    (abort "Nothing was installed. " #dest " has " (/ #free 1024) " KB free;\n"
           "sqlite needs about " #totalkb " KB. Free room and\n"
           "run Install again."))

;  ready: n = 7, lead 3
(message
    (cat "\n\n\nReady to install sqlite into\n\n" #dest "\n\n"
         "about " (/ #totalkb 1024) " MB.\n"
         "Proceed starts the install;\n"
         "Abort Install leaves everything as it was."))
)
    ; Update: the options of the last install, from its record
    (
        (if (exists "@OPTS@/UPTOPTDEST") (run "Copy @OPTS@/#? ENV: QUIET"))
        (set #kb-sqlite 0)
        (set #totalkb (+ 1 (getenv "UPTUPDKB")))
        ))
(set #donekb 0)

(complete 0)

(P_OPTIONS)

(set #step "copy-sqlite" #kb #kb-sqlite #n 1
     #why "Copying sqlite to UP-Term.")
(P_STEP)

(set #n 6)
(P_LEAD)
(set #done
    (cat #lead "sqlite is installed. In an UP-Term window, in vsh:\n"
         "  sqlite3\n\n"
         "Uninstall (beside Install) takes sqlite out again."))
; @include dist/common/addon-tail.installer
