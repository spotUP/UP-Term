; the VBCC: assign, and this package's block in S:User-Startup (";BEGIN vbcc" to ";END vbcc"):
; UP-Term's unstartup.sh takes out just that block, whatever else was added since. Without it the block
; stays (it does nothing once UP-Term:vbcc is gone) and the message says where it is.
Assign >NIL: VBCC: EXISTS
If NOT WARN
  Assign VBCC:
EndIf
Search >NIL: S:User-Startup ";BEGIN vbcc"
If NOT WARN
  Assign >NIL: UP-Term: EXISTS
  If NOT WARN
    If EXISTS UP-Term:bin/vsh
      If EXISTS ENVARC:up-term/unstartup.sh
        Delete >NIL: T:User-Startup.up-term QUIET
        UP-Term:bin/vsh ENVARC:up-term/unstartup.sh vbcc
        If EXISTS T:User-Startup.up-term
          Copy T:User-Startup.up-term S:User-Startup CLONE QUIET
          Delete >NIL: T:User-Startup.up-term QUIET
        EndIf
      EndIf
    EndIf
  EndIf
EndIf
Search >NIL: S:User-Startup ";BEGIN vbcc"
If NOT WARN
  Echo "S:User-Startup still has the lines from ;BEGIN vbcc to ;END vbcc (harmless; delete them by hand)."
EndIf
Delete >NIL: ENV:VBCC QUIET
; the paths dist/slim.txt names for this package, as the Install put them in UP-Term:
@SLIMDELETE@
