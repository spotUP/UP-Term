.KEY DIR/A,CONSOLE/S,NOCONSOLE/S,DEVICE/S,NODEVICE/S,SHELLICON/S,SERIAL/S,SSH/S,BEBBOGET/S,CURL/S,WASABI/S,PYTHON/S,NVIM/S,REMOTE/K,CPU040/S,CPU060/S,UNIFONT/S,EMOJI/S
.BRA {
.KET }
; UP-Term install: the XCON: console, PTY:, vsh, the terminal entries and
; the patched ixemul.library, the fonts by pixel shape.
; Run by the kit's Install (an Installer script), which asks the questions:
;   Execute <kit>/Files/install.dos <kit>/Files [CONSOLE|NOCONSOLE] [DEVICE|NODEVICE]
;     [SHELLICON]   (the Shell icon opens an UP-Term window: no unless asked)
;     [SERIAL]   (a serial login at every boot: no unless asked)
;     [SSH] [BEBBOGET] [CURL]   (the network tools, each: none unless asked)
;     [WASABI]  (wasabid, remote development, with a key: no unless asked)
;     [REMOTE "host port"]  (ENVARC:Claude/remote: plain Claude, with no API
;               key, connects to Claude Code there -- the NAS; kept if it exists)
;     [PYTHON]  (Python 3.14 in SYS:UP-Term/Python3, 15 MB; Python3: assigned at boot)
;     [NVIM]    (Neovim 0.12 in SYS:UP-Term/nvim, 32 MB; nvim on vsh's path)
;     [CPU040|CPU060]  (the CPU's builds of curl and libcryptossh.library)
; From a Shell without Installer, the same line installs (and asks itself).
; It asks whether UP-Term should also serve the system's CON: and RAW:
; (every new Shell window); CONSOLE answers yes, NOCONSOLE no, unasked.
; And whether console.device itself should be UP-Term's (every program's
; console window); DEVICE / NODEVICE answer that one.
; (The brackets are { } here: the script's > redirections stay as they are.)
FailAt 21
; the kit's Files drawer: every name below is relative to it
CD "{DIR}"
Copy vtcon-handler L: CLONE
Copy XCON DEVS:DOSDrivers/XCON CLONE
Copy pty-handler L: CLONE
Copy PTY DEVS:DOSDrivers/PTY CLONE
; The terminal entries live in ENVARC:up-term (ENV:up-term after a boot).
; Not in ENVARC:terminfo: AmigaDOS names ignore case, so that drawer IS the
; variable TERMINFO, and TERMINFO could no longer be set at all (an earlier
; kit did that; its entry goes). TERMINFO is set for every program: ncurses
; still finds the other terminals in its own directories. TERM and TERMCAP
; are not: TERM=vtcon in a ROM CON: window would send it xterm sequences.
; vsh sets both for itself on a vtcon console.
; A TERMINFO the user had is kept in ENVARC:up-term-orig for Uninstall:
; "env" the value of this boot, "envarc" the saved one. Once only, and never
; our own value (an Install over an Install). Before the drawer clean-up
; below, whose "Delete ENV:terminfo" is also the variable. Search gives 5
; for another value and 20 for the old kit's drawer (skipped).
If NOT EXISTS ENVARC:up-term-orig
  MakeDir >NIL: ENVARC:up-term-orig
  If EXISTS ENV:TERMINFO
    Search >NIL: ENV:TERMINFO /ENV/up-term/terminfo
    If WARN
      If NOT ERROR
        Copy ENV:TERMINFO ENVARC:up-term-orig/env CLONE
      EndIf
    EndIf
  EndIf
  If EXISTS ENVARC:TERMINFO
    Search >NIL: ENVARC:TERMINFO /ENV/up-term/terminfo
    If WARN
      If NOT ERROR
        Copy ENVARC:TERMINFO ENVARC:up-term-orig/envarc CLONE
      EndIf
    EndIf
  EndIf
EndIf
Delete >NIL: ENVARC:terminfo/v/vtcon ENV:terminfo/v/vtcon QUIET
Delete >NIL: ENVARC:terminfo/v ENVARC:terminfo ENV:terminfo/v ENV:terminfo QUIET
Delete >NIL: ENVARC:termcap.vtcon ENV:termcap.vtcon QUIET
MakeDir >NIL: ENVARC:up-term ENVARC:up-term/terminfo
; Uninstall's S:User-Startup filter first, before any block goes in: an
; Install cut short (the Replay lost its network mid-Install) still leaves
; the script that takes its blocks out again
Copy unstartup.sh ENVARC:up-term/unstartup.sh CLONE
Copy terminfo ENVARC:up-term/terminfo ALL CLONE QUIET
; colour themes for UP-Term Prefs' Theme... requester (one profile section
; each; ENVARC:up-term goes whole at Uninstall)
MakeDir >NIL: ENVARC:up-term/themes
Copy themes ENVARC:up-term/themes ALL CLONE QUIET
Copy termcap.vtcon ENVARC:up-term/termcap.vtcon CLONE
Copy ENVARC:up-term ENV:up-term ALL CLONE QUIET
; the window-preferences sample (/ENV/up-term/up-term, read by the XCON:
; handler, written by UP-Term Prefs): laid down where the user has no file,
; never over a file that is there
; (up-term.conf in the kit: a file named up-term would be UP-Term, the
; icon's stub, to AmigaDOS, which ignores case.) Preferences an earlier
; Uninstall kept in ENVARC:UP-Term.prefs come back first.
If NOT EXISTS ENVARC:up-term/up-term
  If EXISTS ENVARC:UP-Term.prefs
    Copy ENVARC:UP-Term.prefs ENVARC:up-term/up-term CLONE QUIET
  Else
    Copy up-term.conf ENVARC:up-term/up-term CLONE QUIET
  EndIf
EndIf
If NOT EXISTS ENV:up-term/up-term
  Copy ENVARC:up-term/up-term ENV:up-term/up-term CLONE QUIET
EndIf
SetEnv TERMINFO /ENV/up-term/terminfo
Copy ENV:TERMINFO ENVARC:TERMINFO CLONE
Copy vsh C:vsh CLONE
Copy ixkill C:ixkill CLONE
; the preferences editor: C:UP-Term Prefs (its file keeps the space) and a
; plain program icon in SYS:Prefs
Copy "UP-Term Prefs" "C:UP-Term Prefs" CLONE
; GNU screen, and its system screenrc (the port reads /ENV/screenrc)
Copy screen C:screen CLONE
Copy screenrc ENVARC:screenrc CLONE
Copy screenrc ENV:screenrc CLONE
; tmux, and its system tmux.conf (the port reads /ENV/tmux.conf)
Copy tmux C:tmux CLONE
Copy tmux.conf ENVARC:tmux.conf CLONE
Copy tmux.conf ENV:tmux.conf CLONE
; The Unix userland: GNU coreutils 5.2.1 (ls, cp, mv, rm, sort, head,
; wc... GPL v2: COPYING and the complete source are in the kit's
; coreutils-5.2.1 drawer) in UP-Term's own drawer SYS:UP-Term/bin, not C::
; AmigaDOS names ignore case, so GNU sort, date, join and install would be
; C:Sort, C:Date, C:Join and C:Install, which the system's scripts need.
; vsh finds them through $PATH (vshrc puts /SYS/UP-Term/bin first), and so
; do ixemul programs (execvp reads the same $PATH); the AmigaDOS Shell
; keeps its own commands.
MakeDir >NIL: SYS:UP-Term SYS:UP-Term/bin
Copy coreutils/bin SYS:UP-Term/bin ALL CLONE QUIET
; VERSIONS: what this kit was built from (C:UPConsole STATUS prints its first line)
Copy VERSIONS SYS:UP-Term/VERSIONS CLONE
; sz / rz: ZMODEM over the shell's own line (UP-Term's, no ixemul), beside
; coreutils; C:upgetty: a shell on the serial port (see the README)
Copy sz rz SYS:UP-Term/bin CLONE
; [UNIFONT]: GNU Unifont's glyphs (SIL Open Font License 1.1: OFL-1.1.txt
; and SOURCE.txt go with them), one file per 256 characters, 1.8 MB: drawn
; for every character up to U+FFFF and every emoji (U+1F000-1FAFF) the
; window's font lacks, at 8 and 16 pixels high. Not in FONTS: (FixFonts below scans it). Uninstall takes the
; whole of SYS:UP-Term.
If "{UNIFONT}" EQ "UNIFONT"
  MakeDir >NIL: SYS:UP-Term/unifont
  Copy unifont SYS:UP-Term/unifont ALL CLONE QUIET
EndIf
; [EMOJI]: Twemoji's colour emoji (CC-BY 4.0: CC-BY-4.0.txt and SOURCE.txt
; go with them), one file per 256 characters, 0.5 MB: drawn over two cells
; on an RTG screen of 15 bits or more with cybergraphics.library; other
; screens keep Unifont's one-colour glyph.
If "{EMOJI}" EQ "EMOJI"
  MakeDir >NIL: SYS:UP-Term/emoji
  Copy emoji SYS:UP-Term/emoji ALL CLONE QUIET
EndIf
Copy upgetty C:upgetty CLONE
; hl and mdv: a source file in colour, Markdown formatted for the window
; (README, VIEWING FILES), beside coreutils; vshrc pages them (hlp, mdp)
Copy hl mdv SYS:UP-Term/bin CLONE
; UPDemo: the terminal's show-off and benchmark (README, DEMO)
Copy UPDemo C:UPDemo CLONE
; C:UPTerm: the window's slash commands from scripts ("UPTerm cursor bar")
Copy UPTerm C:UPTerm CLONE
; C:ClaudeCode: Claude Code on the NAS through uptelnet (README, CLAUDE FROM
; THE AMIGA); a script, so the s bit makes it a command
Copy ClaudeCode C:ClaudeCode CLONE QUIET
Protect C:ClaudeCode +s QUIET
; C:uptelnet: a telnet client for the window (no ixemul; needs a TCP/IP
; stack), the Amiga end of Claude Code on a Mac (README, CLAUDE FROM THE AMIGA)
Copy uptelnet C:uptelnet CLONE
; The network tools, beside coreutils: BebboSSH 1.45 (bebbossh, bebboscp,
; bebbosshkeygen, bebbosshd) and bebboget 1.11, by Stefan Franke, GPL v3+,
; and curl 8.22.0 (below):
; COPYING and the complete source are in the kit's net drawer. vshrc makes
; ssh and scp of them. Their library goes to LIBS: unless one is there (a
; user's own BebboSSH keeps its library; Uninstall removes only ours).
If "{SSH}" EQ "SSH"
  Copy net/bebbossh-1.45/bebbossh net/bebbossh-1.45/bebboscp net/bebbossh-1.45/bebbosshkeygen net/bebbossh-1.45/bebbosshd SYS:UP-Term/bin CLONE QUIET
  If NOT EXISTS LIBS:libcryptossh.library
    If "{CPU060}" EQ "CPU060"
      Copy net/bebbossh-1.45/libcryptossh.library060 LIBS:libcryptossh.library CLONE
    Else
      Copy net/bebbossh-1.45/libcryptossh.library020 LIBS:libcryptossh.library CLONE
    EndIf
    Echo >ENVARC:up-term/cryptossh "installed by UP-Term"
  EndIf
EndIf
If "{BEBBOGET}" EQ "BEBBOGET"
  Copy net/bebboget-1.11/bebboget net/bebboget-1.11/installcerts SYS:UP-Term/bin CLONE QUIET
EndIf
; curl 8.22.0 (the curl licence, net/curl-8.22.0); it needs AmiSSL 5
If "{CURL}" EQ "CURL"
  If "{CPU060}" EQ "CPU060"
    Copy net/curl-8.22.0/curl.060 SYS:UP-Term/bin/curl CLONE QUIET
  Else
    If "{CPU040}" EQ "CPU040"
      Copy net/curl-8.22.0/curl.040 SYS:UP-Term/bin/curl CLONE QUIET
    Else
      Copy net/curl-8.22.0/curl.020 SYS:UP-Term/bin/curl CLONE QUIET
    EndIf
  EndIf
EndIf
; C:Claude, the native Claude client (README, Claude), always: its talking
; to Anthropic needs AmiSSL 5; ENVARC:Claude is where its settings go
; (Install never writes a key).
Copy Claude C:Claude CLONE QUIET
If NOT EXISTS ENVARC:Claude
  MakeDir ENVARC:Claude
EndIf
; REMOTE: where Claude Code runs (the NAS); plain Claude goes there
If NOT "{REMOTE}" EQ ""
  If NOT EXISTS ENVARC:Claude/remote
    Echo >ENVARC:Claude/remote "; Claude Code on another computer: host and port. With no API key,"
    Echo >>ENVARC:Claude/remote "; plain Claude connects there (uptelnet). Delete this file to stop."
    Echo >>ENVARC:Claude/remote "{REMOTE}"
  EndIf
EndIf
; Python 3.14 (README, PYTHON): SYS:UP-Term/Python3, its programs run as
; Python3:bin/python3 or python3 from vsh (vshrc's path); Python3: is
; assigned at every boot (a marked block in S:User-Startup).
If "{PYTHON}" EQ "PYTHON"
  MakeDir >NIL: SYS:UP-Term/Python3
  Copy python3 SYS:UP-Term/Python3 ALL CLONE QUIET
  Assign Python3: SYS:UP-Term/Python3
  Search >NIL: S:User-Startup ";BEGIN UP-Term python"
  If WARN
    If NOT EXISTS S:User-Startup.before-UP-Term
      Copy S:User-Startup S:User-Startup.before-UP-Term CLONE
    EndIf
    Echo >>S:User-Startup ";BEGIN UP-Term python"
    Echo >>S:User-Startup "Assign Python3: SYS:UP-Term/Python3"
    Echo >>S:User-Startup ";END UP-Term python"
  EndIf
EndIf
; Neovim 0.12 (README, NEOVIM): SYS:UP-Term/nvim (its runtime beside the
; binary); nvim from vsh (vshrc's path).
If "{NVIM}" EQ "NVIM"
  MakeDir >NIL: SYS:UP-Term/nvim
  Copy nvim SYS:UP-Term/nvim ALL CLONE QUIET
EndIf
; The fonts by pixel shape (fonts/SOURCE.txt): TopazPro 16, IBM 8 / 11 /
; 16 into FONTS:, only the sizes not there yet -- a user's own IBM.font
; keeps its files -- each marked for Uninstall; FixFonts then lists every
; size in the .font files
MakeDir >NIL: FONTS:TopazPro FONTS:IBM
If NOT EXISTS FONTS:TopazPro/16
  Copy fonts/TopazPro/16 FONTS:TopazPro/16 CLONE QUIET
  Echo >ENVARC:up-term/font-TopazPro-16 "installed by UP-Term"
Else
  ; ours from an earlier kit: replaced, its baseline is fixed (13, not 6)
  If EXISTS ENVARC:up-term/font-TopazPro-16
    Copy fonts/TopazPro/16 FONTS:TopazPro/16 CLONE QUIET
  EndIf
EndIf
If NOT EXISTS FONTS:IBM/8
  Copy fonts/IBM/8 FONTS:IBM/8 CLONE QUIET
  Echo >ENVARC:up-term/font-IBM-8 "installed by UP-Term"
EndIf
If NOT EXISTS FONTS:IBM/11
  Copy fonts/IBM/11 FONTS:IBM/11 CLONE QUIET
  Echo >ENVARC:up-term/font-IBM-11 "installed by UP-Term"
EndIf
If NOT EXISTS FONTS:IBM/16
  Copy fonts/IBM/16 FONTS:IBM/16 CLONE QUIET
  Echo >ENVARC:up-term/font-IBM-16 "installed by UP-Term"
EndIf
If NOT EXISTS FONTS:TopazPro.font
  Copy fonts/TopazPro.font FONTS: CLONE QUIET
EndIf
If NOT EXISTS FONTS:IBM.font
  Copy fonts/IBM.font FONTS: CLONE QUIET
EndIf
If EXISTS SYS:System/FixFonts
  SYS:System/FixFonts
EndIf
; The shell ixemul programs run (system(), popen(), tmux's jobs) is
; /gg/bin/sh -- GG:bin/sh, where Geek Gadgets keeps its sh: vsh, as
; SYS:UP-Term/bin/sh. Without a GG: SYS:UP-Term is GG:, assigned at every
; boot by a marked block in S:User-Startup (Uninstall takes it out, its
; marker says Install made it). An existing GG: is left as it is.
Copy vsh SYS:UP-Term/bin/sh CLONE
Assign >NIL: GG: EXISTS
If WARN
  Assign GG: SYS:UP-Term
  Echo >ENVARC:up-term/gg "installed by UP-Term"
  If NOT EXISTS S:User-Startup
    Echo >S:User-Startup ""
  EndIf
  ; its own line, not ";BEGIN UP-Term": that also starts the other blocks
  Search >NIL: S:User-Startup "Assign GG: SYS:UP-Term"
  If WARN
    If NOT EXISTS S:User-Startup.before-UP-Term
      Copy S:User-Startup S:User-Startup.before-UP-Term CLONE
    EndIf
    Echo >>S:User-Startup ";BEGIN UP-Term"
    Echo >>S:User-Startup "Assign >NIL: GG: EXISTS"
    Echo >>S:User-Startup "If WARN"
    Echo >>S:User-Startup "  Assign GG: SYS:UP-Term"
    Echo >>S:User-Startup "EndIf"
    Echo >>S:User-Startup ";END UP-Term"
  EndIf
EndIf
; /tmp: ixemul programs put their temporary files there (sort, mktemp,
; vim's swap), and to ixemul /tmp is the volume TMP:, which AmigaOS does
; not assign. Without one UP-Term assigns it to T:, at every boot by a
; marked block in S:User-Startup; Uninstall takes both away. An existing
; TMP: is left as it is.
Assign >NIL: TMP: EXISTS
If WARN
  Assign TMP: T:
  Echo >ENVARC:up-term/tmp "installed by UP-Term"
  If NOT EXISTS S:User-Startup
    Echo >S:User-Startup ""
  EndIf
  Search >NIL: S:User-Startup "Assign TMP: T:"
  If WARN
    If NOT EXISTS S:User-Startup.before-UP-Term
      Copy S:User-Startup S:User-Startup.before-UP-Term CLONE
    EndIf
    Echo >>S:User-Startup ";BEGIN UP-Term tmp"
    Echo >>S:User-Startup "Assign >NIL: TMP: EXISTS"
    Echo >>S:User-Startup "If WARN"
    Echo >>S:User-Startup "  Assign TMP: T:"
    Echo >>S:User-Startup "EndIf"
    Echo >>S:User-Startup ";END UP-Term tmp"
  EndIf
EndIf
; the Workbench way in: double-click UP-Term (its tool is C:vsh; the
; window is its WINDOW tooltype)
; the UP-Term icon goes beside Shell in SYS:System, the preferences editor
; into SYS:Prefs. A kit older than this one put both in SYS:Utilities: those
; copies are removed.
Copy UP-Term UP-Term.info SYS:System CLONE
If NOT EXISTS SYS:Prefs
  MakeDir SYS:Prefs
EndIf
Copy UP-Term-Prefs UP-Term-Prefs.info SYS:Prefs CLONE
Delete >NIL: SYS:Utilities/UP-Term SYS:Utilities/UP-Term.info SYS:Utilities/UP-Term-Prefs SYS:Utilities/UP-Term-Prefs.info QUIET
; SHELLICON: the Shell icon (SYS:System/Shell) opens its window on XCON:,
; its place, size, title and options as they were (upicon swaps only the
; WINDOW tooltype's device). The icon as it was is kept in
; ENVARC:up-term-orig for Uninstall (a second Install keeps the first copy).
If "{SHELLICON}" EQ "SHELLICON"
  If EXISTS SYS:System/Shell.info
    If NOT EXISTS ENVARC:up-term-orig/Shell.info
      Copy SYS:System/Shell.info ENVARC:up-term-orig/Shell.info CLONE
    EndIf
    upicon SYS:System/Shell WINDOWDEV=XCON
  EndIf
EndIf
; SERIAL: a Unix-style login on the serial port at every boot (upgetty LOOP:
; vsh for whoever connects, see the README's SERIAL LOGIN), from a marked
; block in S:User-Startup that Uninstall takes out. upgetty then holds
; serial.device: nothing else can use the port while it runs.
If "{SERIAL}" EQ "SERIAL"
  If NOT EXISTS S:User-Startup
    Echo >S:User-Startup ""
  EndIf
  Search >NIL: S:User-Startup "C:upgetty LOOP"
  If WARN
    If NOT EXISTS S:User-Startup.before-UP-Term
      Copy S:User-Startup S:User-Startup.before-UP-Term CLONE
    EndIf
    Echo >>S:User-Startup ";BEGIN UP-Term serial"
    Echo >>S:User-Startup "Run >NIL: C:upgetty LOOP"
    Echo >>S:User-Startup ";END UP-Term serial"
  EndIf
EndIf
; WASABI: wasabid in C: (wasabi/SOURCE.txt), for working on this Amiga
; from another machine over the network. It runs any command a client with
; the key sends -- and with no key set, any client's: wasabikey makes one
; (a key already set stays), saved in ENVARC:wasabi.key (a marker when it
; is ours, for Uninstall). Started now and at every boot from a marked
; block in S:User-Startup.
If "{WASABI}" EQ "WASABI"
  If NOT EXISTS C:wasabid
    Echo >ENVARC:up-term/wasabid "installed by UP-Term"
  EndIf
  Copy wasabi/wasabid C:wasabid CLONE
  If NOT EXISTS ENV:wasabi.key
    Echo >ENVARC:up-term/wasabikey "installed by UP-Term"
  EndIf
  wasabi/wasabikey >NIL:
  If NOT EXISTS S:User-Startup
    Echo >S:User-Startup ""
  EndIf
  Search >NIL: S:User-Startup "C:wasabid"
  If WARN
    If NOT EXISTS S:User-Startup.before-UP-Term
      Copy S:User-Startup S:User-Startup.before-UP-Term CLONE
    EndIf
    Echo >>S:User-Startup ";BEGIN UP-Term wasabi"
    Echo >>S:User-Startup "Run >NIL: C:wasabid"
    Echo >>S:User-Startup ";END UP-Term wasabi"
  EndIf
  Status >NIL: COM C:wasabid
  If WARN
    Run >NIL: C:wasabid
  EndIf
EndIf
MakeDir >NIL: ENVARC:vsh
Copy vshrc ENVARC:vsh/vshrc CLONE
Copy banner ENVARC:vsh/banner CLONE
MakeDir >NIL: ENV:vsh
Copy vshrc ENV:vsh/vshrc CLONE
Copy banner ENV:vsh/banner CLONE
; ixemul.library with the UP-Term patches (termios, PTY: ptys, job
; control), and ixnet.library from the same build: ixnet refuses an ixemul
; of another version or revision. Each library there is kept once as
; LIBS:<name>.orig.
If NOT EXISTS LIBS:ixemul.library.orig
  If EXISTS LIBS:ixemul.library
    Copy LIBS:ixemul.library LIBS:ixemul.library.orig CLONE
  EndIf
EndIf
Copy libs/ixemul.library LIBS:ixemul.library CLONE
If NOT EXISTS LIBS:ixnet.library.orig
  If EXISTS LIBS:ixnet.library
    Copy LIBS:ixnet.library LIBS:ixnet.library.orig CLONE
  EndIf
EndIf
Copy libs/ixnet.library LIBS:ixnet.library CLONE
Avail >NIL: FLUSH
; a DOSDrivers file is mounted by its path ("Mount XCON: FROM file" looks
; for an XCON: entry inside, which a DOSDrivers file has not; >NIL: hid
; that, so XCON: only appeared after a reboot). Not twice: it is there.
Assign >NIL: XCON: EXISTS DEVICES
If WARN
  Mount DEVS:DOSDrivers/XCON
EndIf
; IXPIPE: (ixemul's own handler): kept as it is when ixemul's install put
; it there; ENVARC:up-term/ixpipe marks ours for Uninstall
If NOT EXISTS DEVS:DOSDrivers/IXPIPE
  Copy ixpipe-handler L: CLONE
  Copy IXPIPE DEVS:DOSDrivers/IXPIPE CLONE
  Echo >ENVARC:up-term/ixpipe "installed by UP-Term"
EndIf
Assign >NIL: IXPIPE: EXISTS DEVICES
If WARN
  Mount DEVS:DOSDrivers/IXPIPE
EndIf
Assign >NIL: PTY: EXISTS DEVICES
If WARN
  Mount DEVS:DOSDrivers/PTY
EndIf
; CON: and RAW: served by UP-Term (opt-in): C:UPConsole switches them at
; every boot from its own marked block in S:User-Startup, and now. Not on
; AmigaOS 3.2 yet: its Shell needs medium mode (UPConsole refuses there).
Copy UPConsole C:UPConsole CLONE
Version >NIL: dos.library 47
If WARN
  Set upcon "{CONSOLE}"
  If "{NOCONSOLE}" EQ "NOCONSOLE"
    Set upcon ""
  Else
    If "{CONSOLE}" EQ ""
      Ask "Should UP-Term also serve CON: and RAW: (every new Shell window)? y/N"
      If WARN
        Set upcon "CONSOLE"
      EndIf
    EndIf
  EndIf
  If "$upcon" EQ "CONSOLE"
    If NOT EXISTS S:User-Startup
      Echo >S:User-Startup ""
    EndIf
    Search >NIL: S:User-Startup ";BEGIN UP-Term console"
    If WARN
      If NOT EXISTS S:User-Startup.before-UP-Term
        Copy S:User-Startup S:User-Startup.before-UP-Term CLONE
      EndIf
      Echo >>S:User-Startup ";BEGIN UP-Term console"
      Echo >>S:User-Startup "C:UPConsole >NIL: CON ON"
      Echo >>S:User-Startup ";END UP-Term console"
    EndIf
    C:UPConsole CON ON
  EndIf
  UnSet upcon
  ; console.device served by UP-Term (opt-in): UPConsole DEVICE ON at every
  ; boot from its own block, and now. Not on 3.2 before it is tested there.
  Copy up-console.device DEVS:up-console.device CLONE
  Set updev "{DEVICE}"
  If "{NODEVICE}" EQ "NODEVICE"
    Set updev ""
  Else
    If "{DEVICE}" EQ ""
      Ask "Should console.device be UP-Term's too (every program's console window)? y/N"
      If WARN
        Set updev "DEVICE"
      EndIf
    EndIf
  EndIf
  If "$updev" EQ "DEVICE"
    If NOT EXISTS S:User-Startup
      Echo >S:User-Startup ""
    EndIf
    Search >NIL: S:User-Startup ";BEGIN UP-Term device"
    If WARN
      If NOT EXISTS S:User-Startup.before-UP-Term
        Copy S:User-Startup S:User-Startup.before-UP-Term CLONE
      EndIf
      Echo >>S:User-Startup ";BEGIN UP-Term device"
      Echo >>S:User-Startup "C:UPConsole >NIL: DEVICE ON"
      Echo >>S:User-Startup ";END UP-Term device"
    EndIf
    C:UPConsole DEVICE ON
  EndIf
  UnSet updev
Else
  Echo "CON: and console.device stay the system's: UP-Term cannot serve them on AmigaOS 3.2 yet."
EndIf
Echo "UP-Term installed. Try:  NewShell XCON:0/20/640/300/UP-Term/CLOSE"
Echo "The Unix-style shell: type  vsh  in an XCON: window (exit returns to the Shell)"
