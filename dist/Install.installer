; UP-Term -- Installer script (Commodore Installer 43.3, AmigaOS 3.1, and the
; Installer 47 of AmigaOS 3.2). Double-click the Install icon.
;
; What gets installed is Files/install.dos, part by part (its Lab lines): the
; Installer asks the questions, then runs each part with STEP=<part> under its
; own progress text, and copies the big drawers (the copy-<part> parts of
; install.dos) itself with copyfiles, which shows every file it copies. The
; same install.dos with no STEP installs everything from a Shell.
; tests/test_dist_installer.py holds this script and install.dos to the same
; parts in the same order, and to the Installer 43.3 language.
; Remove UP-Term again with Uninstall.
; Neovim, Python, Claude and amiga-pi are archives of their own (UP-Term-nvim,
; Python3, Claude, amiga-pi), each with an Install of its own; the last three
; stand alone and install with no UP-Term.
;
; TEXT LAYOUT, measured 2026-10-08 (installer_rig's text check reads the
; page's pixels):
;   Installer 43.3, AmigaOS 3.1 (RTG): window 496x210, 12 px a line, the
;     first line at y 16, about 5.8 px a character;
;   Installer 47, AmigaOS 3.2 PAL Workbench: window 560x176, 10 px a line,
;     the first line at y 13, about 8.6 px a character: a 60-character
;     line already wraps there (the welcome's three did, and its 14 lines
;     became 17).
; On both a page with one button row holds 14 lines, one with two rows
; (Help) 13; a (working) page holds its "Working on installation" line, a
; blank one and 14 lines of ours under them. Installer 43.3 starts the text
; at the top, Installer 47 centres a (message) page itself. So every
; (message), (working) and (prompt) text here has
;   - explicit line breaks and no line longer than 56 characters
;     (tests/test_dist_installer.py holds the literal ones to it), and
;   - leading newlines that centre the block of n lines:
;       lead = floor((14 - n) / 2)      (P_LEAD)
;     (n = 14 needs none; a block of more than 14 lines does not fit).
; copyfiles draws its panel (file, drawer, bar, Abort) over the whole page
; below the Working line, on both: P_COPY writes no text of its own there
; (what peeked out at the panel's sides on 3.2 was cut text).

(set @app-name "UP-Term")
(set #files (tackon (pathonly @icon) "Files"))
(set #script (tackon #files "install.dos"))

; @include dist/common/requirements.installer

; @include dist/common/update.installer

(if (not #update)
(
; ---- welcome ---------------------------------------------------------------

; welcome: n = 13, lead 0
(message
    "U P - T E R M\n\n"
    "a modern terminal for AmigaOS\n\n"
    "XCON:, a console window with an xterm-class terminal;\n"
    "vsh, a Unix shell with tmux, screen and GNU commands;\n"
    "PTY:, Unix pseudo-terminals; UP-Term Prefs with 112\n"
    "colour themes; a patched ixemul.library.\n\n"
    "The next pages ask where UP-Term's own drawer goes\n"
    "and which parts you want. Every page has a Help button.\n"
    "Neovim, Python, Claude and amiga-pi are archives of\n"
    "their own: Neovim wants this one first."
    (all))

; ---- where UP-Term's own drawer goes ---------------------------------------
; Its commands, Unifont and emoji live in one drawer (the add-on archives'
; files go there too) that is assigned as UP-Term: now and at every boot; every
; program reaches the files through that name. An earlier install's drawer is
; the default.

(set #old (getassign "UP-Term" "a"))
(set #dest (if #old #old "SYS:UP-Term"))
; asked again, with the last answer as its default, when the disk of the drawer is too small (room on the disk)
(procedure P_ASKDEST
    (set #dest
        (askdir
            (prompt "Where should UP-Term's own drawer go? It is assigned as\n"
                    "UP-Term: and holds the Unix commands, Unifont, emoji\n"
                    "and the files of the add-on archives.")
            (help "The drawer is made if it is not there (its parent must "
                  "exist). Programs find it through the assign UP-Term:, which "
                  "Install makes now and at every boot (a block in "
                  "S:User-Startup that Uninstall takes out again).\n\n"
                  "An earlier UP-Term's drawer is offered first: installing into "
                  "it again replaces the files and keeps your settings.")
            (default #dest)
            (newpath)))
    (if (= (substr #dest (- (strlen #dest) 1) 1) ":")
        (set #dest (tackon #dest "UP-Term")))
    (set @default-dest #dest))
(P_ASKDEST)

; ---- what to install: three pages of choices -------------------------------

(set #con "NOCONSOLE")
(set #dev "NODEVICE")
(set #shellicon "")
(set #serial "")
(set #ssh "")
(set #bget "")
(set #curl "")
(set #wasabi "")
(set #unifont "")
(set #emoji "")
(set #cpu060 (if (= (database "cpu") "68060") "CPU060" ""))
(set #cpu040 (if (= (database "cpu") "68040") "CPU040" ""))
; @include dist/common/amissl.installer

(set #net
    (askoptions
        (prompt "Network tools, in UP-Term:bin (they need a TCP/IP stack\n"
                "such as Roadshow or AmiTCP):")
        (help "ssh and scp: BebboSSH 1.46.1 (Matthias Muench's fixed build of Stefan Franke's program, GPL v3+), an SSH "
              "client for remote Unix machines, with scp, a key generator and "
              "a simple server. Its libcryptossh.library goes to LIBS: (an older one "
              "of UP-Term's is replaced; your own BebboSSH library is kept, "
              "with a note if it is older).\n\n"
              "bebboget: https downloads (GPL v3+), by the same author.\n\n"
              "curl 8.22.0: downloads and transfers (the curl licence). It needs "
              "AmiSSL 5 (Aminet util/libs/AmiSSL-v5-OS3.lha), so it is ticked "
              "only when AmiSSL is found.\n\n"
              "Their licences and sources are in the kit's Files/net drawer.")
        (choices "ssh and scp (BebboSSH)"
                 "bebboget (https downloads)"
                 (if #amissl "curl (AmiSSL 5 found)" "curl (needs AmiSSL 5, not found)"))
        (default (+ 1 2 (if #amissl 4 0)))))
(if (in #net 0) (set #ssh "SSH"))
(if (in #net 1) (set #bget "BEBBOGET"))
(if (in #net 2) (set #curl "CURL"))

(set #extra
    (askoptions
        (prompt "Extras:")
        (help "Unifont: GNU Unifont's glyphs (SIL Open Font License 1.1), "
              "1.8 MB in UP-Term:unifont. UP-Term draws every character up to "
              "U+FFFF your font lacks from them (Cyrillic, Greek, CJK, "
              "symbols), and emoji two cells wide, when the font is 8 or 16 "
              "pixels high. Without them such characters show as '?'.\n\n"
              "Colour emoji: Twemoji (CC-BY 4.0), 0.5 MB in UP-Term:emoji, "
              "drawn in colour on an RTG screen of 15 bits or more "
              "(Picasso96, CyberGraphX); other screens use Unifont's glyph.\n\n"
              "Shell icon: SYS:System/Shell's WINDOW tooltype is changed to "
              "XCON:, so the Shell opens an UP-Term window. A copy of the icon "
              "is kept in ENVARC:up-term-orig and Uninstall puts it back.")
        (choices "Unifont: glyphs for every character and emoji (1.8 MB)"
                 "Colour emoji for RTG screens (Twemoji, 0.5 MB)"
                 "Shell icon opens an UP-Term window")
        (default (+ 1 2))))
(if (in #extra 0) (set #unifont "UNIFONT"))
(if (in #extra 1) (set #emoji "EMOJI"))
(if (and (in #extra 2) (exists "SYS:System/Shell.info")) (set #shellicon "SHELLICON"))

(set #boot
    (askoptions
        (prompt "Started at every boot (both off unless you tick them):")
        (help "Serial login: C:upgetty LOOP runs at every boot from a block in "
              "S:User-Startup, and a terminal program on a null-modem cable at "
              "19200 baud gets vsh. While it runs no other program can use the "
              "serial port.\n\n"
              "wasabi 0.9 (remote development, MIT, by Tobias Karlsson): "
              "wasabid in C:, so a Mac or Linux machine on your network can "
              "copy files to this Amiga, run commands on it, grab its screen "
              "and read its debug output, and Claude Code there can drive it "
              "(wasabi_mcp.py). It replaces the older wasabid and amiagent "
              "of earlier kits. It runs ANY command a client with its key "
              "sends: Install makes a key (or keeps yours, ENVARC:wasabi.key) "
              "and shows it at the end. The link is encrypted only when "
              "AmiSSL and keys are set up (see wasabi's README). Leave it off "
              "unless you work on this Amiga from another machine.\n"
              "Without it, Claude.lha brings its own wasabid for the session "
              "daemon: uptelnet starts one with a key of its own for each "
              "login to the NAS and ends it with the login, and the daemon "
              "left in C: here is not started at boot.\n\n"
              "Uninstall takes both blocks out again.")
        (choices "Serial login on the serial port"
                 "wasabi: remote development from another computer")
        (default 0)))
(if (in #boot 0) (set #serial "SERIAL"))
(if (in #boot 1) (set #wasabi "WASABI"))

; ---- taking over the system's console: a page of its own -----------------

(set #sys
    (askoptions
        (prompt "UP-Term can also take over the system's console.\n"
                "Leave both off to keep the system's own.")
        (help "CON: and RAW:: every new Shell window is an UP-Term window "
              "(the Amiga look, with UP-Term's line editing, history and Tab "
              "completion); C:UPConsole CON OFF switches back. Refused when "
              "another console replacement (KingCON, ViNCEd...) serves CON:.\n\n"
              "console.device: every program's console window (Ed, More, the "
              "system's Shell windows) draws with UP-Term's engine; C:UPConsole "
              "DEVICE OFF switches back. Refused when console.device was patched "
              "by another program.\n\n"
              "Each is switched on at every boot by a block in S:User-Startup, "
              "which Uninstall takes out.")
        (choices "UP-Term serves CON: and RAW:"
                 "console.device is UP-Term's")
        (default 0)))
(if (in #sys 0) (set #con "CONSOLE"))
(if (in #sys 1) (set #dev "DEVICE"))

; ---- the size of each part, in KB ------------------------------------------
; What each part takes on the disk, counted by `make dist` from the files of
; this kit (tools/kitsize.py: blocks, not bytes; the options' files only when
; they are ticked). They pace the percent bar and they are what the room on
; the disk is checked against. A part of few files counts its minimum.

(set #kb-drawer @KBDRAWER@)
(set #kb-system @KBSYSTEM@)
(set #kb-coreutils @KBCOPYCOREUTILS@)
(set #kb-userland @KBCOPYUSERLAND@)
(set #kb-manpages @KBUSERLAND@)
(set #kb-unifont (if #unifont @KBCOPYUNIFONT@ 0))
(set #kb-emoji (if #emoji @KBCOPYEMOJI@ 0))
(set #kb-tools (+ @KBTOOLS@ (if #ssh @KBSSH@ 0) (if #bget @KBBEBBOGET@ 0) (if #curl @KBCURL@ 0)))
; fonts, unix, desktop, boot (with wasabi), libs, mount, console, record: their #kb below
(set #kb-rest (+ @KBFONTS@ 60 @KBDESKTOP@ @KBBOOT@ (if #wasabi @KBWASABI@ 0) @KBLIBS@ @KBMOUNT@ @KBCONSOLE@ 20))
(set #totalkb (+ #kb-drawer #kb-system #kb-coreutils #kb-userland #kb-manpages #kb-unifont #kb-emoji
                 #kb-tools #kb-rest))
(set #donekb 0)

; ---- room on the disk --------------------------------------------------------
; getdiskspace answers -1 when it cannot tell (and Installer 43.3 can
; overflow on a volume past 2 GB): only a positive answer that is too small
; asks. The drawer's disk too small: say how much there is and how much the
; chosen parts need, and ask for another drawer (Abort Install ends it).

(set #roomok 0)
(while (not #roomok)
    (
        (set #free (getdiskspace (pathonly #dest)))
        (if (and (> #free 0) (< (/ #free 1024) #totalkb))
            (
                (message
                    (cat "\n\n\n" #dest " has " (/ #free 1024) " KB free;\n"
                         "the parts you chose need about " #totalkb " KB.\n\n"
                         "Nothing has been copied. Proceed asks for\n"
                         "another drawer, on a drive with room;\n"
                         "Abort Install leaves everything as it was."))
                (P_ASKDEST)
            )
            (set #roomok 1))
    ))
; what goes on SYS: whatever the drawer's volume is (C:, L:, LIBS:, DEVS:, fonts,
; the S:User-Startup block)
(set #sysfree (getdiskspace "SYS:"))
(if (and (> #sysfree 0) (< (/ #sysfree 1024) (+ #kb-system #kb-rest)))
    (abort "Nothing was installed. SYS: has " (/ #sysfree 1024) " KB free;\n"
           "UP-Term puts about " (+ #kb-system #kb-rest) " KB there.\n"
           "Free room on SYS: and run Install again."))

;  ready: n = 9, lead 3
(message
    (cat "\n\n\nReady to install UP-Term into\n\n" #dest "\n\n"
         "about " (/ #totalkb 1024) " MB. Each part says what it does while it runs,\n"
         "and the bar shows how far the whole install is.\n\n"
         "Proceed starts the install;\n"
         "Abort Install leaves everything as it was."))
)
    ; Update: the options of the last install, from its record
    (
        (run "Copy @OPTS@/#? ENV: QUIET")
        (set #dest (getenv "UPTOPTDEST"))
        (set @default-dest #dest)
        (set #con (if (exists "ENV:UPTOPTCONSOLE") "CONSOLE" "NOCONSOLE"))
        (set #dev (if (exists "ENV:UPTOPTDEVICE") "DEVICE" "NODEVICE"))
        (set #shellicon (getenv "UPTOPTSHELLICON"))
        (set #serial (getenv "UPTOPTSERIAL"))
        (set #ssh (getenv "UPTOPTSSH"))
        (set #bget (getenv "UPTOPTBEBBOGET"))
        (set #curl (getenv "UPTOPTCURL"))
        (set #wasabi (getenv "UPTOPTWASABI"))
        (set #unifont (getenv "UPTOPTUNIFONT"))
        (set #emoji (getenv "UPTOPTEMOJI"))
        (set #cpu040 (getenv "UPTOPTCPU040"))
        (set #cpu060 (getenv "UPTOPTCPU060"))
        (set #kb-drawer 0 #kb-system 0 #kb-coreutils 0 #kb-userland 0 #kb-manpages 0 #kb-unifont 0 #kb-emoji 0
             #kb-tools 0)
        ; the parts upupdate named, and the record part's 1
        (set #totalkb (+ 1 (getenv "UPTUPDKB")))
        (set #donekb 0)))

; @include dist/common/procs.installer

; the options of this install: each becomes the file ENV:UPTOPT<name> that
; install.dos reads (P_OPTIONS, in the shared procedures, calls this)
(procedure P_OPTIONS_LIST
    (set #name "DEST" #val #dest) (P_OPT)
    (set #name #con #val #con) (P_OPT)
    (set #name #dev #val #dev) (P_OPT)
    (set #name "SHELLICON" #val #shellicon) (P_OPT)
    (set #name "SERIAL" #val #serial) (P_OPT)
    (set #name "SSH" #val #ssh) (P_OPT)
    (set #name "BEBBOGET" #val #bget) (P_OPT)
    (set #name "CURL" #val #curl) (P_OPT)
    (set #name "WASABI" #val #wasabi) (P_OPT)
    (set #name "CPU040" #val #cpu040) (P_OPT)
    (set #name "CPU060" #val #cpu060) (P_OPT)
    (set #name "UNIFONT" #val #unifont) (P_OPT)
    (set #name "EMOJI" #val #emoji) (P_OPT))

(complete 0)

(P_OPTIONS)

(set #step "drawer" #kb #kb-drawer #n 4
     #why (cat "Making UP-Term's own drawer\n" #dest ",\n"
               "assigned as UP-Term: now and at every boot\n"
               "(a block in S:User-Startup)."))
(P_STEP)

(set #step "system" #kb #kb-system #n 3
     #why (cat "Installing the XCON: and PTY: handlers, the terminal\n"
               "entries, the colour themes, and vsh, tmux and\n"
               "screen in C:."))
(P_STEP)

(set #from (tackon #files "coreutils/bin") #to (tackon #dest "bin") #part "copy-coreutils" #kb #kb-coreutils #n 3
     #why (cat "Copying the Unix commands (GNU coreutils: ls, cp,\n"
               "sort...) to UP-Term:bin. They stay out of C:, where\n"
               "AmigaDOS keeps its own Sort, Date and Join."))
(P_COPY)

(set #from (tackon #files "userland/bin") #to (tackon #dest "bin") #part "copy-userland" #kb #kb-userland #n 3
     #why (cat "Copying the Unix tools to UP-Term:bin: grep, sed,\n"
               "awk, less, nano, find, diff, patch, man, tar, gzip,\n"
               "xz, zip and the terminal commands (tput, reset...)."))
(P_COPY)

(set #step "userland" #kb #kb-manpages #n 3
     #why (cat "Installing the manual pages (UP-Term:share/man),\n"
               "nano's syntax colours, and each Unix tool's licence\n"
               "(UP-Term:licenses)."))
(P_STEP)

(if #unifont
    (
        (set #from (tackon #files "unifont") #to (tackon #dest "unifont") #part "copy-unifont" #kb #kb-unifont #n 2
             #why (cat "Copying GNU Unifont's glyphs to UP-Term:unifont:\n"
                       "every character your font lacks is drawn from them."))
        (P_COPY)
    ))

(if #emoji
    (
        (set #from (tackon #files "emoji") #to (tackon #dest "emoji") #part "copy-emoji" #kb #kb-emoji #n 2
             #why (cat "Copying the colour emoji (Twemoji) to UP-Term:emoji,\n"
                       "for RTG screens."))
        (P_COPY)
    ))

(set #step "tools" #kb #kb-tools #n 3
     #why (cat "Installing UP-Term's own commands (UPTerm, UPDemo,\n"
               "upgetty, uptelnet, hl, mdv, ps, top, sz, rz) and\n"
               "the network tools you chose."))
(P_STEP)

(set #step "fonts" #kb @KBFONTS@ #n 2
     #why (cat "Adding the TopazPro and IBM fonts (only the sizes you do\n"
               "not have yet) and running FixFonts."))
(P_STEP)

(set #step "unix" #kb 60 #n 2
     #why (cat "Setting up /gg/bin/sh and /tmp for Unix programs:\n"
               "GG: and TMP: are assigned only when you have none."))
(P_STEP)

(set #step "desktop" #kb @KBDESKTOP@ #n (if #shellicon 3 2)
     #why (cat "Putting the UP-Term icon in SYS:System and UP-Term Prefs\n"
               "in SYS:Prefs"
               (if #shellicon ",\nand pointing the Shell icon at XCON:" "") "."))
(P_STEP)

(set #step "boot" #kb (+ @KBBOOT@ (if #wasabi @KBWASABI@ 0)) #n (+ 1 (if #serial 1 0) (if #wasabi 1 0))
     #why (cat "Writing vsh's settings"
               (if #serial ",\nthe serial login" "")
               (if #wasabi ",\nwasabid and its key" "") "."))
(P_STEP)

(set #step "libs" #kb @KBLIBS@ #n 3
     #why (cat "Installing the patched ixemul.library and its\n"
               "ixnet.library (the ones there are kept as\n"
               "LIBS:<name>.orig)."))
(P_STEP)

(set #step "mount" #kb @KBMOUNT@ #n 2
     #why (cat "Mounting XCON:, PTY: and IXPIPE:, so they work now,\n"
               "without a reboot."))
(P_STEP)

(set #step "console" #kb @KBCONSOLE@ #n (+ 1 (if (= #con "CONSOLE") 1 0) (if (= #dev "DEVICE") 1 0))
     #why (cat "Installing C:UPConsole"
               (if (= #con "CONSOLE") ",\nserving CON: and RAW:" "")
               (if (= #dev "DEVICE") ",\nserving console.device" "") "."))
(P_STEP)

(complete 100)

(set #step "record" #kb 20 #n 2
     #why (cat "Writing down this kit's list of files and your\n"
               "choices, for a later Update."))
(P_STEP)

; ---- an Update ends here -----------------------------------------------------
(if #update
    (
        (P_OPTIONS_END)
        (run "Delete >NIL: T:UPTUPD-#? ENV:UPTUPD#? QUIET")
        (set #n 5)
        ; an Update over the single kit (before the split): the files of the
        ; add-on archives upupdate left alone (ENV:UPTHANDED, the kit paths)
        (set #handed (getenv "UPTHANDED"))
        (set #stays "")
        (if (patmatch "#?Files/nvim#?" #handed) (set #stays (cat #stays ", Neovim")))
        (if (patmatch "#?Files/python3#?" #handed) (set #stays (cat #stays ", Python")))
        (if (patmatch "#?Files/Claude#?" #handed) (set #stays (cat #stays ", Claude")))
        (if (patmatch "#?Files/amiga-pi#?" #handed) (set #stays (cat #stays ", amiga-pi")))
        (if (<> #stays "") (set #n 9))
        (P_LEAD)
        (set #updated (cat #lead "UP-Term is updated:\n" (getenv "UPTVEROLD") "\nto\n"
                        (getenv "UPTVERNEW") "\n\n"
                        (if (<> #stays "")
                            (cat "Stays installed: " (substr #stays 2 (strlen #stays)) ".\n"
                                 "They are archives of their own now: install\n"
                                 "UP-Term-nvim, Python3, Claude or amiga-pi to update.")
                            "Nothing else changed.")))
        (run "Delete >NIL: ENV:UPTHANDED QUIET")
        (run "Delete >NIL: ENV:UPTVER#? QUIET")
        (exit #updated)))

; ---- what went where ------------------------------------------------------------

(set #assigns (cat "UP-Term: = " #dest))
; Install writes these markers only when it made the assign (Uninstall reads them)
(if (exists "ENVARC:up-term/gg") (set #assigns (cat #assigns ", GG:")))
(if (exists "ENVARC:up-term/tmp") (set #assigns (cat #assigns ", TMP:")))
(set #blocks "UP-Term assign")
(if (exists "ENVARC:up-term/gg") (set #blocks (cat #blocks ", GG:")))
(if (exists "ENVARC:up-term/tmp") (set #blocks (cat #blocks ", TMP:")))
(if #serial (set #blocks (cat #blocks ", serial login")))
(if #wasabi (set #blocks (cat #blocks ", wasabid")))
(if (= #con "CONSOLE") (set #blocks (cat #blocks ", CON:")))
(if (= #dev "DEVICE") (set #blocks (cat #blocks ", console.device")))

; what went where: 10 lines, one more for the extras, and each of the
; Assigns and Startup blocks lines that does not fit one line (> 56
; characters, TEXT LAYOUT): at most 13
(set #xl (cat (if #unifont ", Unifont" "") (if #emoji ", emoji" "")))
(set #assignline (cat "Assigns: " #assigns))
(set #blockline (cat "Startup blocks: " #blocks))
(set #n (+ 10 (if (<> #xl "") 1 0)
           (if (> (strlen #assignline) 56) 1 0) (if (> (strlen #blockline) 56) 1 0)))
(P_LEAD)

(message
    (cat #lead "UP-Term is installed. What went where:\n"
         "UP-Term: Unix commands, man pages, network tools, sz, rz"
         (if (<> #xl "") (cat ",\n" (substr #xl 2 (strlen #xl))) "") "\n"
         "C: vsh, tmux, screen, UPConsole, UPTerm, UPDemo,\n"
         "   uptelnet\n"
         "L: and DEVS:DOSDrivers: XCON:, PTY:, IXPIPE:\n"
         "LIBS: ixemul.library, ixnet.library (old ones: .orig)\n"
         "SYS:System/UP-Term, SYS:Prefs/UP-Term-Prefs\n"
         "ENVARC:up-term: settings, terminal entries, themes\n"
         #assignline "\n"
         #blockline)
    (all))

; the parts are done: the options and the UPTKIT: assign go
(P_OPTIONS_END)

; the last page: 9 lines, 14 with the wasabi key
(set #n (if (= #wasabi "WASABI") 14 9))
(P_LEAD)
(set #done
    (cat #lead "Open UP-Term: double-click SYS:System/UP-Term, or type\n"
         "  NewShell XCON:0/20/640/300/UP-Term/CLOSE\n"
         "and in it  vsh  for the Unix-style shell.\n\n"
         "Preferences and themes: SYS:Prefs/UP-Term-Prefs, or the\n"
         "UP-Term menu of any UP-Term window.\n\n"
         "A reboot mounts XCON:, PTY: and IXPIPE: at every start.\n"
         "Uninstall (beside Install) takes UP-Term out again."))
(if (= #wasabi "WASABI")
    (set #done
        (cat #done "\n"
             "wasabi is running. On the other computer, with Python 3:\n"
             "  copy Files/wasabi/wasabi from this kit, then\n"
             "  export WASABI_KEY=" (getenv "wasabi.key") "\n"
             "  ./wasabi discover\n"
             "The key is in ENVARC:wasabi.key; keep it to yourself.")))
(exit #done)
