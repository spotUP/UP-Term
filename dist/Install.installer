; UP-Term -- Installer script (Commodore Installer 43, AmigaOS 3.0 and up).
; Double-click the Install icon. The script asks the questions; the copying
; is done by Files/install.dos (the tested AmigaDOS install, also usable
; from a Shell without Installer). Remove it again with Uninstall.

(set @app-name "UP-Term")
(set #files (tackon (pathonly @icon) "Files"))

; ---- requirements ---------------------------------------------------------

(if (< (/ (getversion "exec.library" (resident)) 65536) 39)
    (abort "UP-Term needs AmigaOS 3.0 or newer."))
(if (or (= (database "cpu") "68000") (= (database "cpu") "68010"))
    (abort "UP-Term needs a 68020 or better (the terminal and its ixemul.library are 68020 code)."))
(if (not (exists (tackon #files "install.dos")))
    (abort "The Files drawer is missing: unpack the whole archive and start Install from its drawer."))

(set #v47 (>= (/ (getversion "dos.library" (resident)) 65536) 47))

; ---- what it is -----------------------------------------------------------

(message
    "UP-Term: a modern terminal for AmigaOS\n\n"
    "This installs:\n"
    "- XCON:, a console window with an xterm-class terminal inside\n"
    "- vsh, a Unix-style shell, and tmux, screen and ls\n"
    "- PTY:, Unix pseudo-terminals\n"
    "- UP-Term Prefs, with 112 colour themes\n"
    "- a patched ixemul.library and its ixnet.library (the ones\n"
    "  there are kept as LIBS:<name>.orig; Uninstall puts them back)\n\n"
    "Files go to C:, L:, LIBS:, DEVS:, ENVARC: and SYS:Utilities.")

; ---- what to install: one page of choices --------------------------------

(set #con "NOCONSOLE")
(set #dev "NODEVICE")
(set #shellicon "")
(set #sysicon "")
(set #serial "")
(set #ssh "")
(set #bget "")
(set #curl "")
(set #wasabi "")
(set #python "")
(set #nvim "")
(set #unifont "")
(set #emoji "")
(set #cpu060 (if (= (database "cpu") "68060") "CPU060" ""))
(set #cpu040 (if (= (database "cpu") "68040") "CPU040" ""))
; curl is ticked when AmiSSL is there (curl cannot run without it)
(set #amissl (exists "LIBS:amisslmaster.library"))

(set #opts
    (askoptions
        (prompt "UP-Term itself is always installed. Choose the optional parts:")
        (help "ssh and scp: BebboSSH 1.45 by Stefan Franke (GPL v3+), an SSH client "
              "for remote Unix machines, with scp, a key generator and a simple "
              "server; libcryptossh.library goes to LIBS: unless one is there.\n\n"
              "bebboget: https downloads (GPL v3+), by the same author.\n\n"
              "curl 8.22.0: downloads and transfers (the curl licence); needs "
              "AmiSSL 5 (Aminet util/libs/AmiSSL-v5-OS3.lha).\n\n"
              "The network tools need a TCP/IP stack (Roadshow, AmiTCP) and go to "
              "SYS:UP-Term/bin; their licences and sources are in the kit's "
              "Files/net drawer.\n\n"
              "Serial login: C:upgetty LOOP runs at every boot from a block in "
              "S:User-Startup, and a terminal program on a null-modem cable at 19200 "
              "baud gets vsh. While it runs no other program can use the serial port.\n\n"
              "wasabi (remote development, MIT, by Tobias Karlsson): wasabid in C:, "
              "started at every boot, so a Mac or Linux machine on your network can "
              "copy files to this Amiga, run commands on it, grab its screen and read "
              "its debug output. It runs ANY command a client with its key sends: "
              "Install makes a key (or keeps yours, ENVARC:wasabi.key) and shows it at "
              "the end. Leave it off unless you develop on this Amiga from another "
              "machine. The client for the other machine is in the kit's Files/wasabi.\n\n"
              "Unifont: GNU Unifont's glyphs (SIL Open Font License 1.1), 1.8 MB in "
              "SYS:UP-Term/unifont. UP-Term draws every character up to U+FFFF your "
              "font lacks from them (Cyrillic, Greek, CJK, symbols), and the emoji, "
              "two cells wide, when the font is 8 or 16 pixels high; without them "
              "such characters show as '?' and emoji as a box.\n\n"
              "Colour emoji: Twemoji (CC-BY 4.0, Twitter and contributors), 0.5 MB in "
              "SYS:UP-Term/emoji. On an RTG screen of 15 bits or more with "
              "Picasso96 or CyberGraphX, emoji are drawn in colour over their two "
              "cells; on other screens Unifont's one-colour glyph is drawn.\n\n"
              "The UP-Term icon is in SYS:Utilities either way; a second copy can go "
              "beside Shell in SYS:System.\n\n"
              "The Shell icon: its WINDOW tooltype is changed to XCON:, so SYS:System/Shell "
              "opens an UP-Term window; a copy of the icon is kept in "
              "ENVARC:up-term-orig.\n\n"
              "Python 3.14 (15 MB) and Neovim 0.12 (32 MB) go to SYS:UP-Term; "
              "python3 and nvim then run from an UP-Term window.\n\n"
              "Always installed: C:Claude and C:ClaudeCode (Claude Code on your "
              "server, see README.txt, CLAUDE FROM THE AMIGA).\n\n"
              "Uninstall takes every one of them out again.")
        (choices "ssh and scp (BebboSSH)"
                 "bebboget (https downloads)"
                 (if #amissl "curl (AmiSSL 5 found)" "curl (needs AmiSSL 5, not found)")
                 "Serial login at every boot"
                 "wasabi: remote development from another computer"
                 "UP-Term icon also in SYS:System"
                 "Shell icon opens an UP-Term window"
                 "Python 3.14 (15 MB)"
                 "Unifont: glyphs for every character and emoji (1.8 MB)"
                 "Colour emoji for RTG screens (Twemoji, 0.5 MB)"
                 "Neovim 0.12 (32 MB)")
        (default (+ 1 2 (if #amissl 4 0) 128 256 512 1024))))
(if (in #opts 0) (set #ssh "SSH"))
(if (in #opts 1) (set #bget "BEBBOGET"))
(if (in #opts 2) (set #curl "CURL"))
(if (in #opts 3) (set #serial "SERIAL"))
(if (in #opts 4) (set #wasabi "WASABI"))
(if (in #opts 5) (set #sysicon "SYSICON"))
(if (and (in #opts 6) (exists "SYS:System/Shell.info")) (set #shellicon "SHELLICON"))
(if (in #opts 7) (set #python "PYTHON"))
(if (in #opts 10) (set #nvim "NVIM"))
(if (in #opts 8) (set #unifont "UNIFONT"))
(if (in #opts 9) (set #emoji "EMOJI"))

; ---- taking over the system's console: a page of its own -----------------

(if #v47
    (message
        "AmigaOS 3.2 found.\n\n"
        "UP-Term installs normally, but it does not take over CON: or "
        "console.device on 3.2 yet: the 3.2 Shell needs a console mode "
        "UP-Term does not have yet.")
    (
        (set #sys
            (askoptions
                (prompt "UP-Term can also take over the system's console. "
                        "Leave both off to keep the system's own.")
                (help "CON: and RAW:: every new Shell window is an UP-Term window "
                      "(the Amiga look, with UP-Term's line editing, history and Tab "
                      "completion); C:UPConsole CON OFF switches back. Refused when "
                      "another console replacement (KingCON, ViNCEd...) serves CON:.\n\n"
                      "console.device: every program's console window (Ed, More, the "
                      "system's Shell windows) draws with UP-Term's engine; C:UPConsole "
                      "DEVICE OFF switches back. Refused when console.device was patched "
                      "by another program.\n\n"
                      "Each is switched on at every boot by a block in S:User-Startup, "
                      "which Uninstall takes out.")
                (choices "UP-Term serves CON: and RAW:"
                         "console.device is UP-Term's")
                (default 0)))
        (if (in #sys 0) (set #con "CONSOLE"))
        (if (in #sys 1) (set #dev "DEVICE"))
    )
)

; ---- install --------------------------------------------------------------

(working "Installing UP-Term...")
(execute (tackon #files "install.dos") (cat "\"" #files "\"") #con #dev #shellicon #sysicon #serial #ssh #bget #curl #wasabi #python #nvim #cpu040 #cpu060 #unifont #emoji)

(set #done
    (cat "UP-Term is installed.\n\n"
         "Open it: double-click SYS:Utilities/UP-Term, or type\n"
         "  NewShell XCON:0/20/640/300/UP-Term/CLOSE\n\n"
         "Preferences and themes: SYS:Utilities/UP-Term-Prefs, or the\n"
         "UP-Term menu of any UP-Term window.\n\n"
         "A reboot mounts XCON:, PTY: and IXPIPE: at every start."))
(if (= #wasabi "WASABI")
    (set #done
        (cat #done "\n\n"
             "wasabi is running. On the other computer, with Python 3:\n"
             "  copy Files/wasabi/wasabi from this kit, then\n"
             "  WASABI_KEY=" (getenv "wasabi.key") " ./wasabi discover\n"
             "The key is in ENVARC:wasabi.key; keep it to yourself.")))
(exit #done)
