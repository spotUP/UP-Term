# upkg-ask QUESTIONS ANSWERS [NAME] -- ask an add-on's install questions (upkg plan P10.6).
#
# QUESTIONS has one question per line, fields split by "|":
#   key|type|prompt|default|choices
# type is string (a line of text), yesno (default "yes" or "no") or choice (one of
# the comma-separated choices). A default of "<PATH" is the last line of PATH that
# is not empty and not a ";" comment, else empty (the answer an earlier install kept). Empty lines and
# lines starting with "#" are skipped.
#
# ANSWERS is written as shell assignments, KEY='value', for postinst to source.
#
# NAME is the add-on's name: the full-screen masthead shows it as "NAME i/n" (question
# index and count; empty lines and "#" lines are not counted).
#
# upkg-ui (our own curses program, upterm-ports pkgs/upkg-ui, dialog-compatible subset)
# asks when it is on the PATH and stdin and stdout are a terminal; with no upkg-ui the questions are
# plain prompts read from stdin; with no terminal (or output into a pipe) every question takes
# its default.
# UPKG_ASK_PLAIN=1 forces the plain prompts.
#
# UPKG_ASK_STATE (set by upkg for a postinst: info_dir/NAME.answered) is the file of question ids this package's
# installs answered, as KEY='value' lines. A question whose key is in it is not asked again: the earlier answer is
# kept silently (so an upgrade asks only the questions the older version never asked). Every question asked on
# a terminal is added to it. A default taken without asking is not recorded.
# UPKG_ASK_UNATTENDED=1 (upkg: Install All, a progress box) says the missing terminal is on purpose: a question not
# recorded takes its default. Without it and without a terminal the default is taken too, with a note on stderr.

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
    echo "usage: upkg-ask QUESTIONS ANSWERS [NAME]" >&2
    exit 2
fi
questions=$1
answers=$2
name=$3
if [ ! -r "$questions" ]; then
    echo "upkg-ask: cannot read $questions" >&2
    exit 2
fi

# the screen's masthead: title fixed, value = NAME i/n (set per question)
ask_ui() {
    upkg-ui --title "UP-TERM ADD-ON" --backtitle "${name:+$name }$index/$total" "$@"
}

state=${UPKG_ASK_STATE:-}
# recorded KEY: the question was answered by an earlier install of this package
recorded() {
    [ -n "$state" ] && [ -r "$state" ] && grep -q "^$1='" "$state"
}
recorded_value() {
    ( . "$state" >/dev/null 2>&1; eval "printf '%s' \"\${$1}\"" )
}

mode=plain
# upkg-ui and plain prompts both need the terminal on stdout too: run inside "upkg browse"'s
# programbox, stdout is its pipe and a question would only show as escape-code text there
if [ ! -t 0 ] || [ ! -t 1 ]; then
    mode=defaults
    [ -n "$UPKG_ASK_UNATTENDED" ] || echo "upkg-ask: no terminal, the questions not answered before take their defaults" >&2
elif [ -z "$UPKG_ASK_PLAIN" ] && command -v upkg-ui >/dev/null 2>&1; then
    mode=ui
fi
tmp="$answers.tmp"

# the questions to ask, for the "i/n" of the masthead
total=0
while IFS='|' read -r key rest; do
    case $key in "" | "#"*) ;; *) recorded "$key" || total=$((total + 1)) ;; esac
done < "$questions"
index=0

# the value of a default field: a literal, or "<PATH" for PATH's last line that is
# not empty and not a ";" comment (ENVARC:Claude/remote starts with two comments)
default_of() {
    case $1 in
    "<"*)
        last=
        if [ -r "${1#<}" ]; then
            while IFS= read -r line; do
                case $line in "" | ";"*) ;; *) last=$line ;; esac
            done < "${1#<}"
        fi
        printf '%s' "$last" ;;
    *) printf '%s' "$1" ;;
    esac
}

# KEY='value' with each ' written as '\''
quote() {
    printf "%s='" "$1"
    printf '%s' "$2" | sed "s/'/'\\\\''/g"
    printf "'\n"
}

: > "$answers" || exit 1
# the loop reads QUESTIONS on fd 0, so the keyboard is kept on fd 3
exec 3<&0
while IFS='|' read -r key type prompt def choices; do
    case $key in "" | "#"*) continue ;; esac
    if recorded "$key"; then
        quote "$key" "$(recorded_value "$key")" >> "$answers"
        continue
    fi
    index=$((index + 1))
    def=$(default_of "$def")
    ans=$def
    case $mode.$type in
    ui.string)
        if ask_ui --inputbox "$prompt" 0 0 "$def" 2> "$tmp" <&3; then
            ans=$(cat "$tmp")
        fi ;;
    ui.yesno)
        if [ "$def" = no ]; then
            set -- --defaultno
        else
            set --
        fi
        ask_ui "$@" --yesno "$prompt" 0 0 <&3
        case $? in 0) ans=yes ;; 1) ans=no ;; esac ;;
    ui.choice)
        set --
        oldifs=$IFS
        IFS=,
        for c in $choices; do set -- "$@" "$c" ""; done
        IFS=$oldifs
        if ask_ui --no-items --default-item "$def" --menu "$prompt" 0 0 0 "$@" 2> "$tmp" <&3; then
            ans=$(cat "$tmp")
        fi ;;
    plain.string)
        printf '%s [%s]: ' "$prompt" "$def"
        IFS= read -r line <&3 && [ -n "$line" ] && ans=$line ;;
    plain.yesno)
        printf '%s (yes/no) [%s]: ' "$prompt" "$def"
        IFS= read -r line <&3
        case $line in [yY]*) ans=yes ;; [nN]*) ans=no ;; esac ;;
    plain.choice)
        printf '%s (%s) [%s]: ' "$prompt" "$choices" "$def"
        IFS= read -r line <&3
        case ,$choices, in *,"$line",*) [ -n "$line" ] && ans=$line ;; esac ;;
    esac
    quote "$key" "$ans" >> "$answers"
    [ $mode = defaults ] || { [ -z "$state" ] || quote "$key" "$ans" >> "$state"; }
done < "$questions"
rm -f "$tmp"
# upkg-ui keeps its last screen on the normal screen (no Shell between two questions): clear the last
# question before the install goes on
[ $mode = ui ] && clear
exit 0
