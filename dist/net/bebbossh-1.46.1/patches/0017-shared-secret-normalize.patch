From 8c701618c0308bf51ad38e29b3e75b97c9f1bb95 Mon Sep 17 00:00:00 2001
From: b <b@l>
Date: Sun, 4 Oct 2026 10:18:53 +0200
Subject: [PATCH] merge upstream 1.46 fix: normalize the X25519 shared secret

Upstream 1.46 (commit 4c0b772) canonicalizes the shared secret K as an
RFC 4251 mpint. The 1.45 inline code (client.cpp handleKexEcdhReply and
sshsession.cpp createKexEcdhReply) only prepended the sign byte when the
top bit was set and never stripped leading zero bytes, so a K beginning
with 0x00 (~1/256 per connection) was hashed non-canonically -> the
exchange hash differed from OpenSSH -> intermittent "incorrect signature"
/ "failed to verify host" KEX failures. (Matches a 1-in-~400 verify
failure seen during V4SA testing.)

Brought in as our own patch instead of rebasing the 16-patch stack onto
1.46 (0012 touches the same client.cpp block). Difference from upstream:
we set sharedSecret.size = 32 at both call sites before the call.
Upstream's own 1.46 omits this, so its normalizeSharedSecret reads an
uninitialised/stale s->size (the static SharedSecret starts at 0) -- a
latent bug there; our call sites feed the correct raw length.

Also bumps revision.h to 1.46 and exports normalizeSharedSecret from
libcryptossh. The 1.46 intptr_t change is a no-op on m68k (int32_t ==
intptr_t) and is omitted; so are the Linux-only Makefile and test tweaks.
---
 include/revision.h   |  2 +-
 include/ssh.h        |  5 +++++
 src/client.cpp       |  9 ++-------
 src/libcryptossh.def |  1 +
 src/ssh.cpp          | 35 +++++++++++++++++++++++++++++++++++
 src/sshsession.cpp   |  9 ++-------
 6 files changed, 46 insertions(+), 15 deletions(-)

diff --git a/include/revision.h b/include/revision.h
index 484663e..2e37b73 100644
--- a/include/revision.h
+++ b/include/revision.h
@@ -1,7 +1,7 @@
 #ifndef __REVISION_H__
 #define __REVISION_H__
 #define __VERSION_MAJOR "1"
-#define __VERSION_MINOR "45"
+#define __VERSION_MINOR "46"
 #define __V__ __VERSION_MAJOR "." __VERSION_MINOR
 
 
diff --git a/include/ssh.h b/include/ssh.h
index aa6910a..ea2eb38 100644
--- a/include/ssh.h
+++ b/include/ssh.h
@@ -140,6 +140,11 @@ struct SharedSecret {
 	uint8_t data[33];
 };
 
+/* Canonicalize the X25519 shared secret K as an RFC 4251 mpint
+ * (strip leading zero bytes, then prepend a 0x00 if the top bit is set).
+ * Call with size preset to the raw X25519 length (32). */
+void normalizeSharedSecret(SharedSecret *sharedSecret);
+
 struct KeyMaterial {
 	uint8_t encIvWrite[12];
 	uint8_t encIvRead[12];
diff --git a/src/client.cpp b/src/client.cpp
index 7d6db75..92ed88b 100644
--- a/src/client.cpp
+++ b/src/client.cpp
@@ -698,13 +698,8 @@ static bool handleKexEcdhReply(SHA256 &handshakeMD, unsigned long packetSize) {
 		}
 	}
 	p += length;
-	if ((int8_t)sharedSecret.data[0] < 0) {
-		sharedSecret.size = 33;
-		memmove(&sharedSecret.data[1], &sharedSecret.data[0], 32);
-		sharedSecret.data[0] = 0;
-	} else {
-		sharedSecret.size = 32;
-	}
+	sharedSecret.size = 32;
+	normalizeSharedSecret(&sharedSecret);
 
 #if (BYTE_ORDER == BIG_ENDIAN)
 	handshakeMD.update(&sharedSecret, sharedSecret.size + 4);
diff --git a/src/libcryptossh.def b/src/libcryptossh.def
index b80ff34..943e1ec 100644
--- a/src/libcryptossh.def
+++ b/src/libcryptossh.def
@@ -5,6 +5,7 @@
 .direct __Z9putStringRPhPKc
 
 .text __Z11fillKexInitPhPKc
+.text __Z21normalizeSharedSecretP12SharedSecret
 
 .text __ZN21ChaCha20Poly1305_SSH26setKeyEPKvj
 .direct __ZN21ChaCha20Poly1305_SSH24initEPKvi
diff --git a/src/ssh.cpp b/src/ssh.cpp
index a7d0d0b..efc80cb 100644
--- a/src/ssh.cpp
+++ b/src/ssh.cpp
@@ -118,6 +118,41 @@ static void mkKey(uint8_t * buffer, SHA256 &sha256, SharedSecret * sharedSecret,
 	sha256.digest(buffer + 32);
 //	_dump("key", buffer, 64);
 }
+
+/*
+ * Canonicalize the X25519 shared secret K as an SSH mpint (RFC 4251):
+ * strip leading zero bytes, then prepend a single 0x00 if the most
+ * significant byte has its top bit set. s->size must hold the raw length
+ * (32) on entry. The previous inline code only added the sign byte and
+ * never stripped leading zeros, so a K beginning with 0x00 (~1/256 per
+ * connection) was encoded non-canonically -> the exchange hash differed
+ * from RFC-compliant peers (OpenSSH) -> intermittent "incorrect signature"
+ * KEX failures. (Upstream 1.46 fix; our call sites set size=32 first,
+ * which upstream's own 1.46 omits.)
+ */
+void normalizeSharedSecret(SharedSecret *s) {
+	uint8_t *d = s->data;
+	unsigned size = s->size;
+
+	unsigned off = 0;
+	while (off < size && d[off] == 0)
+		off++;
+
+	unsigned len = size - off;
+	unsigned dst = 0;
+
+	if (len != 0) {
+		if (d[off] & 0x80)
+			dst = 1;
+		if (off != dst)
+			memmove(d + dst, d + off, len);
+		if (dst)
+			d[0] = 0;
+	}
+
+	s->size = len + dst;
+}
+
 /**
  * Create the 4 keys, enough for GCM
  */
diff --git a/src/sshsession.cpp b/src/sshsession.cpp
index b5aa5db..804ec45 100644
--- a/src/sshsession.cpp
+++ b/src/sshsession.cpp
@@ -1472,13 +1472,8 @@ void SshSession::createKexEcdhReply() {
 	HSU(serverPK_aka_F, 0, 32);
 
 	fe_scalarmult_x25519(sharedSecret_aka_K.data, serverSK, clientPK_aka_E);
-	if ((int8_t) sharedSecret_aka_K.data[0] < 0) {
-		sharedSecret_aka_K.size = 33;
-		memmove(&sharedSecret_aka_K.data[1], &sharedSecret_aka_K.data[0], 32);
-		sharedSecret_aka_K.data[0] = 0;
-	} else {
-		sharedSecret_aka_K.size = 32;
-	}
+	sharedSecret_aka_K.size = 32;
+	normalizeSharedSecret(&sharedSecret_aka_K);
 #ifdef __AMIGA__
 	handshakeMD.update(&sharedSecret_aka_K, sharedSecret_aka_K.size + 4);
 	HSU(&sharedSecret_aka_K, 0, sharedSecret_aka_K.size + 4);
