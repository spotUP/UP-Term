@@ -126,6 +125,26 @@ static void collect(SHA512 &sha, int rounds) {
 	wipe(&s, sizeof(s));
 }
 
+// the seed lives next to the keys (ENVARC:ssh, see home.cpp)
+static char seedFile[64], seedTmp[64];
+
+static void setSeedNames() {
+	char const *dir = getSshDotDir();
+	if (strlen(dir) > sizeof(seedFile) - 17)
+		dir = "ENVARC:ssh";
+	strcpy(seedFile, dir);
+	strcat(seedFile, "/random_seed");
+	strcpy(seedTmp, seedFile);
+	strcat(seedTmp, ".tmp");
+
+	// create the directory if there is none yet
+	BPTR l = Lock((STRPTR) dir, ACCESS_READ);
+	if (!l)
+		l = CreateDir((STRPTR) dir);
+	if (l)
+		UnLock(l);
+}
+
 static void writeSeed() {
 	uint8_t seed[64];
 	SHA512 sha;
@@ -133,15 +152,15 @@ static void writeSeed() {
 	sha.update("seed", 4);
 	sha.digest(seed);
 
-	BPTR fh = Open((STRPTR) SEED_TMP, MODE_NEWFILE);
+	BPTR fh = Open((STRPTR) seedTmp, MODE_NEWFILE);
 	if (fh) {
 		LONG w = Write(fh, seed, 64);
 		Close(fh);
 		if (w == 64) {
-			DeleteFile((STRPTR) SEED_FILE);
-			Rename((STRPTR) SEED_TMP, (STRPTR) SEED_FILE);
+			DeleteFile((STRPTR) seedFile);
+			Rename((STRPTR) seedTmp, (STRPTR) seedFile);
 		} else
-			DeleteFile((STRPTR) SEED_TMP);
+			DeleteFile((STRPTR) seedTmp);
 	}
 	wipe(seed, 64);
 }
@@ -151,8 +170,10 @@ static void seedPool() {
 	sha.update(pool, 64);
 	sha.update("init", 4);
 
+	setSeedNames();
+
 	uint8_t seed[64];
-	BPTR fh = Open((STRPTR) SEED_FILE, MODE_OLDFILE);
+	BPTR fh = Open((STRPTR) seedFile, MODE_OLDFILE);
 	if (fh) {
 		LONG r = Read(fh, seed, 64);
 		Close(fh);
