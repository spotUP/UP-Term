diff --git a/src/home.cpp b/src/home.cpp
index 70dffec..604a1b7 100644
--- a/src/home.cpp
+++ b/src/home.cpp
@@ -1,7 +1,28 @@
 #ifdef __AMIGA__
-char const * sshDir = "envarc:";
-char const * sshDotDir = "envarc:.ssh";
+#include <proto/dos.h>
+
+char const * sshDir = "ENVARC:";
+char const * sshDotDir = "ENVARC:ssh";
 char const * keyFile;
+
+/* The directory for keys, known_hosts and ssh_config. "ENVARC:ssh" like
+ * other Amiga programs (bebbosshd uses it too); versions up to 1.45 used
+ * the Unix-like "envarc:.ssh", which is still used if only it exists. */
+char const * getSshDotDir() {
+	static char const * dir;
+	if (!dir) {
+		dir = "ENVARC:ssh";
+		BPTR l = Lock((STRPTR) "ENVARC:ssh", ACCESS_READ);
+		if (l)
+			UnLock(l);
+		else if ((l = Lock((STRPTR) "ENVARC:.ssh", ACCESS_READ))) {
+			UnLock(l);
+			dir = "ENVARC:.ssh";
+		}
+		sshDotDir = dir;
+	}
+	return dir;
+}
 #else
 #include "amiemul.h"
 
@@ -47,4 +68,8 @@ static struct __ {
     }
 } __;
 
+char const * getSshDotDir() {
+	return sshDotDir;
+}
+
 #endif
