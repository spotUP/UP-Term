+// ---- bounded parsing of a received packet -------------------------------
+// Everything a client sends is length-prefixed and untrusted. g_pktEnd is
+// one past the current packet; bstr()/bu32() never read or advance past it
+// and set g_parseBad on any overrun. The dispatcher drops the session when
+// g_parseBad is set. One packet is parsed at a time, so file scope is safe.
+static uint8_t *g_pktEnd;
+static bool g_parseBad;
+
+static uint8_t *bstr(uint8_t *&p) {
+	if (g_parseBad || p + 4 > g_pktEnd) { g_parseBad = true; return g_pktEnd; }
+	uint32_t l = getInt32(p);
+	p += 4;
+	if (l > (uint32_t)(g_pktEnd - p)) { g_parseBad = true; return g_pktEnd; }
+	uint8_t *r = p;
+	p += l;
+	return r;
+}
+
+static uint32_t bu32(uint8_t *&p) {
+	if (g_parseBad || p + 4 > g_pktEnd) { g_parseBad = true; return 0; }
+	uint32_t v = getInt32(p);
+	p += 4;
+	return v;
+}
+
+// constant-time compare so a forged AEAD tag leaks nothing via timing
+static int ctcmp(uint8_t const *a, uint8_t const *b, unsigned n) {
+	uint8_t r = 0;
+	for (unsigned i = 0; i < n; ++i)
+		r |= a[i] ^ b[i];
+	return r;
+}
