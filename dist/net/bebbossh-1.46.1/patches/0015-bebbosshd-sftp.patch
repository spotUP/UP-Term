-	}
-
-	if (timerPort) {
-		logme(L_FINE, "free timer message port");
-		DeleteMsgPort(timerPort);
-	}
-
-	if (port) {
-		logme(L_FINE, "free default message port");
-		DeleteMsgPort(port);
-	}
-
-	if (orgDir)
-		CurrentDir(orgDir);
-	if (curDir)
-		UnLock(curDir);
-#endif
-}
