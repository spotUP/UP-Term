-
-int cancelRunning() {
-	int running = 0;
-	ObtainSemaphore(&theLock);
-	int sz = clients.getMax();
-	for (int i = 0; i < sz; ++i) {
-		SshSession * cs = clients[i];
-		if (!cs)
-			continue;
-
-		if (cs->isAlive()) {
-			cs->sendBreak();
-			++running;
-		} else {
-			cs->close();
-		}
-	}
-	ReleaseSemaphore(&theLock);
-	if (running)
-		logme(L_WARN, "%ld clients are still busy", running);
-	return running;
-}
