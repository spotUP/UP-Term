+char const* getBSTR(BPTR bp) {
+	static char nameBuffer[256];
+	char const *bstr = (char const*) BADDR(bp);
+	int sz = (unsigned char)*bstr++;
+	strncpy(nameBuffer, bstr, sz);
+	nameBuffer[sz] = 0;
+	return nameBuffer;
+}
