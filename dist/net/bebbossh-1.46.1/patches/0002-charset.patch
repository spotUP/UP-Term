+	// so keep the server's own (UTF-8) locale; scripts get LANG=C as before
+	if (!charsetConv && !sendEncrypted(ENV_LANG_C, sizeof(ENV_LANG_C)))
 		return false;
 #endif
 
@@ -505,6 +702,36 @@ void handleKeyboard() {
 		}
 	}
 #endif
+#ifdef __AMIGA__
+	if (charsetConv && CodesetsBase && p > c) {
+		// typed characters (system codeset) -> UTF-8
+		bool high = false;
+		for (uint8_t *q = c; q < p; ++q)
+			high |= *q >= 0x80;
+		if (high) {
+			uint8_t tmp[512];
+			ULONG l = 0;
+			if (p - c < 200 && CodesetsUTF8Create(CSA_Source, (Tag) c, CSA_SourceLen, (ULONG) (p - c),
+					CSA_Dest, (Tag) tmp, CSA_DestLen, sizeof(tmp), CSA_DestLenPtr, (Tag) &l, TAG_DONE)) {
+				memcpy(c, tmp, l);
+				p = c + l;
+			}
+		}
+	} else
+#endif
+	if (charsetConv) {
+		// typed ISO-8859-1 characters -> UTF-8
+		for (uint8_t *q = c; q < p; ++q) {
+			if (*q >= 0xA0) {
+				uint8_t ch = *q;
+				memmove(q + 2, q + 1, p - q - 1);
+				*q++ = 0xC0 | (ch >> 6);
+				*q = 0x80 | (ch & 0x3F);
+				++p;
+			}
+		}
+	}
+
 	unsigned len = p - c;
 	if (len) {
 		uint8_t *p = b5;
