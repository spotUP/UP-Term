+		consoleWrite(c, length);
 	}
 	return 0;
 }
@@ -241,7 +430,15 @@ bool ConsoleChannel::start() {
 	remoteChannelNo = 0;
 
 #ifdef __AMIGA__
-	if (!sendEncrypted(ENV_LANG_C, sizeof(ENV_LANG_C)))
+#ifdef __AMIGA__
