Lab check
; what this archive needs, before anything is copied; the reason goes to
; ENV:UPTCHECK, which the Installer's abort page shows (an archive that needs the base).
Delete >NIL: ENV:UPTCHECK QUIET
Assign >NIL: UP-Term: EXISTS
If WARN
  Echo >ENV:UPTCHECK "@ARCHIVE@ needs UP-Term @NEEDSBASE@ or newer. Install up-term.lha first."
  Quit 20
EndIf
Version >NIL: FILE UP-Term:UP-Term.version @BASEMAJOR@ @BASEMINOR@
If WARN
  Echo >ENV:UPTCHECK "@ARCHIVE@ needs UP-Term @NEEDSBASE@ or newer. Update UP-Term first."
  Quit 20
EndIf
; a record the old Installer left under the former name (dist/package-renames.txt)
@RENAMERECORD@
If NOT "@IXEMUL@" EQ "-"
  Version >NIL: LIBS:ixemul.library @IXEMUL@
  If WARN
    Echo >ENV:UPTCHECK "@ARCHIVE@ needs UP-Term's ixemul.library @IXEMUL@ in LIBS:. Install UP-Term again."
    Quit 20
  EndIf
EndIf
If NOT "{STEP}" EQ ""
  Quit 0
EndIf
