; ---- an installed UP-Term: Update or Full install ---------------------------
; (plan 2026-10-08-installer-update) With UP-Term: assigned, its MANIFEST (the
; record part of the last install) and that install's options
; (ENVARC:up-term/opts) there, upupdate (Files/upupdate, no ixemul) compares
; the installed manifest with this kit's and writes what changed into ENV:
; (UPTUPD<part>: the KB of each part to run, UPTUPDKB, UPTVEROLD/NEW, UPTHANDED:
; the old kit's paths an add-on archive installs now) and
; T:UPTUPD-<part>, a copy part's script. Update then asks nothing: the
; options come back from the record, P_STEP and P_COPY run only the parts
; upupdate named, and the bar counts only their KB.

(set #update 0)
; the manifest of the last install: this package's record; an add-on archive
; (handed paths) with none of its own takes the single kit's, kept by the base's
; Install in UP-Term:pkg/legacy, cut to its own paths (upupdate ... ONLY=)
; a record under the package's former name (dist/package-renames.txt) is renamed before it is read
(if (or (= "@STANDALONE@" "YES") (<> (getassign "UP-Term" "a") ""))
  (
@RENAMERECORDI@
    (set #migrated 0)
  ))
(set #oldman "@RECORDP@MANIFEST")
(set #legacy 0)
; a stand-alone archive keeps its record in ENVARC: and needs no UP-Term: assign. Every
; other probe of a UP-Term: path waits for the assign: with none (a first install), an
; (exists "UP-Term:...") makes AmigaOS ask to insert a volume UP-Term before the welcome
(if (or (= "@STANDALONE@" "YES") (<> (getassign "UP-Term" "a") ""))
  (
    (if (and (not (exists #oldman)) (<> "@HANDED@" "-") (= "@LEGACY@" "YES")
             (exists "UP-Term:pkg/legacy/MANIFEST"))
        (set #oldman "UP-Term:pkg/legacy/MANIFEST" #legacy 1))
    (if (and (exists #oldman) (or #legacy (exists "@OPTS@/UPTOPTDEST"))
             (exists (tackon #files "upupdate")))
        (
            (run "Delete >NIL: ENV:UPTUPD#? ENV:UPTVER#? T:UPTUPD-#? QUIET")
            (run "Delete >NIL: ENV:UPTHANDED QUIET")
            (if (= 0 (run (cat "\"" (tackon #files "upupdate") "\" \"" #oldman "\" \""
                                (tackon #files "MANIFEST") "\" \"" (pathonly @icon) "\""
                                (if #legacy " ONLY=@HANDED@" ""))))
                (set #update
                    (= 0 (askchoice
                        (prompt (cat "@ARCHIVE@ is installed"
                                     (if #legacy " by the single kit" "") ":\n"
                                     (getenv "UPTVEROLD") "\n\n"
                                     "This kit holds:\n" (getenv "UPTVERNEW") "\n\n"
                                     "Update copies only what changed ("
                                     (getenv "UPTUPDKB") " KB)\n"
                                     "and keeps the drawer and the choices of\n"
                                     "the last install."))
                        (help "Update compares the list of files the last install "
                              "wrote (@RECORDP@MANIFEST) with this kit's and copies "
                              "only the files that changed, deletes the ones this "
                              "kit no longer has, and runs again only the parts of "
                              "the install whose files or script changed. The "
                              "drawer, the assigns, the blocks in S:User-Startup "
                              "and every choice of the last install stay as they "
                              "are.\n\n"
                              "Full install asks every question again and copies "
                              "everything.")
                        (choices "Update" "Full install")
                        (default 0)))))))))
