; ---- an install that kept no record of its options (the base only) -----------
; Update restores the options of the last install from ENVARC:up-term/opts,
; which record.dos writes only when the Installer ran it: an install from a
; Shell (install.dos) writes none, and an ENVARC: that is not kept over a
; reboot loses them. The 1.6 Install over such a 1.5 install offered no Update
; and said nothing (a Replay, 2026-10-21). With UP-Term: and its MANIFEST
; there and no recorded options, each option is read back from what
; install.dos leaves on the Amiga when it is on: its block in S:User-Startup,
; its files in UP-Term:, the Shell icon it kept. They go to T:UPTOLDOPTS as
; P_OPT writes them, and #oldopts tells the Update page and the option restore
; (Install.installer) to take them from there. The CPU builds are this CPU's,
; as a full install's pages tick them.
(procedure P_OLDOPT
    (if #on
        (textfile (dest (cat "T:UPTOLDOPTS/UPTOPT" #name)) (append #name))))
; #on: S:User-Startup holds the marked block #block (Search: 0 found, else 5 or 20)
(procedure P_OLDBLOCK
    (set #on (= 0 (run (cat "Search >NIL: S:User-Startup \";BEGIN UP-Term " #block "\"")))))
; Each probe of a UP-Term: path waits for the assign (update.installer says why).
(set #olddrawer (getassign "UP-Term" "a"))
(if (<> #olddrawer "")
  (if (and (exists #oldman) (not (exists "@OPTS@/UPTOPTDEST")))
    (
        (run "Delete >NIL: T:UPTOLDOPTS ALL QUIET")
        (makedir "T:UPTOLDOPTS")
        (textfile (dest "T:UPTOLDOPTS/UPTOPTDEST") (append #olddrawer))
        (set #block "console") (P_OLDBLOCK)
        (set #name (if #on "CONSOLE" "NOCONSOLE") #on 1) (P_OLDOPT)
        (set #block "device") (P_OLDBLOCK)
        (set #name (if #on "DEVICE" "NODEVICE") #on 1) (P_OLDOPT)
        (set #block "serial") (P_OLDBLOCK)
        (set #name "SERIAL") (P_OLDOPT)
        (set #block "wasabi") (P_OLDBLOCK)
        (set #name "WASABI") (P_OLDOPT)
        (set #name "SHELLICON" #on (exists "ENVARC:up-term-orig/Shell.info")) (P_OLDOPT)
        (set #name "SSH" #on (exists "UP-Term:bin/bebbossh")) (P_OLDOPT)
        (set #name "BEBBOGET" #on (exists "UP-Term:bin/bebboget")) (P_OLDOPT)
        (set #name "CURL" #on (exists "UP-Term:bin/curl")) (P_OLDOPT)
        (set #name "UNIFONT" #on (exists "UP-Term:unifont")) (P_OLDOPT)
        (set #name "EMOJI" #on (exists "UP-Term:emoji")) (P_OLDOPT)
        (set #name "CPU040" #on (= (database "cpu") "68040")) (P_OLDOPT)
        (set #name "CPU060" #on (= (database "cpu") "68060")) (P_OLDOPT)
        (set #oldopts 1))))
