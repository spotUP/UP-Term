; @ARCHIVE@ -- Installer script (Commodore Installer 43.3, AmigaOS 3.1, and the
; Installer 47 of AmigaOS 3.2). Double-click the Install icon. Needs up-term.lha
; installed first (its part check), unless it stands alone (packages.txt). What gets installed is Files/install.dos,
; part by part, as in the base's Install; remove it again with Uninstall.
; TEXT LAYOUT: see the base's Install (dist/Install.installer): no page line over
; 56 characters, leading newlines that centre the block of n lines.

(set @app-name "@ARCHIVE@")
(set #files (tackon (pathonly @icon) "Files"))
(set #script (tackon #files "install.dos"))
(set #remote "")

; @include dist/common/requirements.installer

; @include dist/common/update.installer

; @include dist/common/procs.installer

; the options of this install: DEST is where UP-Term: is (the record keeps the
; options only when there is one), REMOTE is Claude's server page
(procedure P_OPTIONS_LIST
    (set #name "DEST" #val #dest) (P_OPT)
    (set #name "REMOTE" #val #remote) (P_OPT))

; @include dist/common/check.installer
; where it installs: UP-Term: for what needs the base; a stand-alone archive says where
(set #dest (if (= "@STANDALONE@" "YES") "@DESTTEXT@" (getassign "UP-Term" "a")))
