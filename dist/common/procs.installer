; ---- install ------------------------------------------------------------------
; P_STEP runs one part of install.dos (#step), saying what it does (#why),
; and moves the bar by its size (#kb). Its command line is short whatever the
; kit's path and the answers are (AmigaDOS takes about 255 characters): the
; kit's Files drawer is the assign UPTKIT:, and the options are not on the
; line at all but in the files ENV:UPTOPT<keyword> that P_OPTIONS writes once
; before the first part (install.dos reads them) and P_OPTIONS_END removes. P_COPY copies one drawer of the kit
; (#from) into UP-Term's drawer (#to) the same way: copyfiles makes #to,
; takes the subdrawers along, and shows each file as it copies it.

; P_LEAD sets #lead, the newlines that centre a block of #n lines
(procedure P_LEAD
    (set #lead (substr "\n\n\n\n\n\n\n" 0 (/ (- 14 #n) 2))))

; P_OPT writes one option: the file ENV:UPTOPT<name> holding #val (nothing when
; the option is off). textfile, not a SetEnv line: no quoting of a path with
; spaces, and no command line to outgrow.
(procedure P_OPT
    (if (<> #val "")
        (textfile (dest (cat "ENV:UPTOPT" #name)) (append #val))))

; P_OPTIONS: the options of this install (the package's own P_OPTIONS_LIST
; writes them with P_OPT) and the assign UPTKIT: for the Files drawer
(procedure P_OPTIONS
    (run "Delete >NIL: ENV:UPTOPT#? QUIET")
    (makeassign "UPTKIT" #files)
    (P_OPTIONS_LIST))

(procedure P_OPTIONS_END
    (run "Delete >NIL: ENV:UPTOPT#? QUIET")
    (makeassign "UPTKIT"))

(procedure P_BAR
    (set #donekb (+ #donekb #kb))
    (complete (/ (* #donekb 100) #totalkb)))

; P_WANT: does part #part run? Always in a full install; in an Update only
; when upupdate named it (its KB become #kb), and the record part always.
(procedure P_WANT
    (set #want 1)
    (if #update
        (
            (set #kb (getenv (cat "UPTUPD" #part)))
            (if (= #part "record") (set #kb 1))
            (if (= #kb "") (set #want 0)))))

(procedure P_STEP
    (set #part #step)
    (P_WANT)
    (if #want
        (
            (P_LEAD)
            (working #lead #why)
            (set #rc (execute "UPTKIT:install.dos" "UPTKIT:" (cat "STEP=" #step)))
            (if (>= #rc 20)
                (
                    (P_OPTIONS_END)
                    (abort (cat "Part \"" #step "\" of the install failed (return code "
                                #rc "). What was installed so far stays; Uninstall takes "
                                "it out."))))
            (P_BAR))))

; copyfiles' panel covers the page below the Working line (TEXT LAYOUT), so
; the page is emptied of the last part's text and gets none of its own; the
; panel names each file and drawer. #why is copyfiles' prompt (shown only
; when it asks), with line breaks but no lead.
; In an Update a copy part runs upupdate's script for it instead (T:UPTUPD-
; <part>: the drawer's new and changed files, the ones gone deleted), under
; its own text: there is no copyfiles panel then.
(procedure P_COPY
    (P_WANT)
    (if #want
        (
            (if #update
                (
                    (P_LEAD)
                    (working #lead #why)
                    (execute (cat "T:UPTUPD-" #part)))
                (
                    (working "")
                    (copyfiles
                        (prompt #why)
                        (help @copyfiles-help)
                        (source #from)
                        (dest #to)
                        (all)
                        (optional "force"))))
            (P_BAR))))
