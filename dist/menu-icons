apps.tmux         = U+EBC8    ; cod-terminal_tmux
apps.editor       = U+F044    ; fa-pencil_square_o
apps.claude       = U+F0E7    ; fa-flash
style.theme       = U+F1FC    ; fa-paintbrush
style.font        = U+F031    ; fa-font
style.background  = U+F03E    ; fa-picture_o
window.tab        = U+F067    ; fa-plus
window.preferences = U+F013   ; fa-gear
