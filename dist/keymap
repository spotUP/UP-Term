; UP-Term key bindings (Amarchy). Read by the XCON: handler and by the Amarchy
; commodity from ENVARC:up-term/keymap (ENV:up-term/keymap first). Without this
; file the compiled-in copy of it stands, so the terminal never loses its keys.
; Every Install replaces this file (an older different copy is saved as
; keymap.bak). Put your own changes in the optional keymap.user beside this
; file instead: a row there replaces the row for the same key, and
;   super+t = none
; unbinds one. An edit of ENVARC:up-term/keymap.user applies after a copy to
; ENV:up-term/keymap.user (Amarchy picks it up at once) or at the next boot.
;
; Super is the Left Amiga key. Left Amiga + M and Left Amiga + N belong to
; Intuition, Left Amiga + mouse to Workbench, and Ctrl + both Amigas is the
; hardware reset: the parser refuses M, N and the mouse words, and the handler and
; the commodity never take a press with Right Amiga down.
; Alt is not used with Left Amiga: Left Amiga + Alt is Intuition's left mouse button
; (it clicks the gadget under the pointer), so the window chords use Left Amiga + Ctrl.
;
; Format (one row a line, ; starts a comment):
;   super[+shift][+ctrl][+rshift]+KEY = action ; label | category
; KEY is a lower-case word: space return tab esc help del backspace up down
; left right f1..f10 comma period minus plus, or a letter or digit. Letters
; and digits are the key's place on the board, not its character, so the
; Swedish keymap does not move them. "1..9" is nine rows; %n is the digit.
; Actions:
;   menu:<id>        the quick menu at a node of the [menu] tree
;   viewer           this key list
;   tab:new | close | next | prev | goto N
;   menuid:<NAME>    any menu item by its MENU_ name
;   slash:/command   a slash command (/theme, /size 132x43 ...)
;   run:<command>    start a program (a vsh line: 'single quotes' round a path with a space,
;                    never double quotes)
;   job:<command>    like run:, for a long job (upkg upgrade): the menu shows its output in a job view
                   (scroll, Esc cancels) when the menu style has one; otherwise it runs as run:
  open:uterm       a new UP-Term window (commodity only; in a window: tab:new)
;   rexx:<script>    an ARexx script or string (Amarchy hotkeys and menu rows)
;   win:<verb> [arg] a window verb on the active or menu-targeted window: cycle, front, back,
;                    zip, fullwidth, fullscreen, save, restore, move, size, focus,
;                    closedrawers, screen, title
;   cap:<screen|window|region>  a screenshot of the front screen, the active window, or a dragged
;                    region: an IFF ILBM file in RAM:Shots and the clipboard (Left Amiga + Alt is the
;                    left mouse button, so the window shot uses Left Amiga + Ctrl)
;   bar:<on|off|toggle>  the status bar at the bottom of the Workbench screen (ARexx BAR)

[keymap]
version = 1
super = lamiga

[bind]
; Menus
super+space       = menu:root              ; Menu                  | menu
super+shift+space = menu:apps              ; Apps                  | menu
super+k           = viewer                 ; Key bindings          | menu
super+h           = slash:/help            ; Help                  | menu
super+shift+h     = slash:/tutorial        ; Tutorial              | menu

; Tabs
super+t           = tab:new                ; New tab               | window
super+w           = tab:close              ; Close tab             | window
super+backspace   = tab:close              ; Close tab             | window
super+q           = menuid:MENU_CLOSE      ; Close window          | window
super+1..9        = tab:goto %n            ; Switch to tab %n      | workspace
super+f1          = tab:goto 1             ; Switch to tab 1       | workspace
super+f2          = tab:goto 2             ; Switch to tab 2       | workspace
super+f3          = tab:goto 3             ; Switch to tab 3       | workspace
super+f4          = tab:goto 4             ; Switch to tab 4       | workspace
super+period      = tab:next               ; Next tab              | workspace
super+comma       = tab:prev               ; Previous tab          | workspace

; Window (super+m and super+n are refused by the parser: Left Amiga M and N belong to Intuition's screen cycling)
super+o           = win:front                ; Bring to front         | window
super+ctrl+o       = win:back                 ; Send to back           | window
super+z           = win:zip                  ; Zoom or restore        | window
super+ctrl+f       = win:fullwidth            ; Full width             | window
super+ctrl+s       = win:save                 ; Save position and size | window
super+ctrl+r       = win:restore              ; Restore position and size | window
super+ctrl+tab     = win:cycle next           ; Next window            | window
super+ctrl+shift+tab = win:cycle prev           ; Previous window        | window
super+shift+left  = win:move left            ; Move window left       | window
super+shift+right = win:move right           ; Move window right      | window
super+shift+up    = win:move up              ; Move window up         | window
super+shift+down  = win:move down            ; Move window down       | window
super+ctrl+t       = run:UP-Term:bin/AmTile TOGGLE ; Tile windows         | window
super+ctrl+l       = run:UP-Term:bin/AmTile LAYOUT NEXT          ; Next layout           | window
super+ctrl+1       = run:UP-Term:bin/AmTile LAYOUT dwindle       ; Layout dwindle        | window
super+ctrl+2       = run:UP-Term:bin/AmTile LAYOUT master-stack  ; Layout master-stack   | window
super+ctrl+3       = run:UP-Term:bin/AmTile LAYOUT mirrored      ; Layout mirrored master-stack | window
super+ctrl+4       = run:UP-Term:bin/AmTile LAYOUT columns       ; Layout columns        | window
super+ctrl+5       = run:UP-Term:bin/AmTile LAYOUT rows          ; Layout rows           | window
super+ctrl+6       = run:UP-Term:bin/AmTile LAYOUT grid          ; Layout grid           | window
super+ctrl+7       = run:UP-Term:bin/AmTile LAYOUT monocle       ; Layout monocle        | window
super+ctrl+minus   = run:UP-Term:bin/AmTile RATIO -5             ; Shrink master         | window
super+ctrl+plus    = run:UP-Term:bin/AmTile RATIO +5             ; Grow master           | window
super+ctrl+j       = run:UP-Term:bin/AmTile NMASTER -1           ; Fewer masters         | window
super+ctrl+k       = run:UP-Term:bin/AmTile NMASTER +1           ; More masters          | window
super+ctrl+return  = run:UP-Term:bin/AmTile PROMOTE              ; Promote to master     | window
super+ctrl+period  = run:UP-Term:bin/AmTile CYCLE NEXT           ; Next tiled window     | window
super+ctrl+comma   = run:UP-Term:bin/AmTile CYCLE PREV           ; Previous tiled window | window
super+left        = win:focus left         ; Focus window to the left  | window
super+right       = win:focus right        ; Focus window to the right | window
super+up          = win:focus up           ; Focus window above        | window
super+down        = win:focus down         ; Focus window below        | window
super+ctrl+shift+left  = win:snap left     ; Snap to left half      | window
super+ctrl+shift+right = win:snap right    ; Snap to right half     | window
super+ctrl+shift+up    = win:snap up       ; Snap to top half       | window
super+ctrl+shift+down  = win:snap down     ; Snap to bottom half    | window
super+ctrl+shift+1 = win:snap tl           ; Snap to top left       | window
super+ctrl+shift+2 = win:snap tr           ; Snap to top right      | window
super+ctrl+shift+3 = win:snap bl           ; Snap to bottom left    | window
super+ctrl+shift+4 = win:snap br           ; Snap to bottom right   | window
super+ctrl+shift+c = win:snap center       ; Centre window          | window
super+ctrl+shift+t = run:UP-Term:bin/AmTile FLOAT TOGGLE ; Float or tile window | window
super+ctrl+shift+h = run:UP-Term:bin/AmTile SWAP LEFT    ; Swap with window on the left  | window
super+ctrl+shift+j = run:UP-Term:bin/AmTile SWAP DOWN    ; Swap with window below        | window
super+ctrl+shift+k = run:UP-Term:bin/AmTile SWAP UP      ; Swap with window above        | window
super+ctrl+shift+l = run:UP-Term:bin/AmTile SWAP RIGHT   ; Swap with window on the right | window
super+ctrl+left    = win:size left           ; Make window narrower   | window
super+ctrl+right   = win:size right           ; Make window wider      | window
super+ctrl+up      = win:size up              ; Make window shorter    | window
super+ctrl+down    = win:size down            ; Make window taller     | window
; Screens
super+tab         = win:screen next          ; Next screen            | workspace
super+shift+tab   = win:screen prev          ; Previous screen        | workspace
