+static void copy_name(char *d, const char *s, int n)
+{
+    if (!s)
+        s = "(null)";
+    strncpy(d, s, n - 1);
+    d[n - 1] = 0;
+}
+
+/* Diagnostic (S85k blocker census): the first Workbench window that breaks Directory Opus' check_closescreen rule
+ * (dopus5 Program/misc.c:441), and who sits on top of the CloseWorkBench vector. Caller must be a process. */
+static void diag_blocker(void)
+{
+    struct List *pl = LockPubScreenList();
+    struct PubScreenNode *n;
+    struct Window *w;
+    char title[48], task[48];
+    const char *tn;
+    int bad = 0;
+    title[0] = task[0] = 0;
+    for (n = (struct PubScreenNode *)pl->lh_Head; n->psn_Node.ln_Succ; n = (struct PubScreenNode *)n->psn_Node.ln_Succ)
+        if (n->psn_Node.ln_Name && !strcmp(n->psn_Node.ln_Name, "Workbench") && n->psn_Screen)
+            for (w = n->psn_Screen->FirstWindow; w; w = w->NextWindow) {
+                tn = w->UserPort && w->UserPort->mp_SigTask
+                    ? ((struct Task *)w->UserPort->mp_SigTask)->tc_Node.ln_Name : 0;
+                if ((w->Flags & 0x02000000) || (tn && (!strncmp(tn, "dopus", 5) || !strncmp(tn, "DOpus", 5)
+                                                     || !strcmp(tn, "\xab IPrefs \xbb"))))
+                    continue;
+                if (!bad++) {
+                    copy_name(title, (const char *)w->Title, sizeof title);
+                    copy_name(task, w->UserPort ? tn : "(no UserPort)", sizeof task);
+                }
+            }
+    UnlockPubScreenList();
+    am_sentinel("PATINA_WBR_BLOCKERS", bad);
+    am_sentinel_str("PATINA_WBR_BLOCKER", bad ? title : "-");
+    am_sentinel_str("PATINA_WBR_BLOCKER_TASK", bad ? task : "-");
+    am_sentinel("PATINA_WBR_TOP_OURS", *g_pc.slot == (uintptr_t)g_pc.gate);
+    am_sentinel("PATINA_WBR_TOP", (long)*g_pc.slot);
+    am_sentinel("PATINA_WBR_SAVED", (long)ipatch_saved(&g_pc));
+}
+
+/* Diagnostic (S85k): one line per close, ENV:PATINA_WBR_C<n> = caller task, result, retries, Workbench visitors,
+ * windows left (all / DOpus-owned). Read after the original's last try. */
+static void diag_call(long n, struct Task *me, LONG ok, int retries)
+{
+    struct List *pl = LockPubScreenList();
+    struct PubScreenNode *p;
+    struct Window *w;
+    const char *tn;
+    char name[24], line[96];
+    int v = -1, k = 0, d = 0;
+    for (p = (struct PubScreenNode *)pl->lh_Head; p->psn_Node.ln_Succ; p = (struct PubScreenNode *)p->psn_Node.ln_Succ)
+        if (p->psn_Node.ln_Name && !strcmp(p->psn_Node.ln_Name, "Workbench")) {
+            v = p->psn_VisitorCount;
+            if (p->psn_Screen)
+                for (w = p->psn_Screen->FirstWindow; w; w = w->NextWindow) {
+                    k++;
+                    tn = w->UserPort && w->UserPort->mp_SigTask
+                        ? ((struct Task *)w->UserPort->mp_SigTask)->tc_Node.ln_Name : 0;
+                    d += tn && (!strncmp(tn, "dopus", 5) || !strncmp(tn, "DOpus", 5));
+                }
+        }
+    UnlockPubScreenList();
+    copy_name(name, me->tc_Node.ln_Name, sizeof name);
+    sprintf(line, "%s ok=%ld retries=%d vis=%d wins=%d dopus=%d", name, (long)ok, retries, v, k, d);
+    sprintf(name, "PATINA_WBR_C%ld", n);
+    am_sentinel_str(name, line);
+}
