+        static long calls;
+        am_sentinel("PATINA_WBR_CALLS", ++calls);
+        am_sentinel("PATINA_WBR_OK", ok != 0);
+        am_sentinel("PATINA_WBR_RETRIES", t / 10);
+        diag_call(calls, me, ok, t / 10);
+    }
     Forbid();
     n = wbr_close_end(&g_pub->rec, ok != 0, timed, s);
     signal_all(s, n);
