Subject: [PATCH 1/2] vshrc: archivers complete only their own archives (-F
 filter plus -o plusdirs, case-insensitive), so lha x H<Tab> offers the .lha
 and not the drawer beside it

---
 Makefile                     |  1 +
 dist/vshrc                   | 26 ++++++++++++++++++++++
 tests/test_vshrc_complete.py | 43 ++++++++++++++++++++++++++++++++++++
 3 files changed, 70 insertions(+)
 create mode 100644 tests/test_vshrc_complete.py

diff --git a/Makefile b/Makefile
index dc0a30e7..3461beed 100644
--- a/Makefile
+++ b/Makefile
@@ -161,6 +161,7 @@ test: $(BUILD)/vttest_host $(BUILD)/vtdump $(BUILD)/tn_host $(BUILD)/vsh_host $(
 	@if [ -z "$(ONLY)" ] || [ "$(ONLY)" = hl ]; then python3 tests/test_hl_plain.py; fi
 	@if [ -z "$(ONLY)" ] || [ "$(ONLY)" = vshrc_net ]; then python3 tests/test_vshrc_net.py; fi
 	@if [ -z "$(ONLY)" ] || [ "$(ONLY)" = vshrc_editor ]; then python3 tests/test_vshrc_editor.py; fi
+	@if [ -z "$(ONLY)" ] || [ "$(ONLY)" = vshrc_complete ]; then python3 tests/test_vshrc_complete.py; fi
 	@if [ -z "$(ONLY)" ] || [ "$(ONLY)" = tutorial ]; then python3 tests/test_tutorial.py; fi
 	@if [ -z "$(ONLY)" ] || [ "$(ONLY)" = tutorial ]; then python3 tests/test_tutorial_lessons.py; fi
 	@if [ -z "$(ONLY)" ] || [ "$(ONLY)" = tutorial ]; then python3 tests/test_tutorial_wiring.py; fi
diff --git a/dist/vshrc b/dist/vshrc
index de3b56a5..0b2dcae8 100644
--- a/dist/vshrc
+++ b/dist/vshrc
@@ -126,6 +126,32 @@ export EDITOR
 alias ls='ls --color=auto'
 alias ll='ls -l'
 
+# Archivers complete only their own archives (bash's complete -f -X '!pattern'
+# for lha, unzip, tar ...): "lha x H<Tab>" in a drawer holding HiP/ and
+# HiP.lha offers HiP.lha. Drawers stay offered (-o plusdirs) so a Tab can
+# walk into one to reach an archive. The match ignores case (.LHA, .lha).
+# vsh's complete has no -X, so one -F function does the filtering.
+_archive_match() {
+    case $1 in
+    lha) case $2 in *.[lL][hH][aA]|*.[lL][zZ][hH]|*.[lL][zZ][xX]) return 0 ;; esac ;;
+    lzx) case $2 in *.[lL][zZ][xX]) return 0 ;; esac ;;
+    unzip) case $2 in *.[zZ][iI][pP]) return 0 ;; esac ;;
+    tar) case $2 in *.[tT][aA][rR]|*.[tT][gG][zZ]|*.[tT][aA][rR].[gG][zZ]|*.[tT][aA][rR].[bB][zZ]2|*.[tT][aA][rR].[xX][zZ]) return 0 ;; esac ;;
+    gunzip) case $2 in *.[gG][zZ]|*.[tT][gG][zZ]) return 0 ;; esac ;;
+    unxz) case $2 in *.[xX][zZ]|*.[tT][xX][zZ]) return 0 ;; esac ;;
+    esac
+    return 1
+}
+_archive_complete() {
+    local f
+    COMPREPLY=()
+    for f in $(compgen -f -- "$2"); do
+        [ -d "$f" ] && continue
+        _archive_match "$1" "$f" && COMPREPLY[${#COMPREPLY[@]}]=$f
+    done
+}
+complete -F _archive_complete -o plusdirs lha lzx unzip tar gunzip unxz
+
 # hl and mdv (UP-Term:bin, see the README): a source in colour with
 # line numbers (hl file.c; to a pipe or a file it is plain cat), Markdown
 # formatted for the window (mdv README.md). hlp and mdp page them: less -R
diff --git a/tests/test_vshrc_complete.py b/tests/test_vshrc_complete.py
new file mode 100644
index 00000000..8f4c249c
--- /dev/null
+++ b/tests/test_vshrc_complete.py
@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+"""Archive completion rules of dist/vshrc. vsh's complete has no -X, so one -F
+function (_archive_complete) keeps only the archives the command reads, and
+-o plusdirs keeps drawers offered: "lha x H<Tab>" in a drawer holding HiP/ and
+HiP.lha offers only HiP.lha. The real dist/vshrc is sourced by the host vsh
+(build/vsh_host). The rig half: lha x H + Tab on rig 8 (2026-10-26)."""
+import os, subprocess, tempfile, unittest
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))
+VSH = os.path.join(ROOT, 'build', 'vsh_host')
+VSHRC = os.path.join(ROOT, 'dist', 'vshrc')
+CMDS = ('lha', 'lzx', 'unzip', 'tar', 'gunzip', 'unxz')
+
+
+@unittest.skipUnless(os.path.exists(VSH), 'build/vsh_host missing (make build/vsh_host)')
+class ArchiveComplete(unittest.TestCase):
+    def run_vsh(self, script, files=()):
+        with tempfile.TemporaryDirectory() as d:
+            os.mkdir(os.path.join(d, 'HiP-spot-cfec68a'))
+            for f in files:
+                open(os.path.join(d, f), 'w').close()
+            p = subprocess.run([VSH, '-c', '. %s >/dev/null 2>&1; %s' % (VSHRC, script)], cwd=d,
+                               stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30)
+        return p.stdout
+
+    def test_every_archiver_has_the_rule_with_plusdirs(self):
+        out = self.run_vsh('complete -p')
+        for c in CMDS:
+            self.assertIn('complete -o plusdirs -F _archive_complete %s\n' % c, out)
+
+    def test_only_archives_of_the_command_are_offered_in_any_case(self):
+        files = ('HiP-spot-cfec68a.lha', 'Hx.LHA', 'Hz.txt', 'Ht.tar.gz')
+        reply = lambda c: self.run_vsh('_archive_complete %s H x; echo "${COMPREPLY[@]}"' % c, files).split()
+        self.assertEqual(reply('lha'), ['HiP-spot-cfec68a.lha', 'Hx.LHA'])
+        self.assertEqual(reply('tar'), ['Ht.tar.gz'])
+        self.assertEqual(reply('unzip'), [])
+
+    def test_a_command_without_a_rule_keeps_the_default(self):
+        self.assertNotIn('echo', self.run_vsh('complete -p'))
+
+
+if __name__ == '__main__':
+    unittest.main()
-- 
