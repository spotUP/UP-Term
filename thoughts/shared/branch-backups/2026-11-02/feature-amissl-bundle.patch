From 414fca10cf53624a91486d6cf71fb10112651b6f Mon Sep 17 00:00:00 2001
From: spotUP <retroranksmail@gmail.com>
Date: Sun, 11 Oct 2026 20:17:27 +0200
Subject: [PATCH 03/10] rig: write the config on every start (a fresh --os rig
 had none) and refuse to launch FS-UAE without a present, non-empty
 hard_drive_0

---
 tools/rig/rig.py | 22 +++++++++++++++++++---
 1 file changed, 19 insertions(+), 3 deletions(-)

diff --git a/tools/rig/rig.py b/tools/rig/rig.py
index fd3d9a78..ca398285 100644
--- a/tools/rig/rig.py
+++ b/tools/rig/rig.py
@@ -395,9 +395,11 @@ def setup():
         print("rig ready:", CFG)
 
 def setup_config_only():
-    """Rewrite just the config, so --rw on or off takes effect."""
-    if (RIG / "sys.hdf").exists():
-        setup()
+    """Rewrite the config, so --rw on or off takes effect. Always setup(): it
+    makes what a first start needs (the system disk or the --os copy, the
+    config). Gated on sys.hdf it wrote no config for a fresh --os rig, and
+    start() launched FS-UAE on a config that did not exist: no boot device."""
+    setup()
 
 def install():
     shutil.copyfile(ROOT / "build/amiga/vtcon-handler", RIG / "vtc/vtcon-handler")
@@ -435,6 +437,19 @@ def mine():
     out = subprocess.run(["ps", "-eo", "pid,command"], capture_output=True, text=True).stdout
     return [l for l in out.splitlines() if str(CFG) in l and "fs-uae" in l.lower()]
 
+def boot_device_check():
+    """Refuse to launch UAE without a boot device: the config must exist and
+    its hard_drive_0 must be a present, non-empty directory or file. An
+    emulator with no boot device just sits on the insert-disk screen."""
+    if not CFG.exists():
+        sys.exit("rig: not starting: config %s is missing" % CFG)
+    hd = [l.split("=", 1)[1].strip() for l in CFG.read_text().splitlines() if l.startswith("hard_drive_0 =")]
+    if not hd:
+        sys.exit("rig: not starting: %s lists no hard_drive_0 (no boot device)" % CFG)
+    p = pathlib.Path(hd[0])
+    if not p.exists() or (p.is_dir() and not any(p.iterdir())) or (p.is_file() and p.stat().st_size == 0):
+        sys.exit("rig: not starting: hard_drive_0 %s is missing or empty (no boot device)" % p)
+
 def start(retries=2):
     """Boot; a boot that stops right after "go started" (the emulator froze
     before anything under test loaded: seen 3 times on 2026-09-29, cause not
@@ -449,6 +464,7 @@ def start(retries=2):
     log = RIG / "boot/boot.log"
     if log.exists():
         log.unlink()
+    boot_device_check()
     subprocess.run(["open", "-g", "-n", "-a", "/Applications/FS-UAE.app", "--args", str(CFG)], check=True)
     for i in range(90):
         time.sleep(2)
-- 
