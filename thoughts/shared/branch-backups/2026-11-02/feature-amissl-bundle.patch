From a3d86f0c478571d5b1f373c2699bcd09ca68f68e Mon Sep 17 00:00:00 2001
From: spotUP <retroranksmail@gmail.com>
Date: Sun, 11 Oct 2026 20:03:10 +0200
Subject: [PATCH 02/10] Makefile, rig paths: UPTERM_ROOT in a git worktree is
 the parent of the main checkout, not the worktrees directory

---
 Makefile           |  5 ++++-
 tools/rig/paths.py | 23 ++++++++++++++++++++---
 2 files changed, 24 insertions(+), 4 deletions(-)

diff --git a/Makefile b/Makefile
index 6e3e9800..691d7d01 100644
--- a/Makefile
+++ b/Makefile
@@ -7,7 +7,10 @@ BUILD   := build
 # The workspace directory that holds vtcon and the other UP-Term repos side by
 # side (see the upterm meta-repo); every sibling default below hangs off it.
 # tools/rig/paths.py reads the same variable, with the same default.
-UPTERM_ROOT ?= $(abspath ..)
+# In a git worktree the parent is not the workspace: the workspace is the parent
+# of the MAIN checkout, which the shared git directory names (<main>/.git).
+UPTERM_GITDIR := $(shell git rev-parse --git-common-dir 2>/dev/null)
+UPTERM_ROOT ?= $(abspath $(if $(UPTERM_GITDIR),$(UPTERM_GITDIR)/../..,..))
 
 ENGINE  := engine/vtengine.c
 RENDER  := render/glyphmap.c render/unifont.c render/emoji.c render/fontpair.c render/sbar.c render/otag.c render/painter.c handler/lineedit.c handler/slash.c handler/clipfmt.c handler/complete_core.c render/vtinput.c handler/waitset.c handler/histfile.c
diff --git a/tools/rig/paths.py b/tools/rig/paths.py
index 7ab525d0..fb5bd06f 100644
--- a/tools/rig/paths.py
+++ b/tools/rig/paths.py
@@ -5,15 +5,32 @@ UPTERM_OS32_TREE, UPTERM_OS32_ROM).
 
 UPTERM_ROOT is the workspace directory that holds vtcon, ixemul-vtcon,
 tmux-amiga, ... side by side (the meta-repo `upterm` creates it). Default:
-the parent of this vtcon checkout. The Makefile's default is the same
-(`UPTERM_ROOT ?= $(abspath ..)`).
+the parent of the main vtcon checkout (for a git worktree: of the checkout
+the worktree belongs to, not of the worktrees directory). The Makefile's
+default is the same.
 """
 import os
 import pathlib
 import sys
 
 VTCON = pathlib.Path(__file__).resolve().parents[2]
-UPTERM_ROOT = pathlib.Path(os.environ.get("UPTERM_ROOT") or VTCON.parent)
+
+
+def _main_checkout():
+    """The checkout that owns this tree: VTCON itself, or for a git worktree
+    the main checkout its shared git directory lives in."""
+    git = VTCON / ".git"
+    if git.is_file():
+        for line in git.read_text().splitlines():
+            if line.startswith("gitdir:"):
+                gd = pathlib.Path(line[7:].strip())
+                # <main>/.git/worktrees/<name>
+                if gd.parent.name == "worktrees":
+                    return gd.parent.parent.parent
+    return VTCON
+
+
+UPTERM_ROOT = pathlib.Path(os.environ.get("UPTERM_ROOT") or _main_checkout().parent)
 
 
 # Which rig: UPTERM_RIG unset or 1 is the first (build/rig, amiagent port 7846);
-- 
