+++ b/dist/Install.installer
@@ -141,8 +141,41 @@
 (set #emoji "")
 (set #cpu060 (if (= (database "cpu") "68060") "CPU060" ""))
 (set #cpu040 (if (= (database "cpu") "68040") "CPU040" ""))
-; curl is ticked when AmiSSL is there (curl cannot run without it)
-(set #amissl (exists "LIBS:amisslmaster.library"))
+; The TLS programs (Claude with an API key, curl) were built against AmiSSL
+; 5.27 and open its amissl_v362.library (AMISSL_CURRENT_VERSION), which is
+; what an older AmiSSL lacks. Missing or older: offer AmiSSL's own installer
+; from the kit (Files/amissl, the 5.27 release unchanged); it picks the CPU
+; variant and sets the AmiSSL: assign. Never run without the answer Yes: the
+; default is No, so the Novice level (which takes defaults) does not run it.
+(procedure P_AMISSL_OK
+    (set #amissl (and (exists "LIBS:amisslmaster.library") (exists "LIBS:AmiSSL/amissl_v362.library"))))
+(P_AMISSL_OK)
+(if (not #amissl)
+    (
+        (if (askbool
+                (prompt "AmiSSL 5.27 is not installed (or an older one is).\n"
+                        "Claude with an API key and curl need it for https.\n\n"
+                        "Run AmiSSL's own installer now?")
+                (help "AmiSSL (Apache 2.0, the AmiSSL Open Source Team) is in the kit "
+                      "unchanged, in Files/amissl, with its readme and licence. Its "
+                      "own installer picks the library for your CPU, copies it to "
+                      "LIBS:, and adds the AmiSSL: assign to S:User-Startup; it "
+                      "asks its own questions.\n\nNo: UP-Term installs without "
+                      "it, and Claude (with an API key) and curl will not run "
+                      "until AmiSSL 5.27 is installed.")
+                (choices "Yes, run the AmiSSL installer" "No, continue without AmiSSL")
+                (default 0))
+            (
+                (run (cat (if (exists "C:Installer") "C:Installer" "SYS:Utilities/Installer")
+                          " SCRIPT \"" (tackon #files "amissl/AmiSSL/Install-AmiSSL")
+                          "\" APPNAME AmiSSL"))
+                (P_AMISSL_OK)))
+        (if (not #amissl)
+            (message "Without AmiSSL 5.27 these programs will not work:\n"
+                     "  Claude (https to Anthropic, with an API key)\n"
+                     "  curl\n\n"
+                     "The rest of UP-Term is not affected. Run Files/amissl/AmiSSL/"
+                     "Install-AmiSSL from the kit any time.")))))
 
 (set #net
     (askoptions
@@ -154,12 +187,12 @@
               "one is there.\n\n"
               "bebboget: https downloads (GPL v3+), by the same author.\n\n"
               "curl 8.22.0: downloads and transfers (the curl licence). It needs "
-              "AmiSSL 5 (Aminet util/libs/AmiSSL-v5-OS3.lha), so it is ticked "
-              "only when AmiSSL is found.\n\n"
+              "AmiSSL 5.27 (bundled; the Installer offered to install it), so it is "
+              "ticked only when AmiSSL is found.\n\n"
               "Their licences and sources are in the kit's Files/net drawer.")
         (choices "ssh and scp (BebboSSH)"
                  "bebboget (https downloads)"
-                 (if #amissl "curl (AmiSSL 5 found)" "curl (needs AmiSSL 5, not found)"))
+                 (if #amissl "curl (AmiSSL 5.27 found)" "curl (needs AmiSSL 5.27, not found)"))
         (default (+ 1 2 (if #amissl 4 0)))))
 (if (in #net 0) (set #ssh "SSH"))
 (if (in #net 1) (set #bget "BEBBOGET"))
