diff --git a/amarchy/flat_core.c b/amarchy/flat_core.c
index cbaf9fe2..d5d03576 100644
--- a/amarchy/flat_core.c
+++ b/amarchy/flat_core.c
@@ -166,6 +166,45 @@ uint32_t flat_jmp_target(const unsigned char *e)
     return ((uint32_t)e[2] << 24) | ((uint32_t)e[3] << 16) | ((uint32_t)e[4] << 8) | e[5];
 }
 
+uint32_t flat_fieldbox_body(const unsigned char *s, uint32_t stub_addr)
+{
+    static const unsigned char head[4] = {0x2f, 0x0a, 0x2f, 0x39}, tail[8] = {0x2f, 0x0a, 0x2f, 0x09, 0x2f, 0x08, 0x4e, 0xba};
+    int16_t d;
+    if (!s || memcmp(s, head, 4) || memcmp(s + 8, tail, 8))
+        return 0;
+    d = (int16_t)(((unsigned)s[16] << 8) | s[17]);
+    return stub_addr + 16 + (uint32_t)(int32_t)d;
+}
+
+int flat_body_prologue(int el, const unsigned char *body)
+{
+    static const unsigned char box[6] = {0x48, 0xe7, 0x30, 0x12, 0x24, 0x08};
+    static const unsigned char field[8] = {0x48, 0xe7, 0x20, 0x32, 0x41, 0xef, 0x00, 0x14};
+    if (!body)
+        return 0;
+    if (el == FLAT_EL_DRAWBOX)
+        return memcmp(body, box, sizeof box) ? 0 : (int)sizeof box;
+    if (el == FLAT_EL_FIELDBOX)
+        return memcmp(body, field, sizeof field) ? 0 : (int)sizeof field;
+    return 0;
+}
+
+void flat_jmp_build(unsigned char *out, uint32_t t)
+{
+    out[0] = 0x4e; out[1] = 0xf9;
+    out[2] = (unsigned char)(t >> 24); out[3] = (unsigned char)(t >> 16);
+    out[4] = (unsigned char)(t >> 8); out[5] = (unsigned char)t;
+}
+
+int flat_body_tramp_build(unsigned char *out, const unsigned char *prologue, int len, uint32_t resume)
+{
+    if (!out || !prologue || len < FLAT_JMP_BYTES || len > FLAT_PRO_MAX || (len & 1))
+        return 0;
+    memcpy(out, prologue, (size_t)len);
+    flat_jmp_build(out + len, resume);
+    return len + FLAT_JMP_BYTES;
+}
+
 int flat_dopus_gate(const flat_dopus_build *tab, int n, unsigned version, unsigned revision,
                     const uint32_t sums[FLAT_EL_COUNT], int *reason)
 {
diff --git a/amarchy/flat_core.h b/amarchy/flat_core.h
index 26698ec8..e427e29c 100644
--- a/amarchy/flat_core.h
+++ b/amarchy/flat_core.h
@@ -153,6 +153,32 @@ uint32_t flat_sum(const void *p, size_t len);
 uint32_t flat_sum_reloc(const void *p, size_t len);
 uint32_t flat_jmp_target(const unsigned char *entry);
 
+/* ---- 0c FLAT-D4 body hook (thoughts/shared/s66-evidence/0c-dopus-gadget-outline.md) --------------------------------
+ * dopus5's own gadget classes call the DrawBox / DrawFieldBox BODIES with an absolute jsr, never through the jump table,
+ * so the LVO swap above misses every Environment gadget. The body hook writes JMP abs.l (FLAT_JMP_BYTES) over the
+ * body's first instructions; the saved path is a trampoline of the relocated prologue + JMP to body + its length.
+ * Only a body whose prologue bytes are exactly the known position-independent ones is hooked; anything else keeps the
+ * LVO swap. */
+#define FLAT_JMP_BYTES 6
+#define FLAT_PRO_MAX 8
+#define FLAT_BODY_TRAMP_MAX (FLAT_PRO_MAX + FLAT_JMP_BYTES)
+
+/* The FieldBox body the LVO -702 stub calls. The stub (5.104: 2f0a 2f39 <GfxBase.l> 2f0a 2f09 2f08 4eba <d16>) pushes
+ * a2, GfxBase, info, rect, rp and bsr's the stack-convention body at stub + 16 + d16. stub_addr is where stub sits in
+ * the Amiga's memory. 0 when the bytes are anything else. */
+uint32_t flat_fieldbox_body(const unsigned char *stub, uint32_t stub_addr);
+
+/* Bytes to relocate from the body of element el: 6 for DrawBox (48e7 3012 2408: movem.l, move.l a0,d2), 8 for FieldBox
+ * (48e7 2032 41ef 0014: movem.l, lea 20(sp),a0; the trampoline is jumped to, so sp is the same); 0 = unknown body. */
+int flat_body_prologue(int el, const unsigned char *body);
+
+/* JMP abs.l target into out[0..5]. */
+void flat_jmp_build(unsigned char *out, uint32_t target);
+
+/* The trampoline: len prologue bytes + JMP abs.l resume (body + len). Returns its size, 0 for a bad len. out must hold
+ * FLAT_BODY_TRAMP_MAX. */
+int flat_body_tramp_build(unsigned char *out, const unsigned char *prologue, int len, uint32_t resume);
+
 /* Which elements may be patched for this library. Bit (1 << FLAT_EL_*) per element; *reason says why a bit is missing. */
 int flat_dopus_gate(const flat_dopus_build *tab, int n, unsigned version, unsigned revision,
                     const uint32_t sums[FLAT_EL_COUNT], int *reason);
diff --git a/tests/test_flat_core.c b/tests/test_flat_core.c
index 2fba0c13..87b6714f 100644
--- a/tests/test_flat_core.c
+++ b/tests/test_flat_core.c
@@ -269,6 +269,48 @@ static void test_dopus_gate(void)
     CHECK_INT(flat_jmp_target(0), 0);
 }
 
+/* 0c: the body hook's pure parts, on the real dopus5.library 73.8 (DOpus 5.104 OS3) bytes: .text 0x245c4 (the -702 stub),
+ * 0x2450c (DrawBox body), 0x245de (FieldBox body). */
+static void test_dopus_body_hook(void)
+{
+    static const unsigned char stub[18] = {0x2f,0x0a,0x2f,0x39,0x00,0x00,0x00,0x08,0x2f,0x0a,0x2f,0x09,0x2f,0x08,0x4e,0xba,0x00,0x0a};
+    static const unsigned char box[8] = {0x48,0xe7,0x30,0x12,0x24,0x08,0x26,0x49};
+    static const unsigned char field[10] = {0x48,0xe7,0x20,0x32,0x41,0xef,0x00,0x14,0x24,0x18};
+    unsigned char s2[18], b2[10], t[FLAT_BODY_TRAMP_MAX], j[6];
+    CHECK_INT(flat_fieldbox_body(stub, 0x245c4), 0x245de);             /* the bsr target the disassembly found */
+    CHECK_INT(flat_fieldbox_body(stub, 0x1000000), 0x100001a);        /* position independent */
+    memcpy(s2, stub, 18); s2[4] = 0x12; s2[7] = 0x34;                  /* another GfxBase: still the stub */
+    CHECK_INT(flat_fieldbox_body(s2, 0x245c4), 0x245de);
+    s2[16] = 0xff; s2[17] = 0xf0;                                      /* a backward bsr */
+    CHECK_INT(flat_fieldbox_body(s2, 0x245c4), 0x245c4 + 16 - 16);
+    memcpy(s2, stub, 18); s2[13] = 0x09;                               /* other code: no body */
+    CHECK_INT(flat_fieldbox_body(s2, 0x245c4), 0);
+    CHECK_INT(flat_fieldbox_body(0, 0x245c4), 0);
+    CHECK_INT(flat_body_prologue(FLAT_EL_DRAWBOX, box), 6);
+    CHECK_INT(flat_body_prologue(FLAT_EL_FIELDBOX, field), 8);
+    CHECK_INT(flat_body_prologue(FLAT_EL_FIELDBOX, box), 0);           /* each element only its own prologue */
+    CHECK_INT(flat_body_prologue(FLAT_EL_DRAWBOX, field), 0);
+    memcpy(b2, box, 8); b2[5] = 0x09;                                  /* move.l a1,d2: another build, keep the LVO swap */
+    CHECK_INT(flat_body_prologue(FLAT_EL_DRAWBOX, b2), 0);
+    memcpy(b2, field, 10); b2[7] = 0x18;                               /* lea 24(sp): another frame */
+    CHECK_INT(flat_body_prologue(FLAT_EL_FIELDBOX, b2), 0);
+    b2[0] = 0x4e; b2[1] = 0xf9;                                        /* already hooked (ours or foreign): no second hook */
+    CHECK_INT(flat_body_prologue(FLAT_EL_FIELDBOX, b2), 0);
+    CHECK_INT(flat_body_prologue(FLAT_EL_DRAWBOX, 0), 0);
+    flat_jmp_build(j, 0x00c01234);
+    CHECK(j[0] == 0x4e && j[1] == 0xf9 && j[2] == 0x00 && j[3] == 0xc0 && j[4] == 0x12 && j[5] == 0x34);
+    CHECK_INT(flat_jmp_target(j), 0xc01234);
+    CHECK_INT(flat_body_tramp_build(t, field, 8, 0x245de + 8), 14);
+    CHECK(memcmp(t, field, 8) == 0);
+    CHECK_INT(flat_jmp_target(t + 8), 0x245e6);
+    CHECK_INT(flat_body_tramp_build(t, box, 6, 0x2450c + 6), 12);
+    CHECK(memcmp(t, box, 6) == 0);
+    CHECK_INT(flat_jmp_target(t + 6), 0x24512);
+    CHECK_INT(flat_body_tramp_build(t, box, 4, 0x24510), 0);          /* shorter than the JMP it is replaced by */
+    CHECK_INT(flat_body_tramp_build(t, box, 10, 0x24516), 0);         /* longer than the trampoline holds */
+    CHECK_INT(flat_body_tramp_build(t, box, 7, 0x24513), 0);          /* odd: not an instruction boundary */
+}
+
 static void test_dopus_swap(void)
 {
     uintptr_t slot[FLAT_EL_COUNT] = { 0x5000, 0x6000 }, snap[FLAT_EL_COUNT];
@@ -2841,6 +2883,7 @@ void suite_flat_core(void)
