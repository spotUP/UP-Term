+/* INSTALLER-WINDOW-GROW: is the calling task Installer? The process name (Workbench start) or the CLI's command name
+ * (Shell start, a BSTR); memory reads only, no DOS call. */
+static int caller_is_installer(void)
+{
+    struct Task *t = FindTask(0);
+    struct Process *pr = (struct Process *)t;
+    char buf[40];
+    if (t->tc_Node.ln_Name && win_is_installer_name(t->tc_Node.ln_Name))
+        return 1;
+    if (t->tc_Node.ln_Type == NT_PROCESS && pr->pr_CLI) {
+        struct CommandLineInterface *cli = (struct CommandLineInterface *)BADDR(pr->pr_CLI);
+        UBYTE *bs = cli->cli_CommandName ? (UBYTE *)BADDR(cli->cli_CommandName) : 0;
+        int n;
+        if (bs) {
+            n = bs[0] < sizeof buf - 1 ? bs[0] : (int)sizeof buf - 1;
+            memcpy(buf, bs + 1, (size_t)n);
+            buf[n] = 0;
+            return win_is_installer_name(buf);
+        }
+    }
+    return 0;
+}
+
+/* Installer's growth, applied to the request before the bar-strip plan sees it. The screen is the custom one given or the
+ * default public screen (Installer asks for that, 0x42c4); it is looked up, never opened. */
+static void installer_grow(strut_pub *p, req *r)
+{
+    struct Screen *s;
+    win_screen ws;
+    win_box b;
+    int ys, locked = 0;
+    if (r->inner || !caller_is_installer())
+        return;
+    if (r->scr)
+        s = (struct Screen *)r->scr;
+    else if (r->wbench)
+        s = ipd_lock_wb_screen(), locked = 1;
+    else if (r->name && *r->name)
+        s = ipd_lock_pub_screen(r->name), locked = 1;
+    else
+        s = ipd_lock_default_pub_screen(), locked = 1;
+    if (!s)
+        return;
+    ws.width = s->Width; ws.height = s->Height; ws.title = s->BarHeight + 1;
+    ws.bottom = (p->strip > 0 && s == p->scr) ? p->strip : 0;
+    ys = s->RastPort.Font ? s->RastPort.Font->tf_YSize : 8;
+    if (locked)
+        UnlockPubScreen(0, s);
+    memset(&b, 0, sizeof b);
+    b.top = (int)r->top; b.height = (int)r->height;
+    if (win_installer_grow(&b, ys, &ws)) {
+        r->top = b.top; r->height = b.height; r->grew = 1;
+    }
+}
