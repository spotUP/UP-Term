+int win_is_installer_name(const char *name)
+{
+    const char *base = name, *p, *w = "installer";
+    if (!name)
+        return 0;
+    for (p = name; *p; p++)
+        if (*p == '/' || *p == ':')
+            base = p + 1;
+    for (p = base; *w && *p; p++, w++)
+        if ((*p | 0x20) != *w)
+            return 0;
+    return *w == 0 && *p == 0;
+}
+
+int win_installer_grow(win_box *b, int ysize, const win_screen *s)
+{
+    int y = ysize < 8 ? 8 : ysize > 100 ? 100 : ysize;
+    int extra, up, room;
+    if (b->height != 17 * y + 23)
+        return 0;
+    extra = y / 2;
+    up = extra / 2;
+    if (b->top - up < s->title)
+        up = b->top > s->title ? b->top - s->title : 0;
+    room = s->height - s->bottom - (b->top - up + b->height);
+    if (extra > room)
+        extra = room;
+    if (extra <= 0)
+        return 0;
+    if (up > extra)
+        up = extra;
+    b->top -= up;
+    b->height += extra;
+    return 1;
+}
+
