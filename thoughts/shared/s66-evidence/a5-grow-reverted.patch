     return r;
 }
 
+/* INSTALLER-WINDOW-GROW (A5): Installer 43.3's 17 * YSize + 23 window grows YSize / 2 rows, centred, inside the usable area. */
+static void installer_grow(void)
+{
+    const win_screen big = { 800, 600, 14, 0 };
+    const win_screen bar = { 800, 600, 14, 16 };
+    const win_screen low = { 640, 256, 11, 0 };
+    win_box b;
+    CHECK_INT(win_is_installer_name("Installer"), 1);
+    CHECK_INT(win_is_installer_name("C:Installer"), 1);
+    CHECK_INT(win_is_installer_name("SYS:Utilities/installer"), 1);
+    CHECK_INT(win_is_installer_name("Installer2"), 0);
+    CHECK_INT(win_is_installer_name("MyInstaller"), 0);
+    CHECK_INT(win_is_installer_name("Shell Process"), 0);
+    CHECK_INT(win_is_installer_name(0), 0);
+    /* the rig's window: helvetica 11, 496x210 at y 195 -> 5 rows more, top 2 up */
+    b = box(152, 195, 496, 210);
+    CHECK_INT(win_installer_grow(&b, 11, &big), 1);
+    CHECK_INT(b.height, 215);
+    CHECK_INT(b.top, 193);
+    /* topaz 8 on 640x256: 159 -> 163 */
+    b = box(96, 40, 448, 159);
+    CHECK_INT(win_installer_grow(&b, 8, &low), 1);
+    CHECK_INT(b.height, 163);
+    /* another height (Installer 47.x or any other window): untouched */
+    b = box(152, 195, 496, 230);
+    CHECK_INT(win_installer_grow(&b, 11, &big), 0);
+    CHECK_INT(b.height, 230);
+    /* no room above the bar strip: grows only as far as fits, never into it */
+    b = box(152, 370, 496, 210);
+    CHECK_INT(win_installer_grow(&b, 11, &bar), 1);
+    CHECK_INT(b.top + b.height <= 600 - 16, 1);
+    b = box(152, 380, 496, 210);
+    CHECK_INT(win_installer_grow(&b, 11, &bar), 0);
+    /* never above the title bar */
+    b = box(152, 14, 496, 210);
+    CHECK_INT(win_installer_grow(&b, 11, &big), 1);
+    CHECK_INT(b.top, 14);
+    CHECK_INT(b.height, 215);
+}
+
 static void strip_reserve(void)
 {
     const win_screen bar = { 640, 256, 11, 16 };
