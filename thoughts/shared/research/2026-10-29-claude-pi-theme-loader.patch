 }
 
+/* ---- F1: theme files ---- */
+
+/* <data>/themes/<name>.json, -1 when there is no data drawer or the name is not a plain name */
+static int theme_path(const cl_ui *u, const char *name, char *out, long cap)
+{
+    char rel[100];
+    if (!u->data || !u->data[0] || !name[0] || strlen(name) > 60 || strpbrk(name, "/:"))
+        return -1;
+    cl_copy(rel, "themes/", sizeof(rel));
+    cl_cat(rel, name, sizeof(rel));
+    cl_cat(rel, ".json", sizeof(rel));
+    return path_join(u->data, rel, out, cap);
+}
+
+int ui_theme(cl_ui *u, const char *name, int warn_missing)
+{
+    cl_tui *t = u->tui;
+    char path[300], err[300], msg[400], term[48], ct[24], pt[8], *txt = 0;
+    long n = 0;
+    cl_pitheme *p;
+    int i;
+    if (!t || !name || !name[0])
+        return 0;
+    /* a file beats a built-in of the same name (amiga-pi's order: app.c load_theme_named) */
+    if (u->sys && theme_path(u, name, path, sizeof(path)) == 0 && u->sys->kind(u->sys->u, path) == 1) {
+        int bad;
+        if (u->sys->read(u->sys->u, path, 256L * 1024, &txt, &n) != 0) {
+            cl_copy(msg, "[WARN] Theme file unreadable: ", sizeof(msg));
+            cl_cat(msg, name, sizeof(msg));
+            ui_line(u, msg);
+            return 0;
+        }
+        p = (cl_pitheme *)malloc(sizeof(*p));
+        if (!p) {
+            free(txt);
+            return 0;
+        }
+        bad = pitheme_load(p, txt, n, 0, err, sizeof(err));
+        free(txt);
+        if (bad) {
+            cl_copy(msg, "[WARN] Theme ", sizeof(msg));
+            cl_cat(msg, name, sizeof(msg));
+            cl_cat(msg, ": ", sizeof(msg));
+            cl_cat(msg, err, sizeof(msg));
+            ui_line(u, msg);
+            free(p);
+            return 0;
+        }
+        term[0] = ct[0] = pt[0] = 0;
+        if (u->sys->getenv) {
+            u->sys->getenv(u->sys->u, "TERM", term, sizeof(term));
+            u->sys->getenv(u->sys->u, "COLORTERM", ct, sizeof(ct));
+            u->sys->getenv(u->sys->u, "PI_TRUE_COLOR", pt, sizeof(pt));
+        }
+        p->depth = pitheme_depth(term, ct, pt);
+        theme_from_pi(&t->fth, p, name);
+        free(p);
+        t->th = &t->fth.th;
+        t->full = 1;
+        return 1;
+    }
+    for (i = 0; i < THEME_COUNT; i++)
+        if (!strcmp(cl_themes[i].name, name)) {
+            t->th = &cl_themes[i];
+            t->full = 1;
+            return 1;
+        }
+    if (warn_missing) {
+        cl_copy(msg, "[WARN] Theme not found: ", sizeof(msg));
+        cl_cat(msg, name, sizeof(msg));
+        ui_line(u, msg);
+    }
+    return 0;
+}
+
+typedef struct tn_acc {
+    char (*names)[64];
+    int n, max;
+} tn_acc;
+
+static int tn_add(void *c, const cl_dirent *e)
+{
+    tn_acc *a = (tn_acc *)c;
+    size_t l = strlen(e->name);
+    int i;
+    if (e->dir || l < 6 || l - 5 >= 64 || strcmp(e->name + l - 5, ".json"))
+        return 0;
+    for (i = 0; i < THEME_COUNT; i++)
+        if (strlen(cl_themes[i].name) == l - 5 && !strncmp(cl_themes[i].name, e->name, l - 5))
+            return 0;           /* listed as the built-in already (the file still wins when it is chosen) */
+    if (a->n >= a->max)
+        return 1;
+    memcpy(a->names[a->n], e->name, l - 5);
+    a->names[a->n][l - 5] = 0;
+    a->n++;
+    return 0;
+}
+
+int ui_theme_files(cl_ui *u, char (*names)[64], int max)
+{
+    tn_acc a;
+    char dir[300];
+    a.names = names;
+    a.n = 0;
+    a.max = max;
+    if (u->sys && u->sys->list && u->data && u->data[0] && path_join(u->data, "themes", dir, sizeof(dir)) == 0)
+        u->sys->list(u->sys->u, dir, tn_add, &a);
+    return a.n;
+}
+
 /* ---- A4 (WP1) ---- */
 
 void ui_attach(cl_ui *u, cl_sys *sys, const char *root, struct cl_conv *conv)
@@ -330,7 +441,7 @@ void ui_attach(cl_ui *u, cl_sys *sys, const char *root, struct cl_conv *conv)
     t->ru = u;
     v = u->setting ? u->setting(u->su, "theme") : 0;
     if (v)
-        t->th = theme_get(v);
+        ui_theme(u, v, 1);      /* a theme file, else a built-in, else the default and one warning line */
     v = u->setting ? u->setting(u->su, "editorMode") : 0;
     if (v && !strcmp(v, "vim"))
         ed_set_vim(&t->ed, 1);
