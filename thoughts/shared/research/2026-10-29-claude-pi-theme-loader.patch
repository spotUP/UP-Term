diff --git a/claude/theme.c b/claude/theme.c
index 950c7bfe..d2f25964 100644
--- a/claude/theme.c
+++ b/claude/theme.c
@@ -479,6 +479,41 @@ int pitheme_sgr(const cl_pitheme *t, int role, char *out)
     return n + pitheme_color(t, t->color[role], is_bg(role), out + n);
 }
 
+/* cl_theme field <- pi role. The one table of what a theme file's roles colour in C:Claude (docs in
+ * thoughts/shared/research/2026-10-28-omarchy-ai-f1-loader.md) */
+void theme_from_pi(cl_ftheme *f, const cl_pitheme *p, const char *name)
+{
+    static const int role[FTHEME_SGR] = {
+        PR_BORDER,          /* box: the input box's frame */
+        PR_ACCENT,          /* spin */
+        PR_ACCENT,          /* sel */
+        PR_ACCENT,          /* accent */
+        PR_SUCCESS,         /* accept */
+        PR_BORDER_ACCENT,   /* plan */
+        PR_BASH_MODE,       /* bash */
+        PR_MD_HEADING,      /* memory */
+        PR_SUCCESS,         /* ok */
+        PR_ERROR,           /* err */
+        PR_TOOL_DIFF_ADDED, /* add */
+        PR_TOOL_DIFF_REMOVED /* del */
+    };
+    const char **slot[FTHEME_SGR];
+    int i;
+    memset(f, 0, sizeof(*f));
+    strncpy(f->name, name, sizeof(f->name) - 1);
+    slot[0] = &f->th.box;   slot[1] = &f->th.spin;   slot[2] = &f->th.sel;  slot[3] = &f->th.accent;
+    slot[4] = &f->th.accept; slot[5] = &f->th.plan;  slot[6] = &f->th.bash; slot[7] = &f->th.memory;
+    slot[8] = &f->th.ok;    slot[9] = &f->th.err;    slot[10] = &f->th.add; slot[11] = &f->th.del;
+    for (i = 0; i < FTHEME_SGR; i++) {
+        pitheme_sgr(p, role[i], f->sgr[i]);
+        *slot[i] = f->sgr[i];
+    }
+    f->th.name = f->name;
+    f->th.label = f->name;
+    f->th.dim = "\033[2m";
+    f->th.hl = "ansi";
+}
+
 static void hl_role(const cl_pitheme *t, struct hl_theme *h, int cls, int role, unsigned attr)
 {
     long c = t->color[role];
diff --git a/claude/theme.h b/claude/theme.h
index ef3b53c3..ae52ece7 100644
--- a/claude/theme.h
+++ b/claude/theme.h
@@ -98,6 +98,17 @@ int pitheme_depth(const char *term, const char *colorterm, const char *pi_true_c
 /* a colour (HL_DEFAULT, 0..255, HL_RGB) as the SGR that sets it: the one place a colour of pi's is brought
  * down to this screen's palette (t->depth). out holds 48 bytes. */
 int pitheme_color(const cl_pitheme *t, long color, int bg, char *out);
+/* F1: a pi theme as C:Claude's own screen draws it. C:Claude's roles are the cl_theme SGR strings; theme_from_pi
+ * fills those from the pi roles (the table is in theme.c), so ONE theme file recolours C:Claude and amiga-pi. The
+ * strings live in the struct: it must outlive the pointer handed to the screen. */
+#define FTHEME_SGR 12
+typedef struct cl_ftheme {
+    cl_theme th;
+    char name[64];
+    char sgr[FTHEME_SGR][48];
+} cl_ftheme;
+void theme_from_pi(cl_ftheme *f, const cl_pitheme *p, const char *name);
+
 /* the md / code classes of an hl_theme coloured by the roles (view/hl_style.h) */
 struct hl_theme;
 void pitheme_hl(const cl_pitheme *t, struct hl_theme *h);
