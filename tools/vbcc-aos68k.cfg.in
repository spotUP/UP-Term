-cc=vbccm68k -quiet %s -o= %s %s -O=%ld -I@VBCC_PREFIX@/targets/m68k-amigaos/include -Ivendor/ndk-3.2r4-Include_H
-ccv=vbccm68k %s -o= %s %s -O=%ld -I@VBCC_PREFIX@/targets/m68k-amigaos/include -Ivendor/ndk-3.2r4-Include_H
-as=vasmm68k_mot -quiet -Fhunk -nowarn=62 %s -o %s
-asv=vasmm68k_mot -Fhunk -nowarn=62 %s -o %s
-rm=rm -f %s
-rmv=rm -f %s
-ld=vlink -bamigahunk -x -Bstatic -Cvbcc -nostdlib -mrel @VBCC_PREFIX@/targets/m68k-amigaos/lib/startup.o %s %s -L@VBCC_PREFIX@/targets/m68k-amigaos/lib -lvc -o %s
-l2=vlink -bamigahunk -x -Bstatic -Cvbcc -nostdlib -mrel %s %s -L@VBCC_PREFIX@/targets/m68k-amigaos/lib -o %s
-ldv=vlink -bamigahunk -t -x -Bstatic -Cvbcc -nostdlib -mrel @VBCC_PREFIX@/targets/m68k-amigaos/lib/startup.o %s %s -L@VBCC_PREFIX@/targets/m68k-amigaos/lib -lvc -o %s
-l2v=vlink -bamigahunk -t -x -Bstatic -Cvbcc -nostdlib -mrel %s %s -L@VBCC_PREFIX@/targets/m68k-amigaos/lib -o %s
-ldnodb=-s -Rshort
-ul=-l%s
-cf=-F%s
-ml=500
-hunkdebug
-amiga-softfloat
