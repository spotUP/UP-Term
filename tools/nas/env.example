# Site settings for the claude-amiga container. Copy this file to .env beside compose.yaml
# (cp env.example .env) and edit .env. The repo, make nas-deploy and image updates never
# send or overwrite .env, so these values survive every update.

# The NAS's LAN address (like 192.168.1.20), space-separated with any more to listen on.
# Add 127.0.0.1 for Tailscale (Synology's userspace networking hands connections over there).
NAS_IP=192.168.1.20 127.0.0.1

# Networks allowed to connect: your LAN (like 192.168.1.0/24), plus the VPN Server range for use
# from outside (README "From outside the LAN"), space-separated.
ALLOW=192.168.1.0/24 127.0.0.0/8

# Optional: the folder that holds login, settings, password and history (default below).
# CLAUDE_HOME=/volume1/docker/claude-amiga/home
