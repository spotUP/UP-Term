#!/bin/sh
# amiga-target: which Amiga the amiga MCP server (wasabi_mcp.py) controls: its address,
# optionally its port, and the wasabid KEY. They go into ~/.config/wasabi/config (0600, on
# the volume; never in an image, a compose file or a log), the file wasabi itself reads.
# Other lines of that file (protect, silence, ...) are left alone.
#   amiga-target [set]   asks for the address, the port (Return = 1234) and the key (not echoed)
#   amiga-target show    prints the address and port, never the key
#   amiga-target clear   removes the three lines (and the file when nothing else is left)
# WASABI_DIR moves the directory (tests).
[ "$(id -u)" != 0 ] || exec as-claude "$0" "$@"   # never write into the claude user's home as root
D=${WASABI_DIR:-/home/claude/.config/wasabi}
C=$D/config
get() { sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$C" 2>/dev/null | head -n 1; }
drop() { # remove the host, port and key lines
    [ -f "$C" ] || return 0
    grep -v -E '^[[:space:]]*(host|port|key)[[:space:]]*=' "$C" > "$C.new"
    if [ -s "$C.new" ]; then mv "$C.new" "$C"; else rm -f "$C.new" "$C"; fi
}
case "${1:-set}" in
show)
    [ -n "$(get host)" ] || { echo "no Amiga set: run amiga-target"; exit 1; }
    printf 'host %s\nport %s\n' "$(get host)" "$(get port || true)" | sed 's/^port $/port 1234/'
    [ -n "$(get key)" ] && echo "key set" || echo "key missing"
    ;;
clear)
    drop; echo "cleared"
    ;;
set)
    printf 'Amiga IP address: '; read h
    printf 'wasabid port [1234]: '; read p
    stty -echo 2>/dev/null; printf 'wasabid KEY: '; read t; stty echo 2>/dev/null; echo
    [ -n "$h" ] || { echo "no address"; exit 1; }
    [ -n "$t" ] || { echo "no key"; exit 1; }
    case "${p:-1234}" in *[!0-9]*) echo "bad port"; exit 1 ;; esac
    case "$h$t" in *'#'*|*=*) echo "bad character (# or =)"; exit 1 ;; esac   # wasabi's config parser cuts at #
    umask 077; mkdir -p "$D"; chmod 700 "$D"; drop
    { [ ! -f "$C" ] || cat "$C"; printf 'host = %s\n' "$h"; [ -z "$p" ] || [ "$p" = 1234 ] || printf 'port = %s\n' "$p"; printf 'key = %s\n' "$t"; } > "$C.new"
    mv "$C.new" "$C"; chmod 600 "$C"
    echo "saved; start claude from the Amiga and approve the amiga MCP server"
    ;;
*) echo "usage: amiga-target [set|show|clear]"; exit 2 ;;
esac
